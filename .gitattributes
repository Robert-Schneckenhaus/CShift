# Shell scripts must keep LF line endings, otherwise bash fails on Windows checkouts.
*.sh text eol=lf
tests/test.expected text eol=lf
selfhost/passing.txt text eol=lf
# Text that cshc embeds (assembly of the m68k backend, the usage text): the same bytes on every checkout.
selfhost/src/**/*.s text eol=lf
selfhost/src/**/*.txt text eol=lf
tools/debug/*.py text eol=lf

# Files that tests embed byte for byte (BOM, CRLF and LF mixed on purpose).
tests/cases/embed/** -text
tests/projects/embed/data/** -text

# GitHub language statistics: CShift (C#-like) counted as C#, also .csh (the extension before 0.32), which is not C
# shell
*.cshift linguist-language=C#
*.csh linguist-language=C#
