// A 'thread' function parameter must be something the thread can get a copy of (values, strings, arrays and
// containers of them) or a SharedPtr<T> of a thread-safe type - not a raw pointer or Action/Func: they would alias data
// the other thread does not expect. A container of delegates is rejected for the same reason.
// expect-error: not 'System.List<Func<int32>>' (parameter 'jobs')

using System;

thread int Bad(List<Func<int>> jobs)
{
    return jobs.Count();
}

void Main()
{
    (start Bad(List<Func<int>>.Create())).Join();
}
