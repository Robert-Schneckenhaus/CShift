// A struct can only be iterated with foreach if it has GetEnumerator(), Count() and Get(int), or MoveNext() and Current().
// expect-error: needs 'GetEnumerator()', the methods 'int Count()' and 'T Get(int index)', or 'bool MoveNext()' and 'T Current()'
struct Plain
{
    int X;
}

int Main()
{
    var p = new Plain();
    foreach (var x in p)
        return x;
    return 0;
}
