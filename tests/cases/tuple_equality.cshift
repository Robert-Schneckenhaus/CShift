// == and != compare two tuples value by value, each pair with '==' (numbers of different types, strings by their
// text, nested tuples). A tuple written out on one side compares its values as they are: literals adapt, null
// compares with a string. Only == and != are defined for tuples.
// expect-exit: 0
// expect-stdout: true false false true
// expect-stdout: true true true true
// expect-stdout: true false false
// expect-stdout: true

using System;

(string, int) Get()
{
    return ("a", 1);
}

int Main()
{
    var t = (1, "a");
    (int64, string) wide = (1, "a");
    (int, string) none = (2, null);
    Console.WriteLine($"{t == (1, "a")} {t != (1, "a")} {t == (1, "b")} {(1, "a") == t}");
    Console.WriteLine($"{wide == (1, "a")} {none == (2, null)} {Get() == ("a", 1)} {Get() == Get()}");
    var a = (1, (2, "x"));
    var b = (1, (2, "x"));
    Console.WriteLine($"{a == b} {a != b} {a == (1, (2, "y"))}");
    uint8 small = 200;
    Console.WriteLine((small, 1) == (200, 1));
    return 0;
}
