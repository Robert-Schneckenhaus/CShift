// Loops and arithmetic that the 68000 backend makes cheaper must never change a result:
// - a loop from a start that may be negative, where the index only grows: the bounds check goes in the loop
//   (GuardLowerBounds); a start past the end runs no round;
// - '(x << 4) + x + 87 & 0xffff' computed in 16 bits, '& 0xff' in 8 (NarrowMasks), with 8- and 16-bit operations;
// - a counted loop from a known start ('for (var n = 0; n < 8; ...)': its count is a constant);
// - 'p - x' on pointers (a subtraction, not a negation and an add);
// - a branch to the end of a round replaced by a copy of it (CopyLoopEnds);
// - a counted loop whose bound has a known range ('(x & 15) + 3', 'x & 0xffff'): its test before the loop is known,
//   and a count below 65536 is a plain dbra (up to 65535 rounds); a bound that may be larger keeps the long count;
// - a function whose only divisions are by 1 or powers of two, and whose checked products are by powers of two, keeps
//   values in d2 and d3 too (Regalloc.cshift: NeedsD2D3);
// - the bits of a byte tested by bit 7 and shifted: 'add.b d7,d7' / bcc (FuseBitShifts), also with 64-bit
//   arithmetic (which reads the X flag that add.b sets) in the round.
// expect-stdout: narrow loops ok
using System;

int failures = 0;

void Check(string what, int got, int expected)
{
    if (got != expected)
    {
        Console.WriteLine(what + ": " + got.ToString() + " instead of " + expected.ToString());
        failures += 1;
    }
}

void Crypt(uint8[] data, uint16 key, int offset)
{
    int last = data.Length - 1;
    int d0 = key;
    int index = offset;
    while (index < last)
    {
        data[index] = (uint8)(data[index] ^ (d0 >> 8));
        data[index + 1] = (uint8)(data[index + 1] ^ d0);
        d0 = ((d0 << 4) + d0 + 87) & 0xffff;
        index += 2;
    }
    if (index == last)
        data[index] = (uint8)(data[index] ^ (d0 >> 8));
}

int Bytes(int x)
{
    int a = ((x << 3) - x + 200) & 0xff;
    int b = ((x ^ 0x5a5a) | (x << 2)) & 0xffff;
    int c = (x - 70000) & 0xffff;
    return a * 100000 + b + c * 3;
}

int Bits(int header)
{
    int ones = 0;
    int pattern = 0;
    for (var n = 0; n < 8; n += 1)
    {
        if ((header & 0x80) != 0)
            ones += 1;
        else
            pattern += n;
        header <<= 1;
    }
    return ones * 100 + pattern;
}

int Rounds(int x)
{
    int n = 0;
    int length = (x & 0x0f) + 3;
    for (var k = 0; k < length; k += 1)
        n += 1;
    int words = 0;
    int limit = x & 0xffff;
    for (var k = 0; k < limit; k += 1)
        words += 1;
    int longer = 0;
    int big = (x & 0x1ffff);
    for (var k = 0; k < big; k += 1)
        longer += 1;
    return n * 1000000 + words * 2 + longer;
}

unsafe int Spread(uint8[] data, int a, int b)
{
    uint8* p = &data[0];
    uint8* q = p + data.Length;
    int s1 = 0;
    int s2 = 0;
    int s3 = 0;
    int s4 = 0;
    int s5 = 0;
    int s6 = 0;
    int k = a * 8;
    for (var i = 0; i < data.Length; i += 1)
    {
        s1 += data[i] / 4;
        s2 += (data[i] - 100) / 2;
        s3 += (uint32)data[i] % 8u > 3 ? 1 : 0;
        s4 += (data[i] - b) % 4;
        s5 += i * k;
        s6 += (int)(q - p) / 1;
    }
    return s1 + s2 * 3 + s3 * 7 + s4 * 11 + s5 + s6;
}

int64 Wide(int header, int64 total)
{
    for (var n = 0; n < 8; n += 1)
    {
        if ((header & 0x80) != 0)
            total += 0x100000001;
        else
            total -= 3;
        header <<= 1;
    }
    return total;
}

unsafe int Back(uint8[] data, int distance)
{
    uint8* end = &data[0] + data.Length;
    uint8* from = end - distance;
    return *from;
}

int Main()
{
    var d = new uint8[101];
    for (var i = 0; i < d.Length; i += 1)
        d[i] = (uint8)(i * 7);
    Crypt(d, 0x1234, 0);
    Crypt(d, 0x4321, 3);
    Crypt(d, 0x0101, 200);
    int sum = 0;
    for (var i = 0; i < d.Length; i += 1)
        sum = (sum * 31 + d[i]) & 0xfffff;
    Check("crypt", sum, 464170);
    Crypt(d, 0x4321, 3);
    Crypt(d, 0x1234, 0);
    Check("crypt back", d[50], 94);

    Check("bytes 1", Bytes(1), 20906354);
    Check("bytes -5", Bytes(-5), 16748718);
    Check("bytes 40000", Bytes(40000), 13769866);
    Check("bits 0xa5", Bits(0xa5), 414);
    Check("bits 0", Bits(0), 28);
    Check("bits 0xff", Bits(0xff), 800);
    Check("back", Back(d, 3), d[98]);
    var spread = new uint8[37];
    for (var i = 0; i < spread.Length; i += 1)
        spread[i] = (uint8)(i * 41);
    Check("spread", Spread(spread, 3, 77), 20094);
    Check("rounds 0", Rounds(0), 3000000);
    Check("rounds 1", Rounds(1), 4000003);
    Check("rounds ffff", Rounds(0xffff), 18000000 + 65535 * 3);
    Check("rounds 1ffff", Rounds(0x1ffff), 18000000 + 65535 * 2 + 0x1ffff);
    Check("rounds 10000", Rounds(0x10000), 3000000 + 0x10000);
    int64 w = Wide(0xb6, 0xfffffff0);
    Check("wide high", (int)(w >> 32), 5);
    Check("wide low", (int)(w & 0xffffffff), -20);

    if (failures == 0)
        Console.WriteLine("narrow loops ok");
    return failures;
}
