// Operations on elements in memory with the 68000 backend (Peephole.cshift: 'eor.b d2,(8,a2,d4.l)' instead of a load,
// the operation and a store; Prepare.cshift: 'a[i + 1]' as '(9,a2,d4.l)'; Facts.cshift: a bounds check that passed
// tells i >= 0, 'i < n - 1' tells 'i + 1 < n') must never change a result: xor, and, or, add and sub on bytes, words
// and ints, an index plus a constant (also negative, also where the value stored is the index), the JH crypt with odd
// lengths and offsets, and a value in a saved register across a call.
// expect-stdout: memory ops ok
using System;

int failures = 0;

void Check(string what, int got, int expected)
{
    if (got != expected)
    {
        Console.WriteLine(what + ": " + got.ToString() + " instead of " + expected.ToString());
        failures += 1;
    }
}

// as Ambermoon's JH: two bytes per key, the last byte alone
void Crypt(uint8[] data, uint16 key, int offset)
{
    int last = data.Length - 1;
    int d0 = key;
    int index = offset;
    while (index < last)
    {
        data[index] = (uint8)(data[index] ^ (d0 >> 8));
        data[index + 1] = (uint8)(data[index + 1] ^ d0);
        d0 = ((d0 << 4) + d0 + 87) & 0xffff;
        index += 2;
    }
    if (index == last)
        data[index] = (uint8)(data[index] ^ (d0 >> 8));
}

int Sum(uint8[] a)
{
    int s = 0;
    foreach (var b in a)
        s += b;
    return s;
}

void Mix(uint8[] b, uint16[] w, int[] n, int x)
{
    for (var i = 1; i + 1 < b.Length; i += 1)
    {
        b[i] ^= (uint8)x;
        b[i + 1] = (uint8)(b[i + 1] & 0xf0);
        b[i - 1] = (uint8)(b[i - 1] | 0x01);
        w[i] = (uint16)(w[i] + x);
        w[i - 1] = (uint16)(w[i - 1] - 3);
        n[i] = n[i] ^ x;
        n[i + 1] += x;
    }
}

// the value stored is also the index (it must not stay in d0 for the address)
void PutPair(uint8[] o, int n)
{
    o[n + 1] = (uint8)n;
    o[n + 2] = (uint8)(n + 1);
}

int Twice(int x)
{
    return x * 2;
}

// a value that lives in a saved register across a call
int AcrossCall(int[] a, int x)
{
    int y = x | a[0];
    int z = Twice(y);
    return y * 1000 + z + a[1];
}

int Main()
{
    // en- and decrypting is the same operation: twice gives the data back, for even and odd lengths and offsets
    for (var length = 0; length < 9; length += 1)
    {
        for (var offset = 0; offset < 3; offset += 1)
        {
            var data = new uint8[length];
            for (var i = 0; i < length; i += 1)
                data[i] = (uint8)(i * 37 + 5);
            int before = Sum(data);
            Crypt(data, 0x1234, offset);
            Crypt(data, 0x1234, offset);
            Check("crypt twice " + length.ToString() + " " + offset.ToString(), Sum(data), before);
        }
    }
    var known = new uint8[] { 0, 0, 0, 0, 0 };
    Crypt(known, 0x1234, 0);
    // keys 0x1234, then ((0x1234 << 4) + 0x1234 + 87) & 0xffff = 0x35cb, then 0x92d2
    Check("crypt bytes", known[0] * 1000000 + known[1] * 10000 + known[2] * 100 + known[4], 0x12 * 1000000 + 0x34 * 10000 + 0x35 * 100 + 0x92);
    Check("crypt byte 3", known[3], 0xcb);

    var b = new uint8[] { 10, 20, 30, 40, 50 };
    var w = new uint16[] { 1, 2, 3, 4, 5 };
    var n = new int[] { 100, 200, 300, 400, 500 };
    Mix(b, w, n, 7);
    Check("bytes", b[0] * 1000000 + b[1] * 10000 + b[2] * 100 + b[3], 11 * 1000000 + 19 * 10000 + 23 * 100 + 39);
    Check("byte 4", b[4], 48);
    Check("words", w[0] * 1000 + w[1] * 100 + w[2] * 10 + w[3], 65534 * 1000 + 6 * 100 + 7 * 10 + 11);
    Check("word 4", w[4], 5);
    Check("ints", n[0] * 1000 + n[1] + n[2] + n[3] + n[4], 100 * 1000 + 207 + 308 + 400 + 507);

    var pairs = new uint8[6];
    PutPair(pairs, 1);
    PutPair(pairs, 3);
    Check("pairs", pairs[2] * 100 + pairs[3] * 10 + pairs[4] * 1000 + pairs[5], 1 * 100 + 2 * 10 + 3 * 1000 + 4);
    Check("across call", AcrossCall(new int[] { 8, 5 }, 3), 11 * 1000 + 22 + 5);

    if (failures == 0)
        Console.WriteLine("memory ops ok");
    return failures;
}
