// System.Ui in the browser (--backend wasm): run by tests/ui-web-check.mjs with web/cshift.js and a canvas that only
// pretends. The program tells where its widgets are; the test clicks the button (also with the right and the middle
// button), presses +, holds the right arrow key and lets it go, types into the text box and pastes,
// and the program ends when it got all of it. Between those inputs it waits (the program is suspended until input).
// At the end it draws frames without input (Ui.RequestFrame), each about 30 ms after the one before.

using System;
using System.Ui;

int Main()
{
    var opened = Window.Open("web", 200, 120);
    if (opened is not Window window)
    {
        Console.WriteLine("error: " + opened.Message);
        return 1;
    }
    var ui = Ui.Create();
    string text = "";
    int clicks = 0;
    int frames = 0;
    bool right = false;
    while (window.Update())
    {
        frames += 1;
        ui.Begin(window);
        if (ui.Button("Click"))
        {
            clicks += 1;
            Console.WriteLine("clicked");
        }
        var button = ui.LastRect();
        if (ui.RightClicked())
            Console.WriteLine("right clicked");
        if (ui.Input().MiddleReleased)
            Console.WriteLine("middle");
        if (ui.Input().Pressed(Key.Plus))
            Console.WriteLine("plus");
        if (ui.Input().Held.Contains(Key.Right) != right)
        {
            right = !right;
            Console.WriteLine(right ? "held right" : "released right");
        }
        if (ui.Input().Pressed(Key.Q, KeyModifiers.Ctrl) && ui.Input().Ctrl)
            Console.WriteLine("ctrl q");
        if (ui.TextBox("text", ref text))
            Console.WriteLine("text " + text);
        var box = ui.LastRect();
        if (frames == 1)
            Console.WriteLine($"layout {button.X + button.Width / 2} {button.Y + button.Height / 2} {box.X + 10} {box.Y + box.Height / 2} scale {window.Scale()}");
        window.Show(ui);
        if (clicks == 1 && text == "hi there")
            break;
        if (frames > 200)
        {
            Console.WriteLine("error: too many frames (the program does not wait for input)");
            return 1;
        }
    }
    // frames without input: the program is resumed after the time
    int timed = 0;
    var watch = Stopwatch.StartNew();
    double first = 0.0;
    while (timed < 6 && window.Update())
    {
        if (timed == 1)
            first = watch.Elapsed().TotalMilliseconds(); // the wait after the last frame above: the text cursor's
        ui.Begin(window);
        ui.Label($"Timed {timed}");
        ui.RequestFrame(30);
        window.Show(ui);
        timed += 1;
    }
    int waited = (int)(watch.Elapsed().TotalMilliseconds() - first);
    Console.WriteLine($"timed frames {timed}, {waited} ms");
    window.Dispose();
    Console.WriteLine($"done after {frames} frames");
    return 0;
}
