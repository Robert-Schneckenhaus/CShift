{
	"name": "cshift",
	"displayName": "CShift",
	"description": "CShift (.csh): syntax highlighting, snippets, the errors of the program, hover information and go to definition (with cshiftc).",
	"version": "0.13.0",
	"publisher": "Robert-Schneckenhaus",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Robert-Schneckenhaus/CShift"
	},
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Programming Languages",
		"Snippets",
		"Linters"
	],
	"keywords": [
		"cshift",
		"csh",
		"systems language"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:cshift",
		"workspaceContains:**/cshift.json"
	],
	"contributes": {
		"languages": [
			{
				"id": "cshift",
				"aliases": [
					"CShift",
					"cshift"
				],
				"extensions": [
					".csh"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "cshift",
				"scopeName": "source.cshift",
				"path": "./syntaxes/cshift.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "cshift",
				"path": "./snippets/cshift.json"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": "cshift.json",
				"url": "./schemas/cshift.schema.json"
			}
		],
		"problemMatchers": [
			{
				"name": "cshiftc",
				"owner": "cshift",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			}
		],
		"commands": [
			{
				"command": "cshift.checkProgram",
				"title": "CShift: Check the program of the current file"
			}
		],
		"configuration": {
			"title": "CShift",
			"properties": {
				"cshift.compilerPath": {
					"type": "string",
					"default": "",
					"description": "The cshiftc used for errors, hover and go to definition (0.11 or later). Empty: 'cshiftc' from PATH."
				},
				"cshift.checkWhileTyping": {
					"type": "boolean",
					"default": true,
					"description": "Check the program while typing (after a short pause), not only when a file is opened or saved."
				},
				"cshift.checkDelay": {
					"type": "number",
					"default": 700,
					"minimum": 100,
					"description": "The pause in milliseconds after typing before the program is checked."
				}
			}
		}
	}
}
