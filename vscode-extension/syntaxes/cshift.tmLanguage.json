{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "CShift",
	"scopeName": "source.cshift",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#directives" },
		{ "include": "#type-declarations" },
		{ "include": "#numbers" },
		{ "include": "#function-declarations" },
		{ "include": "#keywords" },
		{ "include": "#builtins" },
		{ "include": "#function-calls" },
		{ "include": "#type-usages" },
		{ "include": "#members" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.block.cshift",
					"begin": "/\\*",
					"end": "\\*/",
					"beginCaptures": { "0": { "name": "punctuation.definition.comment.cshift" } },
					"endCaptures": { "0": { "name": "punctuation.definition.comment.cshift" } }
				},
				{
					"name": "comment.line.double-slash.cshift",
					"match": "//.*$",
					"captures": { "0": { "name": "punctuation.definition.comment.cshift" } }
				}
			]
		},

		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.cshift",
					"begin": "\"",
					"end": "\"|$",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cshift" } },
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.cshift" } },
					"patterns": [{ "include": "#escapes" }]
				},
				{
					"name": "string.quoted.single.cshift",
					"begin": "'",
					"end": "'|$",
					"beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cshift" } },
					"endCaptures": { "0": { "name": "punctuation.definition.string.end.cshift" } },
					"patterns": [{ "include": "#escapes" }]
				}
			]
		},

		"escapes": {
			"patterns": [
				{
					"name": "constant.character.escape.cshift",
					"match": "\\\\(?:[ntr0abfv\\\\'\"]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
				},
				{
					"name": "invalid.illegal.escape.cshift",
					"match": "\\\\."
				}
			]
		},

		"directives": {
			"patterns": [
				{
					"comment": "link \"sqlite3\"",
					"match": "^\\s*(link)\\s+(\"[^\"]*\")",
					"captures": {
						"1": { "name": "keyword.other.directive.cshift" },
						"2": { "name": "string.quoted.double.cshift" }
					}
				},
				{
					"comment": "namespace A.B;",
					"match": "\\b(namespace)\\s+([A-Za-z_][\\w.]*)",
					"captures": {
						"1": { "name": "keyword.other.namespace.cshift" },
						"2": { "name": "entity.name.namespace.cshift" }
					}
				},
				{
					"comment": "using Name from \"header.h\";  (import of a C header)",
					"match": "\\b(using)\\s+([A-Za-z_]\\w*)\\s+(from)\\b",
					"captures": {
						"1": { "name": "keyword.other.using.cshift" },
						"2": { "name": "entity.name.namespace.cshift" },
						"3": { "name": "keyword.other.from.cshift" }
					}
				},
				{
					"comment": "using A.B;  (but not the using statement: using x = ...)",
					"match": "\\b(using)\\s+([A-Za-z_][\\w.]*)\\s*(?=;)",
					"captures": {
						"1": { "name": "keyword.other.using.cshift" },
						"2": { "name": "entity.name.namespace.cshift" }
					}
				}
			]
		},

		"type-declarations": {
			"patterns": [
				{
					"match": "\\b(struct|interface|enum)\\s+([A-Za-z_]\\w*)",
					"captures": {
						"1": { "name": "storage.type.cshift" },
						"2": { "name": "entity.name.type.cshift" }
					}
				}
			]
		},

		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.cshift",
					"match": "\\b0[xX][0-9A-Fa-f_]+(?:[uU][lL]?|[lL][uU]?)?\\b"
				},
				{
					"name": "constant.numeric.binary.cshift",
					"match": "\\b0[bB][01_]+(?:[uU][lL]?|[lL][uU]?)?\\b"
				},
				{
					"name": "constant.numeric.float.cshift",
					"match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?[fFdD]?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+[fFdD]?\\b|\\b\\d[\\d_]*[fFdD]\\b"
				},
				{
					"name": "constant.numeric.integer.cshift",
					"match": "\\b\\d[\\d_]*(?:[uU][lL]?|[lL][uU]?)?\\b"
				}
			]
		},

		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.cshift",
					"match": "\\b(if|else|while|do|for|foreach|in|switch|case|default|break|continue|return|try)\\b"
				},
				{
					"name": "keyword.other.using.cshift",
					"match": "\\busing\\b"
				},
				{
					"name": "storage.modifier.cshift",
					"match": "\\b(extern|static|unsafe|unchecked|const|ref|thread)\\b"
				},
				{
					"name": "storage.type.cshift",
					"match": "\\b(struct|interface|enum|namespace)\\b"
				},
				{
					"comment": "new Vec2(), x is Error<int> r, where T : ...  -- the type after the keyword is a type name",
					"match": "\\b(new|is|where)\\b(?:\\s+(?!(?:null|true|false)\\b)([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*))?",
					"captures": {
						"1": { "name": "keyword.operator.expression.cshift" },
						"2": { "patterns": [{ "include": "#type-ref" }] }
					}
				},
				{
					"name": "keyword.operator.expression.cshift",
					"match": "\\bsizeof\\b"
				},
				{
					"name": "constant.language.cshift",
					"match": "\\b(true|false|null)\\b"
				},
				{
					"name": "variable.language.this.cshift",
					"match": "\\bthis\\b"
				}
			]
		},

		"type-ref": {
			"comment": "A type inside a declaration: primitives, library types or a user type, including generic arguments.",
			"patterns": [
				{ "include": "#primitive-types" },
				{ "include": "#builtin-types" },
				{
					"name": "entity.name.type.cshift",
					"match": "\\b[A-Za-z_]\\w*\\b"
				},
				{ "include": "#operators" }
			]
		},

		"primitive-types": {
			"name": "storage.type.primitive.cshift",
			"match": "\\b(int|uint|float|double|int8|int16|int32|int64|uint8|uint16|uint32|uint64|nint|nuint|float32|float64|bool|char|string|void|var)\\b"
		},

		"builtin-types": {
			"patterns": [
				{
					"name": "support.type.cshift",
					"match": "\\b(Error|Optional|Action|Func|SharedPtr|Thread|IDisposable|IComparable|IEquatable|IHashable|KeyValuePair)\\b"
				},
				{
					"name": "support.class.cshift",
					"match": "\\b(Console|Memory|Environment|Array|Math|String|File|Encoding|EncodingKind|List|Dictionary|Char|StringBuilder|HashSet|Process)\\b"
				}
			]
		},

		"builtins": {
			"patterns": [
				{ "include": "#primitive-types" },
				{ "include": "#builtin-types" },
				{
					"name": "support.function.builtin.cshift",
					"match": "\\berror(?=\\s*\\()"
				}
			]
		},

		"function-declarations": {
			"comment": "Type Name( ... )   or   Type Name<T>( ... ), also methods. Statements like 'return Foo(x)' are excluded.",
			"match": "\\b(?!(?:return|else|new|case|using|try|do|in|is|where|ref|const|static|extern|unsafe|unchecked)\\b)([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*(?:<[^;(){}]*?>)?(?:\\[\\]|\\*)*)\\s+([A-Za-z_]\\w*)\\s*(?=<[^;(){}]*>\\s*\\(|\\()",
			"captures": {
				"1": { "patterns": [{ "include": "#type-ref" }] },
				"2": { "name": "entity.name.function.cshift" }
			}
		},

		"function-calls": {
			"match": "\\b([A-Za-z_]\\w*)(?=\\s*(?:<[^;(){}]*>\\s*)?\\()",
			"captures": {
				"1": { "name": "entity.name.function.call.cshift" }
			}
		},

		"type-usages": {
			"patterns": [
				{
					"comment": "struct initializer: Vec2 { X = 1, Y = 2 }",
					"match": "\\b([A-Z]\\w*)(?=\\s*(?:<[^;(){}]*>)?\\s*\\{\\s*(?:\\}|[A-Za-z_]\\w*\\s*=(?!=)))",
					"captures": { "1": { "name": "entity.name.type.cshift" } }
				},
				{
					"comment": "field name in an initializer: { X = 1, Y = 2 }",
					"match": "(?<=[{,]\\s)([A-Za-z_]\\w*)(?=\\s*=(?!=))",
					"captures": { "1": { "name": "variable.other.property.cshift" } }
				},
				{
					"comment": "Vec2 a = ...;  Person p;  parameters: (Vec2 a, ref Vec2 b)",
					"match": "\\b([A-Z]\\w*(?:\\.[A-Z]\\w*)*(?:<[^;(){}=]*?>)?(?:\\[\\]|\\*)*)(?=\\s+[A-Za-z_]\\w*\\s*(?:[=;,)]|$))",
					"captures": { "1": { "patterns": [{ "include": "#type-ref" }] } }
				},
				{
					"comment": "base list and constraints: struct Dog : Animal, IDisposable    where T : IComparable<T>",
					"match": "(?<=[:,]\\s)([A-Z]\\w*)(?=\\s*(?:<[^;(){}]*>)?\\s*(?:,|\\{|$|\\bwhere\\b))",
					"captures": { "1": { "name": "entity.name.type.cshift" } }
				},
				{
					"comment": "generic arguments and type parameters: Pair<T>, Dictionary<TKey, TValue>",
					"match": "(?<=[<,])\\s*([A-Z]\\w*)(?=\\s*[>,<\\[*])",
					"captures": { "1": { "name": "entity.name.type.cshift" } }
				}
			]
		},

		"members": {
			"patterns": [
				{
					"name": "variable.other.private.cshift",
					"comment": "identifiers starting with an underscore are private",
					"match": "\\b_\\w*\\b"
				},
				{
					"name": "variable.other.property.cshift",
					"match": "(?<=\\.|->)\\s*[A-Za-z_]\\w*"
				}
			]
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.cshift",
					"match": "->"
				},
				{
					"name": "punctuation.definition.varargs.cshift",
					"match": "\\.\\.\\."
				},
				{
					"name": "keyword.operator.assignment.cshift",
					"match": "(?:<<|>>|[-+*/%&|^])?=(?!=)"
				},
				{
					"name": "keyword.operator.comparison.cshift",
					"match": "==|!=|<=|>="
				},
				{
					"name": "keyword.operator.logical.cshift",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.bitwise.cshift",
					"match": "<<|[&|^~]"
				},
				{
					"name": "keyword.operator.arithmetic.cshift",
					"match": "[-+*/%]"
				},
				{
					"name": "keyword.operator.conditional.cshift",
					"match": "[?:]"
				},
				{
					"name": "keyword.operator.relational.cshift",
					"match": "[<>]"
				},
				{
					"name": "punctuation.separator.comma.cshift",
					"match": ","
				},
				{
					"name": "punctuation.terminator.statement.cshift",
					"match": ";"
				},
				{
					"name": "punctuation.accessor.cshift",
					"match": "\\."
				}
			]
		}
	}
}
