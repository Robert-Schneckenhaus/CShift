//! Tuples: `(int, string)` is the type `Tuple2<int, string>`, `(1, "a")` a value of it. The language writes and
//! reads them with its own syntax (docs/language/tuples.md); these are the structs behind it.

/// A tuple of 2 values: the type `(T1, T2)`, made by `(a1, a2)`.
///
/// The values are the fields `Item1` and `Item2`; `var (a, b) = t;` takes them apart.
struct Tuple2<T1, T2> : IEquatable<Tuple2<T1, T2>>, IHashable
{
    /// The first value.
    T1 Item1;
    /// The second value.
    T2 Item2;

    /// Whether every value equals the one at the same position in `other`.
    bool Equals(Tuple2<T1, T2> other)
    {
        return Item1.Equals(other.Item1) && Item2.Equals(other.Item2);
    }

    /// A hash code made of the hash codes of the values (tuples can be keys of a [Dictionary]).
    int GetHashCode()
    {
        int hash = Item1.GetHashCode();
        hash = unchecked(hash * 31 + Item2.GetHashCode());
        return hash;
    }

    /// The values as text: `(1, abc)`.
    string ToString()
    {
        return $"({Item1}, {Item2})";
    }
}

/// A tuple of 3 values: the type `(T1, T2, T3)`, made by `(a1, a2, a3)`.
///
/// The values are the fields `Item1` to `Item3`; `var (a, b, c) = t;` takes them apart.
struct Tuple3<T1, T2, T3> : IEquatable<Tuple3<T1, T2, T3>>, IHashable
{
    /// The first value.
    T1 Item1;
    /// The second value.
    T2 Item2;
    /// The third value.
    T3 Item3;

    /// Whether every value equals the one at the same position in `other`.
    bool Equals(Tuple3<T1, T2, T3> other)
    {
        return Item1.Equals(other.Item1) && Item2.Equals(other.Item2) && Item3.Equals(other.Item3);
    }

    /// A hash code made of the hash codes of the values (tuples can be keys of a [Dictionary]).
    int GetHashCode()
    {
        int hash = Item1.GetHashCode();
        hash = unchecked(hash * 31 + Item2.GetHashCode());
        hash = unchecked(hash * 31 + Item3.GetHashCode());
        return hash;
    }

    /// The values as text: `(1, abc)`.
    string ToString()
    {
        return $"({Item1}, {Item2}, {Item3})";
    }
}

