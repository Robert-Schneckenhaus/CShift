namespace System.Ui;

using System;
using System.Image;

//! User interfaces in immediate mode: the program describes its whole window again for every frame, from its own
//! state, and a widget reports what the user did with it as its result. There are no widget objects, callbacks or
//! events to unsubscribe, and the state stays in the program's own structs.
//!
//! ```
//! using System.Ui;
//!
//! struct App { int Count; string Name; bool Loud; }
//!
//! void Draw(Ui ui, ref App app)
//! {
//!     ui.Label($"Count: {app.Count}");
//!     using (ui.Row())
//!     {
//!         if (ui.Button("-")) app.Count -= 1;
//!         if (ui.Button("+")) app.Count += 1;
//!     }
//!     ui.TextBox("name", ref app.Name);
//!     ui.Checkbox("Loud", ref app.Loud);
//! }
//!
//! int Main()
//! {
//!     var window = try Window.Open("Counter", 320, 200);
//!     var ui = Ui.Create();
//!     var app = App { Name = "World" };
//!     while (window.Update())
//!     {
//!         ui.Begin(window);
//!         Draw(ui, ref app);
//!         window.Show(ui);
//!     }
//!     return 0;
//! }
//! ```
//!
//! A [Ui] draws into an [Image] with the software renderer of [Canvas], so it also works without a window (tests,
//! screenshots: [Ui.Begin] with a [UiInput] of your own). Sizes are in pixels at a scale of 1 (96 dpi); a [Window]
//! reports the scale of its screen, and the Ui picks a font and the sizes for it.

/// The modifier keys held with a key press ([UiInput.Pressed] with modifiers, [UiInput.ModifiersAt]); they combine
/// with `|`: `KeyModifiers.Ctrl | KeyModifiers.Shift`.
enum KeyModifiers : int32
{
    /// No modifier key.
    None = 0,
    /// A Ctrl key.
    Ctrl = 1,
    /// A Shift key.
    Shift = 2,
    /// An Alt key.
    Alt = 4
}

// Removes the first press of a key (a popup took it).
UiInput _UiRemoveKey(UiInput input, Key key)
{
    if (!input.Keys.IsCreated())
        return input;
    int i = input.Keys.IndexOf(key);
    if (i < 0)
        return input;
    input.Keys.RemoveAt(i);
    if (input.Modifiers.IsCreated() && i < input.Modifiers.Count())
        input.Modifiers.RemoveAt(i);
    return input;
}

// Ctrl, Shift and Alt also when they were held with a key of the frame (that ended before the frame did).
UiInput _UiStickModifiers(UiInput input)
{
    if (!input.Modifiers.IsCreated())
        return input;
    foreach (var m in input.Modifiers)
    {
        if ((m & KeyModifiers.Ctrl) != KeyModifiers.None)
            input.Ctrl = true;
        if ((m & KeyModifiers.Shift) != KeyModifiers.None)
            input.Shift = true;
        if ((m & KeyModifiers.Alt) != KeyModifiers.None)
            input.Alt = true;
    }
    return input;
}

// The modifier keys of these states (for the window layers).
KeyModifiers _UiModifiers(bool ctrl, bool shift, bool alt)
{
    var m = KeyModifiers.None;
    if (ctrl)
        m = m | KeyModifiers.Ctrl;
    if (shift)
        m = m | KeyModifiers.Shift;
    if (alt)
        m = m | KeyModifiers.Alt;
    return m;
}

/// The keys that [UiInput.Keys] reports.
enum Key : int32
{
    /// No key.
    None,
    /// Enter (also the one of the number pad).
    Enter,
    /// Escape.
    Escape,
    /// Backspace.
    Backspace,
    /// Delete.
    Delete,
    /// Tab (with Shift: [UiInput.Shift]).
    Tab,
    /// The space bar.
    Space,
    /// Insert.
    Insert,
    /// Arrow left.
    Left,
    /// Arrow right.
    Right,
    /// Arrow up.
    Up,
    /// Arrow down.
    Down,
    /// Home.
    Home,
    /// End.
    End,
    /// Page up.
    PageUp,
    /// Page down.
    PageDown,
    /// The letter A.
    A,
    /// The letter B.
    B,
    /// The letter C.
    C,
    /// The letter D.
    D,
    /// The letter E.
    E,
    /// The letter F.
    F,
    /// The letter G.
    G,
    /// The letter H.
    H,
    /// The letter I.
    I,
    /// The letter J.
    J,
    /// The letter K.
    K,
    /// The letter L.
    L,
    /// The letter M.
    M,
    /// The letter N.
    N,
    /// The letter O.
    O,
    /// The letter P.
    P,
    /// The letter Q.
    Q,
    /// The letter R.
    R,
    /// The letter S.
    S,
    /// The letter T.
    T,
    /// The letter U.
    U,
    /// The letter V.
    V,
    /// The letter W.
    W,
    /// The letter X.
    X,
    /// The letter Y.
    Y,
    /// The letter Z.
    Z,
    /// The digit 0 (of the main keyboard).
    D0,
    /// The digit 1 (of the main keyboard).
    D1,
    /// The digit 2 (of the main keyboard).
    D2,
    /// The digit 3 (of the main keyboard).
    D3,
    /// The digit 4 (of the main keyboard).
    D4,
    /// The digit 5 (of the main keyboard).
    D5,
    /// The digit 6 (of the main keyboard).
    D6,
    /// The digit 7 (of the main keyboard).
    D7,
    /// The digit 8 (of the main keyboard).
    D8,
    /// The digit 9 (of the main keyboard).
    D9,
    /// The function key F1.
    F1,
    /// The function key F2.
    F2,
    /// The function key F3.
    F3,
    /// The function key F4.
    F4,
    /// The function key F5.
    F5,
    /// The function key F6.
    F6,
    /// The function key F7.
    F7,
    /// The function key F8.
    F8,
    /// The function key F9.
    F9,
    /// The function key F10.
    F10,
    /// The function key F11.
    F11,
    /// The function key F12.
    F12,
    /// Plus: the key of `+` (on a US keyboard the one of `=`, as browsers count it for zooming) and the one of the
    /// number pad.
    Plus,
    /// Minus: the key of `-` and the one of the number pad.
    Minus,
    /// The comma.
    Comma,
    /// The period.
    Period,
    /// The digit 0 of the number pad.
    NumPad0,
    /// The digit 1 of the number pad.
    NumPad1,
    /// The digit 2 of the number pad.
    NumPad2,
    /// The digit 3 of the number pad.
    NumPad3,
    /// The digit 4 of the number pad.
    NumPad4,
    /// The digit 5 of the number pad.
    NumPad5,
    /// The digit 6 of the number pad.
    NumPad6,
    /// The digit 7 of the number pad.
    NumPad7,
    /// The digit 8 of the number pad.
    NumPad8,
    /// The digit 9 of the number pad.
    NumPad9
}

/// The shape of the mouse pointer that a frame asks for (see [Ui.Cursor]).
enum Cursor : int32
{
    /// The normal arrow.
    Arrow = 0,
    /// Over text that can be edited.
    Text = 1,
    /// Over something that can be clicked.
    Hand = 2,
    /// Cross hairs: for pointing at a pixel or a tile.
    Crosshair = 3,
    /// Arrows to all four sides: for moving something.
    Move = 4
}

/// What the user did since the last frame: the state of the mouse and the keys that were pressed. A [Window] fills
/// it in ([Window.Input]); for tests and screenshots a program can make its own.
struct UiInput
{
    /// The position of the mouse in pixels of the frame (-1 when it is outside).
    int MouseX;
    /// The position of the mouse in pixels of the frame (-1 when it is outside).
    int MouseY;
    /// The left mouse button is held down.
    bool MouseDown;
    /// The left button went down since the last frame.
    bool MousePressed;
    /// The left button went up since the last frame (with MousePressed: a click within one frame).
    bool MouseReleased;
    /// The right mouse button is held down (on AmigaOS the menu button).
    bool RightDown;
    /// The right button went down since the last frame.
    bool RightPressed;
    /// The right button went up since the last frame.
    bool RightReleased;
    /// The middle mouse button (the wheel) is held down.
    bool MiddleDown;
    /// The middle button went down since the last frame.
    bool MiddlePressed;
    /// The middle button went up since the last frame.
    bool MiddleReleased;
    /// The mouse wheel, in notches since the last frame: positive when turned away from the user (scroll up).
    int Wheel;
    /// The horizontal wheel (tilting it, or the sideways swipe of a touchpad), in notches since the last frame:
    /// positive to the right. 0 where the window does not report it (AmigaOS).
    int WheelX;
    /// The keys pressed since the last frame, in order, including the repeats of a key that is held.
    List<Key> Keys;
    /// The modifier keys held at each key of [UiInput.Keys], in the same order (a [Window] fills it in; use
    /// [UiInput.AddKey] to add a key with its modifiers). A key without an entry here, in an input that a program
    /// made, counts with the state of Ctrl, Shift and Alt.
    List<KeyModifiers> Modifiers;
    /// The characters typed since the last frame (UTF-8); a window leaves out what was typed with Ctrl.
    string Text;
    /// A Ctrl key is held down, or was held with a key pressed since the last frame (so that `Ctrl && Pressed(Key.S)`
    /// also sees a quick Ctrl+S that ended before the frame; [UiInput.Pressed] with modifiers is exact).
    bool Ctrl;
    /// A Shift key is held down, or was held with a key pressed since the last frame.
    bool Shift;
    /// An Alt key is held down, or was held with a key pressed since the last frame.
    bool Alt;
    /// Seconds since an arbitrary moment, from a monotonic clock (for animations, the blinking of the text cursor,
    /// the delay of tooltips). 0 in an input that a program made itself (no clock).
    double Time;
    /// The window draws slowly (AmigaOS): the Ui asks for no frames of its own - the text cursor does not blink and
    /// tooltips show at once. [Ui.RequestFrame] still works.
    bool Steady;
    /// The user asked to close the window (its close button, Alt+F4, the close gadget) and the window was told to ask
    /// first ([Window.ConfirmClose]): it is still open. The program asks the user, then closes it with
    /// [Window.Close], or keeps it open by doing nothing.
    bool CloseRequested;

    /// No mouse button, no keys, the mouse outside of everything.
    static UiInput Create()
    {
        return UiInput { MouseX = -1, MouseY = -1, Keys = List<Key>.Create(), Text = "" };
    }

    /// True if the key was pressed since the last frame.
    bool Pressed(Key key)
    {
        if (!Keys.IsCreated())
            return false;
        foreach (var k in Keys)
        {
            if (k == key)
                return true;
        }
        return false;
    }

    /// True if the key was pressed since the last frame with exactly these modifier keys held: a shortcut.
    /// `Pressed(Key.S, KeyModifiers.Ctrl)` is Ctrl+S, but not Ctrl+Shift+S; `KeyModifiers.None` is the key alone.
    /// It holds also when the whole shortcut (Ctrl down, S down and up, Ctrl up) was within one frame.
    bool Pressed(Key key, KeyModifiers modifiers)
    {
        if (!Keys.IsCreated())
            return false;
        for (var i = 0; i < Keys.Count(); i += 1)
        {
            if (Keys.Get(i) == key && ModifiersAt(i) == modifiers)
                return true;
        }
        return false;
    }

    /// The modifier keys held at the key `index` of [UiInput.Keys] (without an entry in [UiInput.Modifiers]: the
    /// state of Ctrl, Shift and Alt).
    KeyModifiers ModifiersAt(int index)
    {
        if (Modifiers.IsCreated() && index >= 0 && index < Modifiers.Count())
            return Modifiers.Get(index);
        return HeldModifiers();
    }

    /// Ctrl, Shift and Alt as [KeyModifiers].
    KeyModifiers HeldModifiers()
    {
        var m = KeyModifiers.None;
        if (Ctrl)
            m = m | KeyModifiers.Ctrl;
        if (Shift)
            m = m | KeyModifiers.Shift;
        if (Alt)
            m = m | KeyModifiers.Alt;
        return m;
    }

    /// Adds a key press with the modifier keys held at it (for an input of your own: tests, a recorded input).
    void AddKey(Key key, KeyModifiers modifiers)
    {
        if (!Keys.IsCreated())
            Keys = List<Key>.Create();
        if (!Modifiers.IsCreated())
            Modifiers = List<KeyModifiers>.Create();
        var held = HeldModifiers();
        while (Modifiers.Count() < Keys.Count())
            Modifiers.Add(held);
        Keys.Add(key);
        Modifiers.Add(modifiers);
    }
}

/// What the user did with a dialog of [Ui.FileDialog].
enum UiDialogResult : int32
{
    /// The dialog is still open.
    None,
    /// OK (or Enter in the file name): the path was chosen.
    Ok,
    /// Cancel or Escape.
    Cancel
}

/// The colors of a [Ui]: [Theme.Light] (the default) or [Theme.Dark], or your own.
struct Theme
{
    /// The window.
    Color Background;
    /// Panels.
    Color Panel;
    /// The lines around controls and panels.
    Color Border;
    /// Text.
    Color Text;
    /// Text that is less important (titles of panels, disabled things).
    Color TextMuted;
    /// Buttons, the tracks of sliders and progress bars.
    Color Control;
    /// Buttons and the like under the mouse.
    Color ControlHover;
    /// Buttons and the like while they are pressed.
    Color ControlPressed;
    /// Checked boxes, the filled part of sliders and progress bars, the selected item of a list.
    Color Accent;
    /// Text and marks on the accent color.
    Color AccentText;
    /// The background of text boxes and scroll areas.
    Color Input;
    /// The outline of the control that has the keyboard focus.
    Color Focus;
    /// Selected text, and list items under the mouse.
    Color Selection;

    /// Dark text on light gray (the default).
    static Theme Light()
    {
        return Theme
        {
            Background = Color.FromRgb(243, 243, 243),
            Panel = Color.FromRgb(251, 251, 251),
            Border = Color.FromRgb(200, 200, 200),
            Text = Color.FromRgb(28, 28, 28),
            TextMuted = Color.FromRgb(110, 110, 110),
            Control = Color.FromRgb(253, 253, 253),
            ControlHover = Color.FromRgb(236, 240, 246),
            ControlPressed = Color.FromRgb(214, 222, 234),
            Accent = Color.FromRgb(0, 103, 192),
            AccentText = Color.FromRgb(255, 255, 255),
            Input = Color.FromRgb(255, 255, 255),
            Focus = Color.FromRgb(0, 103, 192),
            Selection = Color.FromRgb(204, 228, 247)
        };
    }

    /// Light text on dark gray.
    static Theme Dark()
    {
        return Theme
        {
            Background = Color.FromRgb(32, 32, 32),
            Panel = Color.FromRgb(43, 43, 43),
            Border = Color.FromRgb(70, 70, 70),
            Text = Color.FromRgb(232, 232, 232),
            TextMuted = Color.FromRgb(160, 160, 160),
            Control = Color.FromRgb(55, 55, 55),
            ControlHover = Color.FromRgb(66, 66, 66),
            ControlPressed = Color.FromRgb(46, 46, 46),
            Accent = Color.FromRgb(76, 194, 255),
            AccentText = Color.FromRgb(0, 0, 0),
            Input = Color.FromRgb(28, 28, 28),
            Focus = Color.FromRgb(76, 194, 255),
            Selection = Color.FromRgb(38, 79, 120)
        };
    }
}

/// The end of a group that [Ui.Row], [Ui.Columns], [Ui.Panel], [Ui.Scroll], [Ui.Id], [Ui.Popup], [Ui.Modal],
/// [Ui.MenuBar] or [Ui.Menu] started: `using (ui.Row()) { ... }` ends it when the block is left.
struct UiScope : IDisposable
{
    /// The Ui it belongs to (internal).
    _UiState[] State;

    /// Ends the group.
    void Dispose()
    {
        State[0].EndScope();
    }
}

/// What a [UiCommand] draws.
enum UiCommandKind : int32
{
    /// The whole frame in `Color`.
    Clear,
    /// `Rect` in `Color`.
    FillRect,
    /// `Rect` with corners of `Radius` in `Color`.
    FillRoundRect,
    /// The outline of `Rect` with corners of `Radius`, `Width` pixels thick, inside of it, in `Color`.
    StrokeRoundRect,
    /// A circle around (`X0`, `Y0`) with the radius `Size`, in `Color` (in 1/16 pixels).
    FillCircle,
    /// A line from (`X0`, `Y0`) to (`X1`, `Y1`), `Size` thick, in `Color` (in 1/16 pixels).
    Line,
    /// `Text` in `Color`, the top left corner of its first character at (`Rect.X`, `Rect.Y`).
    Text,
    /// `Image` with its top left corner at (`Rect.X`, `Rect.Y`).
    Image,
    /// From now on only `Rect` is drawn into.
    Clip,
    /// The part `Source` of `Image`, scaled to `Rect` (nearest neighbour; `Rect` of the size of `Source`: unscaled).
    ImagePart
}

/// One drawing operation of a frame, recorded when a Ui draws with commands instead of pixels ([Ui.BeginCommands],
/// [Ui.Commands]): for windows that draw themselves (the one of AmigaOS draws with graphics.library). Which fields
/// count depends on `Kind`.
struct UiCommand
{
    /// What it draws.
    UiCommandKind Kind;
    /// The rectangle (or the position) of it.
    Rect Rect;
    /// The radius of the corners.
    int Radius;
    /// The thickness of an outline.
    int Width;
    /// The color.
    Color Color;
    /// The center of a circle, the start of a line: in 1/16 pixels (integers, so that a renderer needs no floating
    /// point, which is software on a 68000).
    int X0;
    /// The center of a circle, the start of a line, in 1/16 pixels.
    int Y0;
    /// The end of a line, in 1/16 pixels.
    int X1;
    /// The end of a line, in 1/16 pixels.
    int Y1;
    /// The radius of a circle, the thickness of a line, in 1/16 pixels.
    int Size;
    /// The text (UTF-8).
    string Text;
    /// The image.
    Image Image;
    /// The part of the image that [UiCommandKind.ImagePart] draws.
    Rect Source;
}

/// The user interface: one value for the whole program, created once and given every frame to the code that draws
/// it. Copies share the same state (it is held by reference), so a Ui can be passed to functions by value.
///
/// A frame is [Ui.Begin], the widgets and groups, then [Ui.End] (or [Window.Show], which calls it). Widgets are laid
/// out from top to bottom; [Ui.Row] puts them side by side, [Ui.Columns] into a grid. Every widget has an id, made from its
/// label and the groups around it: two widgets with the same label in the same group need different ids, either with
/// `##` (only what is before it is shown: `"Delete##3"`) or with `using (ui.Id(i))`.
struct Ui
{
    _UiState[] _S;

    /// A new Ui with the light theme.
    static Ui Create()
    {
        var s = new _UiState[1];
        s[0] = _UiState.Create();
        return Ui { _S = s };
    }

    // ---- frames ----

    /// Starts a frame for a window: its input, size and scale (and with commands if the window draws them itself).
    void Begin(Window window)
    {
        Begin(window, 1.0);
    }

    /// The same with the scale of the window multiplied by `zoom` (1.25: everything a quarter larger). For a window,
    /// use this rather than [Ui.Begin] with the window's input and size: that one always draws pixels, which a window
    /// that draws commands (AmigaOS) does not show.
    void Begin(Window window, double zoom)
    {
        double scale = window.Scale() * (zoom > 0 ? zoom : 1.0);
        if (_UiOs.DrawsCommands())
            _S[0].BeginCommands(window.Input(), window.Width(), window.Height(), scale, _UiOs.UiFont());
        else
            _S[0].Begin(window.Input(), window.Width(), window.Height(), scale);
    }

    /// Starts a frame of the given size in pixels; `scale` is 1 at 96 dpi.
    void Begin(UiInput input, int width, int height, double scale)
    {
        _S[0].Begin(input, width, height, scale);
    }

    /// Starts a frame that is not drawn into an image but recorded as commands ([Ui.Commands]), for a renderer of
    /// your own; `font` gives the sizes of the text (see [Font.Metrics]).
    void BeginCommands(UiInput input, int width, int height, double scale, Font font)
    {
        _S[0].BeginCommands(input, width, height, scale, font);
    }

    /// The drawing commands of the last frame begun with [Ui.BeginCommands] (the list is used again by the next one).
    List<UiCommand> Commands() { return _S[0].Commands; }

    /// A hash of [Ui.Commands]: frames that draw the same have the same hash, so a renderer can skip a frame whose hash
    /// is the one of the frame it shows (the mouse moved over nothing) without comparing the commands.
    uint32 CommandsHash() { return _S[0].CommandsHash; }

    /// Ends the frame and gives the image it drew (the same image every frame, as long as the size stays).
    Image End()
    {
        _S[0].End();
        return _S[0].Frame;
    }

    /// The image of the last frame.
    Image Frame() { return _S[0].Frame; }

    /// The mouse pointer that the last frame asks for.
    Cursor Cursor() { return _S[0].WantCursor; }

    /// How long the program may wait for input before it draws the next frame: 0 if the layout is not settled yet
    /// (a panel changed its size), the time until the text cursor blinks, or -1 (no limit).
    int WaitMilliseconds() { return _S[0].WaitMs; }

    /// Asks for the next frame after `milliseconds` at the latest, even if there is no input (an animation): the next
    /// [Window.Update] after [Window.Show] of this frame waits at most that long. Only for the current frame, so a
    /// program that animates calls it every frame; with several calls the shortest wins, and so does a shorter wait
    /// that the Ui needs itself (see [Ui.WaitMilliseconds]). 0: the next frame at once.
    ///
    /// ```
    /// if (animating)
    ///     ui.RequestFrame(166); // the next tile of the animation
    /// ```
    void RequestFrame(int milliseconds)
    {
        int ms = Math.Max(0, milliseconds);
        _S[0].WaitMs = _S[0].WaitMs < 0 ? ms : Math.Min(_S[0].WaitMs, ms);
    }

    /// Uses other colors from the next widget on.
    void SetTheme(Theme theme) { _S[0].Theme = theme; }

    /// The colors in use.
    Theme GetTheme() { return _S[0].Theme; }

    /// The scale of the current frame (1 = 96 dpi).
    double Scale() { return _S[0].Scale; }

    /// The font of the current frame.
    Font Font() { return _S[0].Font; }

    /// The input of the current frame.
    UiInput Input() { return _S[0].In; }

    /// The canvas that the current frame draws on, for drawing of your own (see [Ui.Area]); with commands
    /// ([Ui.BeginCommands]) it draws into an empty image.
    Canvas Canvas() { return _S[0].Canvas; }

    /// Takes a rectangle of the layout for drawing of your own: `width` (0: as wide as there is room) x `height`
    /// (0: down to the bottom of the window) pixels at scale 1. Returns it in pixels of the frame. It takes the mouse
    /// like a widget: [Ui.Hovered], [Ui.Held], [Ui.Clicked] and [Ui.RightClicked] tell what the mouse does with it.
    Rect Area(int width, int height)
    {
        return _S[0].Area(_S[0].IdOf("#area:" + _S[0].AreaCount.ToString()), width, height);
    }

    /// The same with an id of its own (areas that are not always drawn, or in a different order).
    Rect Area(string id, int width, int height)
    {
        return _S[0].Area(_S[0].IdOf("#area:" + id), width, height);
    }

    // ---- what the mouse did with the widget placed last ----

    /// True if the widget (or [Ui.Area]) placed last is under the mouse.
    bool Hovered() { return _S[0].LastHot; }

    /// True in the frame in which the widget placed last was clicked with the left button.
    bool Clicked() { return _S[0].LastId != 0u && _S[0].Active == _S[0].LastId && _S[0].In.MouseReleased && _S[0].LastHot; }

    /// True in the frame in which the widget placed last was clicked with the right button (pressed and released on
    /// it): the secondary action, or [Ui.OpenPopup] for a context menu.
    bool RightClicked()
    {
        return _S[0].LastId != 0u && _S[0].RightActive == _S[0].LastId && _S[0].In.RightReleased && _S[0].LastHot;
    }

    /// True while the left button that went down on the widget placed last is held (dragging, painting into an area).
    bool Held() { return _S[0].LastId != 0u && _S[0].Active == _S[0].LastId && _S[0].In.MouseDown; }

    /// True while the right button that went down on the widget placed last is held.
    bool RightHeld() { return _S[0].LastId != 0u && _S[0].RightActive == _S[0].LastId && _S[0].In.RightDown; }

    /// The mouse pointer for this frame, whatever the widgets under it ask for (call it after the [Ui.Area] it is
    /// for, while that is hovered: `if (ui.Hovered()) ui.SetCursor(Cursor.Crosshair);`).
    void SetCursor(Cursor cursor) { _S[0].CursorOverride = cursor; _S[0].HasCursorOverride = true; }

    // ---- drawing of your own that keeps to the layers ----

    /// Fills a rectangle (pixels of the frame). Unlike [Ui.Canvas], this draws in the layer that is being drawn:
    /// inside a [Ui.Popup] or [Ui.Modal] on top of the frame, and as commands with [Ui.BeginCommands].
    void FillRect(Rect rect, Color color) { _S[0].FillRect(rect, color); }

    /// Draws text with its top left corner at (x, y) in the font of the Ui (in the layer that is being drawn).
    void DrawText(int x, int y, string text, Color color) { _S[0].DrawText(x, y, text, color); }

    /// Draws an image with its top left corner at (x, y) (in the layer that is being drawn).
    void DrawImage(Image image, int x, int y) { _S[0].DrawImage(image, x, y); }

    /// Draws the part `source` of an image scaled to `target` (nearest neighbour), in the layer that is being drawn.
    void DrawImage(Image image, Rect source, Rect target) { _S[0].DrawImagePart(image, source, target); }

    // ---- groups ----

    /// The widgets in the block go side by side, each as wide as it needs (text boxes, sliders and the like take the
    /// rest of the line).
    UiScope Row() { _S[0].BeginLayout(1, 0); return UiScope { State = _S }; }

    /// The widgets in the block go below each other (inside a [Ui.Row]: a column in it).
    UiScope Column() { _S[0].BeginLayout(0, 0); return UiScope { State = _S }; }

    /// The widgets in the block go into a grid of `count` columns of equal width, row by row.
    UiScope Columns(int count) { _S[0].BeginLayout(2, Math.Max(1, count)); return UiScope { State = _S }; }

    /// A framed group with a title (empty: none); the widgets in the block go below each other.
    UiScope Panel(string title) { _S[0].BeginPanel(title); return UiScope { State = _S }; }

    /// Inside a [Ui.Row]: a column of a fixed width (pixels at scale 1), or with 0 one that takes the rest of the row
    /// (several share it equally). A side bar next to a view: `using (ui.Row()) { using (ui.Column(220)) { ... }
    /// using (ui.Column(0)) { ... } }`.
    UiScope Column(int width) { _S[0].BeginFixedColumn(width); return UiScope { State = _S }; }

    /// An area of the given height (pixels at scale 1; 0: down to the bottom of the window) whose content scrolls: with
    /// the mouse wheel and a scroll bar.
    UiScope Scroll(string id, int height) { _S[0].BeginScroll(id, 0, height, false); return UiScope { State = _S }; }

    /// An area of `width` x `height` (pixels at scale 1; 0: the room there is, down to the bottom of the window) whose
    /// content scrolls both ways: content wider than it (an [Ui.Area] of a fixed size, a long row) gets a horizontal
    /// scroll bar. The wheel scrolls up and down, Shift with the wheel (and the horizontal wheel) to the sides.
    UiScope ScrollArea(string id, int width, int height) { _S[0].BeginScroll(id, width, height, true); return UiScope { State = _S }; }

    /// How far the scroll area with this id (in this group) is scrolled to the right, in pixels of the frame.
    int ScrollX(string id) { return _S[0].Scrolls.GetOrDefault(_S[0].IdOf("#scroll:" + id), _UiScroll { }).OffsetX; }

    /// How far the scroll area with this id is scrolled down, in pixels of the frame.
    int ScrollY(string id) { return _S[0].Scrolls.GetOrDefault(_S[0].IdOf("#scroll:" + id), _UiScroll { }).Offset; }

    /// Scrolls the area with this id from the next frame on (pixels of the frame; it keeps to the content).
    void SetScroll(string id, int x, int y) { _S[0].SetScroll(_S[0].IdOf("#scroll:" + id), x, y); }

    /// Makes the ids of the widgets in the block different from those of the same widgets elsewhere (lists).
    UiScope Id(int value) { _S[0].BeginId(value.ToString()); return UiScope { State = _S }; }

    /// The same with a text.
    UiScope Id(string value) { _S[0].BeginId(value); return UiScope { State = _S }; }

    // ---- popups, menus and dialogs: a layer drawn over the rest, which gets the input first ----

    /// Opens the popup with this id at the mouse (a context menu: `if (ui.RightClicked()) ui.OpenPopup("tile");`).
    /// It stays open until an item is chosen ([Ui.MenuItem]), [Ui.CloseCurrentPopup], Escape, or a click outside.
    /// The id of a popup is the same in every group of the frame: it can be opened inside a scroll area or a row
    /// and drawn somewhere else.
    void OpenPopup(string id) { _S[0].OpenPopup(_UiState.GlobalId("#popup:" + id), Rect.Create(_S[0].In.MouseX, _S[0].In.MouseY, 0, 0), 0u, 0u); }

    /// True if the popup with this id is open.
    bool IsPopupOpen(string id) { return _S[0].FindPopup(_UiState.GlobalId("#popup:" + id)) >= 0; }

    /// The content of the popup with this id: while it is open, the widgets in the block are drawn in a frame over
    /// the rest (where [Ui.OpenPopup] put it); while it is closed they draw nothing and do nothing.
    UiScope Popup(string id) { _S[0].BeginPopup(_UiState.GlobalId("#popup:" + id)); return UiScope { State = _S }; }

    /// An item of a popup or menu; true in the frame in which it was chosen, which closes the popups.
    bool MenuItem(string label) { return _S[0].MenuItem(label, ""); }

    /// The same with the text of a shortcut on the right ("Ctrl+S"); it is only shown, the program handles the keys.
    bool MenuItem(string label, string shortcut) { return _S[0].MenuItem(label, shortcut); }

    /// Closes the popup that is being drawn (and the ones opened from it).
    void CloseCurrentPopup() { _S[0].CloseCurrentPopup(); }

    /// A dialog in the middle of the window, with a title, over the dimmed rest of the window, which gets no input
    /// while it is shown. It is shown as long as the program draws it: `if (app.Asking) using (ui.Modal("ask",
    /// "Unsaved changes")) { ... if (ui.Button("Cancel")) app.Asking = false; }`.
    UiScope Modal(string id, string title) { _S[0].BeginModal(id, title); return UiScope { State = _S }; }

    /// A bar of menus across the frame: `using (ui.MenuBar()) { using (ui.Menu("File")) { ... } }`.
    UiScope MenuBar() { _S[0].BeginMenuBar(); return UiScope { State = _S }; }

    /// A menu of a [Ui.MenuBar]: its title in the bar, and while it is open (a click on the title) the widgets in the
    /// block in a popup below it ([Ui.MenuItem]).
    UiScope Menu(string label) { _S[0].BeginMenu(label); return UiScope { State = _S }; }

    /// Shows a text next to the mouse while it rests on the widget placed last (after half a second).
    void Tooltip(string text) { _S[0].Tooltip(text); }

    /// A modal dialog for choosing a file, made of widgets (not the dialog of the system): the folder as a text box
    /// with "Up", its folders and files ([Directory.GetEntries]), the name of the file, OK and Cancel. It starts in the
    /// folder of `path` and shows it as long as the program draws it; `path` becomes the chosen file when it returns
    /// [UiDialogResult.Ok]: `if (app.Opening) { var r = ui.FileDialog("open", "Open map", ref app.Path); if (r !=
    /// UiDialogResult.None) app.Opening = false; }`.
    UiDialogResult FileDialog(string id, string title, ref string path) { return _S[0].FileDialog(id, title, ref path); }

    // ---- widgets ----

    /// Text in one line.
    void Label(string text) { _S[0].Label(text, false); }

    /// Text in the muted color of the theme.
    void Note(string text) { _S[0].Label(text, true); }

    /// Text that is wrapped at the width of the layout (also at line ends).
    void Text(string text) { _S[0].Paragraph(text); }

    /// A button; true in the frame in which it was clicked (also with Enter or Space when it has the focus).
    bool Button(string label) { return _S[0].Button(label); }

    /// A check box; true in the frame in which the user changed `value`.
    bool Checkbox(string label, ref bool value) { return _S[0].Checkbox(label, ref value); }

    /// One of a group of options: `value` becomes `option` when it is chosen; true in that frame.
    bool Radio(string label, ref int value, int option) { return _S[0].Radio(label, ref value, option); }

    /// A slider from `min` to `max`; true in the frames in which the user changed `value`. With the keyboard: the
    /// arrow keys move it by 1/100 of the range.
    bool Slider(string id, ref double value, double min, double max) { return _S[0].Slider(id, ref value, min, max, false); }

    /// A slider for whole numbers.
    bool Slider(string id, ref int value, int min, int max)
    {
        double v = (double)value;
        bool changed = _S[0].Slider(id, ref v, (double)min, (double)max, true);
        value = (int)Math.Round(v);
        return changed;
    }

    /// A line of editable text; true in the frames in which the user changed `text`. Keys: the arrows, Home, End,
    /// Backspace, Delete, with Shift to select; Ctrl+A, Ctrl+C, Ctrl+X, Ctrl+V; Escape ends the editing.
    bool TextBox(string id, ref string text) { return _S[0].TextBox(id, ref text); }

    /// True in the frame in which Enter was pressed in the text box with this id.
    bool Submitted(string id) { return _S[0].Submitted(id); }

    /// A bar that is filled from 0.0 to 1.0.
    void ProgressBar(double fraction) { _S[0].ProgressBar(fraction); }

    /// A line of a list that can be selected; true in the frame in which it was clicked.
    bool ListItem(string label, bool selected) { return _S[0].ListItem(label, selected); }

    /// A drop-down list: shows the item `selected` (an index into `items`), and a click opens the list over the other
    /// widgets (it scrolls if it is long). Choosing an item sets `selected` and closes it, Escape or a click outside
    /// closes it too. With the focus: Up and Down choose the previous or next item, Enter or Space open the list (in
    /// it Up, Down and Enter). True in the frame in which `selected` changed.
    bool ComboBox(string id, ref int selected, List<string> items) { return _S[0].ComboBox(id, ref selected, items); }

    /// A text box for a whole number from `min` to `max`: it takes digits and `-`, Up and Down add or subtract 1, and
    /// the number is kept in the range. True in the frame in which `value` changed.
    bool IntBox(string id, ref int value, int min, int max) { return _S[0].IntBox(id, ref value, min, max); }

    /// An image, in its own size.
    void Image(Image image) { _S[0].ImageWidget(image); }

    /// A horizontal line.
    void Separator() { _S[0].Separator(); }

    /// Empty space of the given size (pixels at scale 1): down in a column, to the right in a row.
    void Space(int size) { _S[0].Space(size); }

    /// The rectangle of the widget (or group) that was placed last, in pixels of the frame.
    Rect LastRect() { return _S[0].Last; }

    /// True if the widget with this id (a label with its `##` part) is under the mouse in this frame - for widgets
    /// that come before; it is known once they are drawn.
    bool IsHovered(string id) { return _S[0].Hot == _S[0].IdOf(id); }

    /// True if the widget with this id has the keyboard focus.
    bool HasFocus(string id) { return _S[0].Focus == _S[0].IdOf(id); }

    /// Gives the keyboard focus to the widget with this id from the next frame on (0 ids: none).
    void SetFocus(string id) { _S[0].FocusNext = _S[0].IdOf(id); _S[0].FocusSet = true; _S[0].Again = true; }
}

// A group that is open: where the next widget goes, and what to do at its end.
struct _UiLayout
{
    int Kind;        // 0 column, 1 row, 2 grid
    int Columns;     // grid: the number of columns
    Rect Area;       // the room of the content (Height is not limited)
    int X;           // where the next widget goes
    int Y;
    int LineHeight;  // row and grid: the tallest widget of the current line
    int Index;       // grid: the cell of the current line
    int Right;       // the rightmost and lowest pixel used so far
    int Bottom;
    int Scope;       // 0 layout, 1 panel, 2 scroll area, 3 id, 4 a closed popup (skipped), 5 popup, 6 modal
    uint32 Id;       // panel, scroll area: its id; the seed of the ids inside
    Rect Outer;      // panel, scroll area: its frame
    Rect SavedClip;
    int ScrollOffset;
    uint32 RowKey;   // row: its key in RowMemos
    int FillWidth;   // row: the width of a widget that fills (from the last frame), 0: the rest of the line
    int Fixed;       // row: the widths of the widgets that do not fill, so far
    int Fills;       // row: the number of widgets that fill
    int Items;       // row: the number of widgets
    int Natural;     // the rightmost pixel the widgets would like to reach (popups and modals learn their width from it)
    int FixedWidth;  // a column of a fixed width (Ui.Column(width)): the width it takes in its row
    int SavedLevel;  // popup, modal: the layer drawn before it
    Rect SavedLast;  // popup, modal: the widget placed last before it (it is the last one again after the block)
    uint32 SavedLastId;
    bool SavedLastHot;
    bool Both;       // scroll area: also horizontally
    int ScrollOffsetX;
    bool MenuBar;    // the row of a menu bar
}

// A popup that is open: where, opened from which layer, by which widget (a combo box, a menu).
struct _UiPopup
{
    uint32 Id;
    Rect Anchor;     // the mouse (an empty rectangle) or the widget it opens below
    int OpenedAt;    // the layer that opened it
    uint32 Owner;    // the widget that opened it (it keeps the keys while the popup is open), 0: none
    uint32 Group;    // a menu bar: the popups of its menus replace each other when the mouse moves along it
    bool Drawn;      // its content was drawn in this frame
    bool New;        // opened in this frame (it may be drawn only in the next one)
    int Highlight;   // a combo box: the item that Up, Down and Enter move and choose
    Rect Shown;      // where it was drawn last (a click outside of it closes it)
}

// A popup or a modal dialog as it was drawn: the input goes to the topmost one first.
struct _UiLayer
{
    uint32 Id;
    int Level;
    Rect Rect;
    bool Modal;
    uint32 Owner;
}

// What a row needed in the last frame: the widths of its widgets that do not fill, and how many fill the rest.
struct _UiRowMemo : IEquatable<_UiRowMemo>
{
    int Fixed;
    int Fills;
    int Items;

    bool Equals(_UiRowMemo other)
    {
        return Fixed == other.Fixed && Fills == other.Fills && Items == other.Items;
    }
}

// The state of a file dialog (Ui.FileDialog): the folder it shows and its entries, the name of the file.
struct _UiFileDialog
{
    string Folder;
    string FolderText;        // the text box of the folder (taken with Enter)
    string Name;
    string Listed;            // the folder whose entries are in Entries
    List<string> Entries;     // folders first (with a "/" at the end), then the files
    int Frame;                // the frame it was drawn last
}

struct _UiScroll
{
    int Offset;
    int ContentHeight;
    int OffsetX;
    int ContentWidth;
}

// The state of a Ui (shared by its copies through a one-element array).
struct _UiState
{
    Image Frame;
    Canvas Canvas;
    bool Record;                // draws with commands (Commands), not into Frame
    List<UiCommand> Commands;
    uint32 CommandsHash;        // of the commands of the frame (Add)
    Rect Clip;                  // only this part is drawn into (and the mouse counts only there)
    Rect Bounds;                // the frame
    Font FixedFont;             // the font of a frame with commands
    Theme Theme;
    Font Font;
    double Scale;
    int ScaleQ;                 // Scale in 1/256 (Px)
    UiInput In;
    bool InFrame;               // between Begin and End
    bool PrevMouseDown;

    // the metrics of the current scale
    int ControlHeight;
    int Pad;
    int Spacing;
    int Margin;
    int Radius;
    int Line;        // the thickness of lines (1 at scale 1)

    _UiLayout[] Stack;          // the open groups; Stack[Depth - 1] is the innermost (changed in place, not copied)
    int Depth;
    List<uint32> FocusOrder;    // the focusable widgets of this frame, in order
    Dictionary<uint32, int> PanelHeights;
    Dictionary<uint32, _UiScroll> Scrolls;
    Dictionary<uint32, _UiRowMemo> RowMemos;
    int RowCount;               // rows begun in this frame (their keys)

    Rect Last;                  // the widget placed last
    uint32 Hot;                 // under the mouse (in this frame, so far)
    uint32 Active;              // the mouse went down on it and has not gone up yet
    uint32 Focus;               // gets the keys
    uint32 FocusNext;
    bool FocusSet;
    bool FocusVisible;          // the focus came with the keyboard: show it (not after a click)
    bool Claimed;               // a widget took this frame's mouse press
    bool WheelUsed;
    bool Again;                 // the layout changed: draw another frame at once
    Cursor WantCursor;
    int WaitMs;

    // the text box being edited (the one with the focus)
    uint32 EditId;
    int Caret;                  // byte index into the text
    int Anchor;                 // the other end of the selection
    int ScrollX;                // how far the text is scrolled to the left, in pixels
    double BlinkStart;
    uint32 SubmittedId;
    int DragOffset;             // scroll bars: where the thumb was grabbed

    // the widget placed last (Ui.Hovered, Ui.Clicked, ...), the right button
    uint32 LastId;
    bool LastHot;
    uint32 RightActive;         // the right button went down on it and has not gone up yet
    bool RightClaimed;
    int AreaCount;              // the areas of this frame without an id of their own
    Cursor CursorOverride;
    bool HasCursorOverride;

    // layers: popups and modals are drawn after the frame, in the order of their layers (Level 1, 2, ...)
    int Level;                  // the layer being drawn: 0 the frame itself
    int Skip;                   // > 0: inside a popup that is closed: nothing is drawn, nothing takes input
    List<UiCommand>[] Deferred; // the drawing of the layers 1, 2, ... (index = level)
    int MaxLevel;               // the highest layer drawn in this frame
    List<_UiPopup> Popups;      // the open popups, in the order they were opened
    List<_UiLayer> Layers;      // the popups and modals drawn in this frame
    List<_UiLayer> PrevLayers;  // ... in the last frame: their rectangles get the mouse first
    Dictionary<uint32, Rect> PopupSizes; // the sizes of popups and modals in the last frame
    uint32 TooltipId;           // the widget under the mouse that has a tooltip, since TooltipStart
    double TooltipStart;
    string TooltipText;         // shown at the end of this frame ("" none)
    uint32 IntEditId;           // the IntBox being edited and its text
    string IntText;
    int FrameNumber;            // counts the frames (a file dialog knows that it was opened again)
    Dictionary<uint32, _UiFileDialog> FileDialogs;

    static _UiState Create()
    {
        return _UiState
        {
            Frame = Image.Create(0, 0),
            Theme = Theme.Light(),
            Font = Font.Fixed7x13(),
            Scale = 0.0,
            In = UiInput.Create(),
            Stack = new _UiLayout[8],
            Commands = List<UiCommand>.Create(),
            FocusOrder = List<uint32>.Create(),
            PanelHeights = Dictionary<uint32, int>.Create(),
            Scrolls = Dictionary<uint32, _UiScroll>.Create(),
            RowMemos = Dictionary<uint32, _UiRowMemo>.Create(),
            WaitMs = -1,
            Deferred = new List<UiCommand>[4],
            Popups = List<_UiPopup>.Create(),
            Layers = List<_UiLayer>.Create(),
            PrevLayers = List<_UiLayer>.Create(),
            PopupSizes = Dictionary<uint32, Rect>.Create(),
            TooltipText = "",
            IntText = "",
            FileDialogs = Dictionary<uint32, _UiFileDialog>.Create()
        };
    }

    // pixels at scale 1 -> pixels of the frame
    int Px(int size)
    {
        // in 1/256 (ScaleQ, set with Scale): no floating point here, which is software on a 68000 or a 68020 without FPU
        int scaled = size * ScaleQ;
        return scaled >= 0 ? (scaled + 128) >> 8 : -((-scaled + 128) >> 8);
    }

    // ---- frames ----

    void Begin(UiInput input, int width, int height, double scale)
    {
        double s = scale > 0 ? scale : 1.0;
        if (s != Scale || Record)
        {
            Record = false;
            Metrics(s, Font.ForScale(s));
        }
        int w = Math.Max(1, width);
        int h = Math.Max(1, height);
        if (Frame.Width != w || Frame.Height != h)
            Frame = Image.Create(w, h);
        Canvas = Canvas.Create(Frame);
        Start(input, w, h);
    }

    void BeginCommands(UiInput input, int width, int height, double scale, Font font)
    {
        double s = scale > 0 ? scale : 1.0;
        if (s != Scale || !Record || font.Width != FixedFont.Width || font.Height != FixedFont.Height)
        {
            Record = true;
            FixedFont = font;
            Metrics(s, font);
        }
        Commands.Clear();
        CommandsHash = 2166136261u;
        Frame = Image.Create(0, 0);
        Canvas = Canvas.Create(Frame);
        Start(input, Math.Max(1, width), Math.Max(1, height));
    }

    // the sizes for a scale and a font
    void Metrics(double scale, Font font)
    {
        Scale = scale;
        ScaleQ = (int)Math.Round(scale * 256.0);
        Font = font;
        int lh = Font.LineHeight();
        Pad = Px(4);
        ControlHeight = lh + 2 * Px(5);
        Spacing = Px(6);
        Margin = Px(10);
        Radius = Px(4);
        Line = Math.Max(1, Px(1));
    }

    // the rest of Begin: the background, the state of the frame, the root of the layout
    void Start(UiInput input, int w, int h)
    {
        Bounds = Rect.Create(0, 0, w, h);
        Clip = Bounds;
        ClearFrame(Theme.Background);
        In = input;
        InFrame = true;
        if (!In.Keys.IsCreated())
            In.Keys = List<Key>.Create();
        In = _UiStickModifiers(In); // Ctrl, Shift and Alt also when they were held with a key of the frame
        if (FocusSet)
        {
            Focus = FocusNext;
            FocusSet = false;
        }
        Hot = 0u;
        FocusOrder.Clear();
        Claimed = false;
        RightClaimed = false;
        WheelUsed = false;
        Again = false;
        WantCursor = Cursor.Arrow;
        HasCursorOverride = false;
        WaitMs = -1;
        SubmittedId = 0u;
        RowCount = 0;
        AreaCount = 0;
        LastId = 0u;
        LastHot = false;
        Depth = 0;
        Level = 0;
        Skip = 0;
        FrameNumber += 1;
        for (var i = 1; i <= MaxLevel && i < Deferred.Length; i += 1)
        {
            if (Deferred[i].IsCreated())
                Deferred[i].Clear();
        }
        MaxLevel = 0;
        TooltipText = "";
        var swap = PrevLayers;
        PrevLayers = Layers;
        Layers = swap;
        Layers.Clear();
        // the layers of popups closed since: no longer in the way
        for (var i = PrevLayers.Count() - 1; i >= 0; i -= 1)
        {
            if (!PrevLayers.Get(i).Modal && FindPopup(PrevLayers.Get(i).Id) < 0)
                PrevLayers.RemoveAt(i);
        }
        ClosePopupsByInput();
        for (var i = 0; i < Popups.Count(); i += 1)
        {
            var p = Popups.Get(i);
            p.Drawn = false;
            Popups.Set(i, p);
        }
        var root = _UiLayout { Kind = 0, Area = Rect.Create(Margin, Margin, w - 2 * Margin, h - 2 * Margin), Scope = 0 };
        root.X = root.Area.X;
        root.Y = root.Area.Y;
        root.Right = root.X;
        root.Bottom = root.Y;
        root.SavedClip = Clip;
        Push(root);
    }

    void End()
    {
        if (!InFrame)
            return; // ended already (ui.End() and then Window.Show(ui))
        InFrame = false;
        while (Depth > 1)
            EndScope();
        // Tab moves the focus along the focusable widgets of this frame
        if (In.Pressed(Key.Tab) && FocusOrder.Count() > 0)
        {
            int index = FocusOrder.IndexOf(Focus);
            int count = FocusOrder.Count();
            // Shift with the Tab press (not at the end of the frame)
            bool back = (In.ModifiersAt(In.Keys.IndexOf(Key.Tab)) & KeyModifiers.Shift) != KeyModifiers.None;
            int next = index < 0 ? (back ? count - 1 : 0) : (back ? (index + count - 1) % count : (index + 1) % count);
            FocusNext = FocusOrder.Get(next);
            FocusSet = true;
            FocusVisible = true;
            Again = true;
        }
        if (In.MousePressed && !Claimed)
            Focus = 0u; // a click on nothing
        if (In.MouseReleased || !In.MouseDown)
            Active = 0u;
        if (In.RightReleased || !In.RightDown)
            RightActive = 0u;
        if (Focus != EditId)
            EditId = 0u;
        if (EditId != IntEditId)
            IntEditId = 0u;
        if (Hot != TooltipId)
            TooltipId = 0u;
        PrevMouseDown = In.MouseDown;
        if (HasCursorOverride)
            WantCursor = CursorOverride;
        // popups that were not drawn in this frame are closed (unless they were opened in it)
        for (var i = 0; i < Popups.Count(); i += 1)
        {
            var p = Popups.Get(i);
            if (!p.Drawn && !p.New)
            {
                ClosePopupsFrom(i);
                break;
            }
            p.New = false;
            Popups.Set(i, p);
        }
        DrawTooltip();
        DrawLayers();
        if (Again)
            WaitMs = 0;
    }

    // the layers over the frame, in order: replayed onto the image, or appended to the commands
    void DrawLayers()
    {
        for (var level = 1; level <= MaxLevel && level < Deferred.Length; level += 1)
        {
            if (!Deferred[level].IsCreated())
                continue;
            foreach (var c in Deferred[level])
            {
                if (Record)
                    Add(c);
                else
                    Execute(c);
            }
        }
        if (MaxLevel > 0)
        {
            if (Record)
                Add(UiCommand { Kind = UiCommandKind.Clip, Rect = Bounds });
            else
                Canvas.SetClip(Bounds);
        }
    }

    // draws a recorded command onto the canvas of the frame
    void Execute(UiCommand c)
    {
        switch (c.Kind)
        {
        case UiCommandKind.Clear:
            Canvas.Clear(c.Color);
            break;
        case UiCommandKind.FillRect:
            Canvas.FillRect(c.Rect, c.Color);
            break;
        case UiCommandKind.FillRoundRect:
            Canvas.FillRoundRect(c.Rect, c.Radius, c.Color);
            break;
        case UiCommandKind.StrokeRoundRect:
            Canvas.StrokeRoundRect(c.Rect, c.Radius, c.Width, c.Color);
            break;
        case UiCommandKind.FillCircle:
            Canvas.FillCircle((double)c.X0 / 16.0, (double)c.Y0 / 16.0, (double)c.Size / 16.0, c.Color);
            break;
        case UiCommandKind.Line:
            Canvas.Line((double)c.X0 / 16.0, (double)c.Y0 / 16.0, (double)c.X1 / 16.0, (double)c.Y1 / 16.0, (double)c.Size / 16.0, c.Color);
            break;
        case UiCommandKind.Text:
            Canvas.Text(Font, c.Rect.X, c.Rect.Y, c.Text, c.Color);
            break;
        case UiCommandKind.Image:
            Canvas.DrawImage(c.Image, c.Rect.X, c.Rect.Y);
            break;
        case UiCommandKind.ImagePart:
            Canvas.DrawImage(c.Image, c.Source, c.Rect);
            break;
        case UiCommandKind.Clip:
            Canvas.SetClip(c.Rect);
            break;
        }
    }

    // ---- drawing: into the image, or as commands ----

    void Add(UiCommand command)
    {
        Commands.Add(command);
        // what the command draws, into the hash of the frame (a window skips a frame with the hash of the one it shows)
        uint32 h = CommandsHash;
        h = unchecked((h ^ (uint32)command.Kind) * 16777619u);
        h = unchecked((h ^ (uint32)command.Rect.X) * 16777619u);
        h = unchecked((h ^ (uint32)command.Rect.Y) * 16777619u);
        h = unchecked((h ^ (uint32)command.Rect.Width) * 16777619u);
        h = unchecked((h ^ (uint32)command.Rect.Height) * 16777619u);
        h = unchecked((h ^ (uint32)(command.Radius + command.Width * 4096)) * 16777619u);
        h = unchecked((h ^ command.Color.ToArgb()) * 16777619u);
        h = unchecked((h ^ (uint32)(command.X0 + command.X1 * 65599)) * 16777619u);
        h = unchecked((h ^ (uint32)(command.Y0 + command.Y1 * 65599 + command.Size * 31)) * 16777619u);
        var text = command.Text;
        for (var i = 0; i < text.Length; i += 1)
            h = unchecked((h ^ (uint32)text[i]) * 16777619u);
        if (command.Kind == UiCommandKind.Image || command.Kind == UiCommandKind.ImagePart)
        {
            // which image (its pixels), which part of it, and how often it changed (Image.Changed)
            var image = command.Image;
            h = unchecked((h ^ (uint32)(command.Source.X + command.Source.Y * 65599)) * 16777619u);
            h = unchecked((h ^ (uint32)(command.Source.Width + command.Source.Height * 65599)) * 16777619u);
            h = unchecked((h ^ (uint32)(image.Width + image.Height * 65599)) * 16777619u);
            h = unchecked((h ^ image.Changes) * 16777619u);
            if (image.Pixels.Length > 0)
            {
                unsafe
                {
                    h = unchecked((h ^ (uint32)(nuint)&image.Pixels[0]) * 16777619u);
                }
            }
        }
        CommandsHash = h;
    }

    // a drawing operation of a layer over the frame, or of a frame drawn with commands
    void Emit(UiCommand command)
    {
        if (Level > 0)
        {
            if (Level >= Deferred.Length)
            {
                var bigger = new List<UiCommand>[Level + 4];
                for (var i = 0; i < Deferred.Length; i += 1)
                    bigger[i] = Deferred[i];
                Deferred = bigger;
            }
            if (!Deferred[Level].IsCreated())
                Deferred[Level] = List<UiCommand>.Create();
            Deferred[Level].Add(command);
            if (Level > MaxLevel)
                MaxLevel = Level;
        }
        else
            Add(command);
    }

    bool Direct() { return Level == 0 && !Record; }

    void ClearFrame(Color color)
    {
        if (Record)
            Add(UiCommand { Kind = UiCommandKind.Clear, Color = color, Rect = Clip });
        else
            Canvas.Clear(color);
    }

    // only this part from now on (within the frame)
    void SetClip(Rect clip)
    {
        Clip = clip.Intersect(Bounds);
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.SetClip(Clip);
        else
            Emit(UiCommand { Kind = UiCommandKind.Clip, Rect = Clip });
    }

    void FillRect(Rect r, Color color)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.FillRect(r, color);
        else
            Emit(UiCommand { Kind = UiCommandKind.FillRect, Rect = r, Color = color });
    }

    void FillRoundRect(Rect r, int radius, Color color)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.FillRoundRect(r, radius, color);
        else
            Emit(UiCommand { Kind = UiCommandKind.FillRoundRect, Rect = r, Radius = radius, Color = color });
    }

    void StrokeRoundRect(Rect r, int radius, int width, Color color)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.StrokeRoundRect(r, radius, width, color);
        else
            Emit(UiCommand { Kind = UiCommandKind.StrokeRoundRect, Rect = r, Radius = radius, Width = width, Color = color });
    }

    // circles and lines in 1/16 pixels: no floating point in a frame (it is software on a 68000), except in Canvas
    void FillCircle(int cx, int cy, int radius, Color color)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.FillCircle((double)cx / 16.0, (double)cy / 16.0, (double)radius / 16.0, color);
        else
            Emit(UiCommand { Kind = UiCommandKind.FillCircle, X0 = cx, Y0 = cy, Size = radius, Color = color });
    }

    void DrawLine(int x0, int y0, int x1, int y1, int width, Color color)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.Line((double)x0 / 16.0, (double)y0 / 16.0, (double)x1 / 16.0, (double)y1 / 16.0, (double)width / 16.0, color);
        else
            Emit(UiCommand { Kind = UiCommandKind.Line, X0 = x0, Y0 = y0, X1 = x1, Y1 = y1, Size = width, Color = color });
    }

    void DrawText(int x, int y, string text, Color color)
    {
        DrawTextOf(x, y, text, Record ? Font.Measure(text) : 0, color);
    }

    // with the width of the text, when it is known already
    void DrawTextOf(int x, int y, string text, int width, Color color)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.Text(Font, x, y, text, color);
        else
            Emit(UiCommand { Kind = UiCommandKind.Text, Rect = Rect.Create(x, y, width, Font.LineHeight()), Text = text, Color = color });
    }

    void DrawImage(Image image, int x, int y)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.DrawImage(image, x, y);
        else
            Emit(UiCommand { Kind = UiCommandKind.Image, Rect = Rect.Create(x, y, image.Width, image.Height), Image = image });
    }

    void DrawImagePart(Image image, Rect source, Rect target)
    {
        if (Skip > 0)
            return;
        if (Direct())
            Canvas.DrawImage(image, source, target);
        else
            Emit(UiCommand { Kind = UiCommandKind.ImagePart, Rect = target, Source = source, Image = image });
    }

    // ---- ids ----

    uint32 Seed()
    {
        return Depth > 0 ? Stack[Depth - 1].Id : 0u;
    }

    // an id that does not depend on the groups around it
    static uint32 GlobalId(string label)
    {
        uint32 h = 2166136261u;
        for (var i = 0; i < label.Length; i += 1)
            h = unchecked((h ^ (uint32)label[i]) * 16777619u);
        return h == 0u ? 1u : h;
    }

    uint32 IdOf(string label)
    {
        uint32 h = Seed() ^ 2166136261u;
        for (var i = 0; i < label.Length; i += 1)
            h = unchecked((h ^ (uint32)label[i]) * 16777619u);
        return h == 0u ? 1u : h;
    }

    // ---- layout ----

    _UiLayout Top() { return Stack[Depth - 1]; }

    void Push(_UiLayout layout)
    {
        if (Depth == Stack.Length)
        {
            var bigger = new _UiLayout[Stack.Length * 2];
            for (var i = 0; i < Depth; i += 1)
                bigger[i] = Stack[i];
            Stack = bigger;
        }
        Stack[Depth] = layout;
        Depth += 1;
    }

    // where the next widget goes, and how wide it may be
    Rect Slot()
    {
        int t = Depth - 1;
        switch (Stack[t].Kind)
        {
        case 1:
            return Rect.Create(Stack[t].X, Stack[t].Y, Math.Max(0, Stack[t].Area.X + Stack[t].Area.Width - Stack[t].X), 0);
        case 2:
        {
            int cell = (Stack[t].Area.Width - (Stack[t].Columns - 1) * Spacing) / Stack[t].Columns;
            return Rect.Create(Stack[t].Area.X + Stack[t].Index * (cell + Spacing), Stack[t].Y, cell, 0);
        }
        default:
            return Rect.Create(Stack[t].X, Stack[t].Y, Stack[t].Area.Width, 0);
        }
    }

    // the widget at the slot took width x height: move on
    void Commit(int width, int height)
    {
        int t = Depth - 1;
        switch (Stack[t].Kind)
        {
        case 1:
            Stack[t].LineHeight = Math.Max(Stack[t].LineHeight, height);
            Stack[t].Right = Math.Max(Stack[t].Right, Stack[t].X + width);
            Stack[t].X += width + Spacing;
            Stack[t].Bottom = Math.Max(Stack[t].Bottom, Stack[t].Y + Stack[t].LineHeight);
            break;
        case 2:
            Stack[t].LineHeight = Math.Max(Stack[t].LineHeight, height);
            Stack[t].Bottom = Math.Max(Stack[t].Bottom, Stack[t].Y + Stack[t].LineHeight);
            Stack[t].Right = Stack[t].Area.X + Stack[t].Area.Width;
            Stack[t].Index += 1;
            if (Stack[t].Index >= Stack[t].Columns)
            {
                Stack[t].Index = 0;
                Stack[t].Y += Stack[t].LineHeight + Spacing;
                Stack[t].LineHeight = 0;
            }
            break;
        default:
            Stack[t].Right = Math.Max(Stack[t].Right, Stack[t].X + width);
            Stack[t].Bottom = Math.Max(Stack[t].Bottom, Stack[t].Y + height);
            Stack[t].Y += height + Spacing;
            break;
        }
    }

    // a widget of a natural width (fill: as wide as there is room)
    Rect Place(int width, int height, bool fill)
    {
        var slot = Slot();
        int w = fill ? slot.Width : Math.Min(width, Math.Max(slot.Width, 0));
        int t = Depth - 1;
        if (Stack[t].Kind == 1)
        {
            // in a row, a widget that fills gets what the others left in the last frame
            if (fill)
            {
                w = Stack[t].FillWidth > 0 ? Math.Min(Stack[t].FillWidth, Math.Max(slot.Width, 0)) : slot.Width;
                if (w <= 0)
                    w = width;
                Stack[t].Fills += 1;
            }
            else
            {
                w = width; // its own width: what is too wide goes past the end of the line
                Stack[t].Fixed += w;
            }
            Stack[t].Items += 1;
        }
        var r = Rect.Create(slot.X, slot.Y, Math.Max(0, w), height);
        Stack[t].Natural = Math.Max(Stack[t].Natural, slot.X + width);
        Commit(r.Width, r.Height);
        Last = r;
        return r;
    }

    // from y down to the bottom of the window (inside its margin), at least a little
    int RestHeight(int y)
    {
        return Math.Max(Px(40), Stack[0].Area.Y + Stack[0].Area.Height - y);
    }

    Rect Area(uint32 id, int width, int height)
    {
        AreaCount += 1;
        int h = height > 0 ? Px(height) : RestHeight(Slot().Y);
        var r = Place(Px(width), h, width <= 0);
        Interact(id, r, false);
        return r;
    }

    void BeginFixedColumn(int width)
    {
        var slot = Slot();
        int t = Depth - 1;
        int w = width > 0 ? Px(width) : slot.Width;
        if (Stack[t].Kind == 1)
        {
            // in a row: a fixed width counts like a widget of that width, 0 like one that fills (the rest)
            if (width > 0)
                Stack[t].Fixed += w;
            else
            {
                if (Stack[t].FillWidth > 0)
                    w = Math.Min(Stack[t].FillWidth, Math.Max(slot.Width, 0));
                Stack[t].Fills += 1;
            }
            Stack[t].Items += 1;
        }
        w = Math.Max(0, w);
        var l = _UiLayout { Kind = 0, Area = Rect.Create(slot.X, slot.Y, w, 0), Scope = 0, Id = Seed(), FixedWidth = Math.Max(1, w) };
        l.X = slot.X;
        l.Y = slot.Y;
        l.Right = slot.X;
        l.Bottom = slot.Y;
        l.SavedClip = Clip;
        Push(l);
    }

    void BeginLayout(int kind, int columns)
    {
        var slot = Slot();
        var l = _UiLayout { Kind = kind, Columns = columns, Area = Rect.Create(slot.X, slot.Y, slot.Width, 0), Scope = 0, Id = Seed() };
        l.X = slot.X;
        l.Y = slot.Y;
        l.Right = slot.X;
        l.Bottom = slot.Y;
        l.SavedClip = Clip;
        if (kind == 1)
        {
            l.RowKey = unchecked(Seed() * 31u + (uint32)RowCount * 2654435761u + 7u);
            RowCount += 1;
            var memo = RowMemos.GetOrDefault(l.RowKey, _UiRowMemo { });
            if (memo.Fills > 0)
                l.FillWidth = Math.Max(Px(20), (slot.Width - memo.Fixed - Spacing * (memo.Items - 1)) / memo.Fills);
        }
        Push(l);
    }

    void BeginId(string value)
    {
        var top = Top();
        uint32 id = IdOf("#id:" + value);
        var l = top;
        l.Scope = 3;
        l.Id = id;
        l.SavedClip = Clip;
        Push(l);
    }

    void BeginPanel(string title)
    {
        uint32 id = IdOf("#panel:" + title);
        var slot = Slot();
        int cached = PanelHeights.GetOrDefault(id, 0);
        var outer = Rect.Create(slot.X, slot.Y, slot.Width, cached);
        FillRoundRect(outer, Radius, Theme.Panel);
        int top = outer.Y + Margin;
        if (title.Length > 0)
        {
            DrawText(outer.X + Margin, top, title, Theme.TextMuted);
            top += Font.LineHeight() + Spacing;
        }
        var l = _UiLayout { Kind = 0, Area = Rect.Create(outer.X + Margin, top, Math.Max(0, outer.Width - 2 * Margin), 0), Scope = 1, Id = id, Outer = outer };
        l.X = l.Area.X;
        l.Y = top;
        l.Right = l.X;
        l.Bottom = top;
        l.SavedClip = Clip;
        Push(l);
    }

    void BeginScroll(string name, int width, int height, bool both)
    {
        BeginScrollPx(name, width > 0 ? Px(width) : 0, height > 0 ? Px(height) : 0, both);
    }

    // the same in pixels of the frame (0: the room there is, down to the bottom of the window)
    void BeginScrollPx(string name, int width, int height, bool both)
    {
        uint32 id = IdOf("#scroll:" + name);
        var slot = Slot();
        int w = width > 0 ? width : slot.Width;
        int h = height > 0 ? height : RestHeight(slot.Y);
        if (width > 0 && Stack[Depth - 1].Kind == 1)
            Stack[Depth - 1].Fixed += w;
        var outer = Rect.Create(slot.X, slot.Y, w, h);
        var state = Scrolls.GetOrDefault(id, _UiScroll { });
        FillRoundRect(outer, Radius, Theme.Input);
        int bar = Px(10);
        int top = outer.Y + Pad - state.Offset;
        int left = outer.X + Pad - (both ? state.OffsetX : 0);
        var l = _UiLayout { Kind = 0, Area = Rect.Create(left, top, Math.Max(0, outer.Width - 2 * Pad - bar), 0), Scope = 2, Id = id, Outer = outer };
        l.X = l.Area.X;
        l.Y = top;
        l.Right = l.X;
        l.Bottom = top;
        l.SavedClip = Clip;
        l.ScrollOffset = state.Offset;
        l.ScrollOffsetX = both ? state.OffsetX : 0;
        l.Both = both;
        Push(l);
        var view = outer.Shrink(Line);
        if (both)
            view.Height = Math.Max(0, view.Height - bar);
        SetClip(view.Intersect(l.SavedClip));
    }

    void SetScroll(uint32 id, int x, int y)
    {
        var state = Scrolls.GetOrDefault(id, _UiScroll { });
        // kept to the content when the area is drawn next
        state.OffsetX = Math.Max(0, x);
        state.Offset = Math.Max(0, y);
        Scrolls.Set(id, state);
        Again = true;
    }

    void EndScope()
    {
        if (Depth <= 1)
            return; // more ends than beginnings
        Depth -= 1;
        var l = Stack[Depth];
        SetClip(l.SavedClip);
        if (Depth > 0)
        {
            // what the widgets inside would like: a popup grows to it (a scroll area adds its bar and border)
            int natural = Math.Max(l.Natural, l.Right);
            if (l.Scope == 2)
                natural += l.Outer.X + l.Outer.Width - (l.Area.X + l.Area.Width);
            Stack[Depth - 1].Natural = Math.Max(Stack[Depth - 1].Natural, natural);
        }
        switch (l.Scope)
        {
        case 1:
        {
            int height = l.Bottom - l.Outer.Y + Margin;
            if (l.Bottom == l.Area.Y)
                height = l.Area.Y - l.Outer.Y + Margin - Spacing; // empty
            if (PanelHeights.GetOrDefault(l.Id, -1) != height)
            {
                PanelHeights.Set(l.Id, height);
                Again = true;
            }
            var outer = Rect.Create(l.Outer.X, l.Outer.Y, l.Outer.Width, height);
            StrokeRoundRect(outer, Radius, Line, Theme.Border);
            Commit(outer.Width, outer.Height);
            Last = outer;
            break;
        }
        case 2:
            EndScroll(l);
            break;
        case 3:
            break; // the layout of an id scope is the one it copied: hand on where it got to
        case 4:
            Skip -= 1; // a closed popup: as if it was not there
            Last = l.SavedLast;
            LastId = l.SavedLastId;
            LastHot = l.SavedLastHot;
            return;
        case 5:
        case 6:
            EndLayer(l);
            return;
        default:
            if (l.Kind == 1)
            {
                var memo = _UiRowMemo { Fixed = l.Fixed, Fills = l.Fills, Items = l.Items };
                if (!RowMemos.GetOrDefault(l.RowKey, _UiRowMemo { Items = -1 }).Equals(memo))
                {
                    RowMemos.Set(l.RowKey, memo);
                    Again = true;
                }
            }
            if (l.FixedWidth > 0)
            {
                // a column of a fixed width takes that width in its row, however wide its widgets are
                Commit(l.FixedWidth, Math.Max(0, l.Bottom - l.Area.Y));
                Last = Rect.Create(l.Area.X, l.Area.Y, l.FixedWidth, Math.Max(0, l.Bottom - l.Area.Y));
            }
            else
                Commit(Math.Max(0, l.Right - l.Area.X), Math.Max(0, l.Bottom - l.Area.Y));
            break;
        }
        if (l.Scope == 3)
        {
            int t = Depth - 1;
            Stack[t].X = l.X;
            Stack[t].Y = l.Y;
            Stack[t].LineHeight = l.LineHeight;
            Stack[t].Index = l.Index;
            Stack[t].Right = l.Right;
            Stack[t].Bottom = l.Bottom;
            Stack[t].Fixed = l.Fixed;
            Stack[t].Fills = l.Fills;
            Stack[t].Items = l.Items;
        }
    }

    void EndScroll(_UiLayout l)
    {
        var outer = l.Outer;
        int bar = Px(10);
        int content = l.Bottom - (outer.Y + Pad - l.ScrollOffset) + Pad;
        int contentWidth = Math.Max(l.Right, l.Natural) - (outer.X + Pad - l.ScrollOffsetX) + Pad;
        int view = outer.Height - (l.Both ? bar : 0);
        int viewWidth = outer.Width - bar;
        int maxOffset = Math.Max(0, content - view);
        int maxOffsetX = l.Both ? Math.Max(0, contentWidth - viewWidth) : 0;
        int offset = l.ScrollOffset;
        int offsetX = l.ScrollOffsetX;
        var mouseInside = outer.Contains(In.MouseX, In.MouseY) && Clip.Contains(In.MouseX, In.MouseY) && Skip == 0 && !MouseBlocked();
        if (mouseInside && !WheelUsed)
        {
            // Shift turns the wheel into a horizontal one
            int wheelY = l.Both && In.Shift ? 0 : In.Wheel;
            int wheelX = In.WheelX + (l.Both && In.Shift ? -In.Wheel : 0);
            if (wheelY != 0 && maxOffset > 0)
            {
                offset -= wheelY * Font.LineHeight() * 3;
                WheelUsed = true;
            }
            if (wheelX != 0 && maxOffsetX > 0)
            {
                offsetX += wheelX * Font.CharWidth() * 6;
                WheelUsed = true;
            }
        }
        uint32 lastId = LastId;
        bool lastHot = LastHot;
        // the vertical scroll bar
        var track = Rect.Create(outer.X + outer.Width - bar - Line, outer.Y + Line, bar, view - 2 * Line);
        uint32 barId = l.Id ^ 0x5bd1e995u;
        if (maxOffset > 0)
        {
            int thumbHeight = Math.Max(Px(20), track.Height * view / Math.Max(1, content));
            int room = Math.Max(1, track.Height - thumbHeight);
            int thumbY = track.Y + (int)((int64)room * Math.Clamp(offset, 0, maxOffset) / maxOffset);
            var thumb = Rect.Create(track.X + Px(2), thumbY, bar - Px(4), thumbHeight);
            bool hot = Interact(barId, track, false);
            if (hot && In.MousePressed)
            {
                DragOffset = thumb.Contains(In.MouseX, In.MouseY) ? In.MouseY - thumb.Y : thumbHeight / 2;
            }
            if (Active == barId && In.MouseDown)
                offset = (int)((int64)(In.MouseY - DragOffset - track.Y) * maxOffset / room);
            offset = Math.Clamp(offset, 0, maxOffset);
            thumbY = track.Y + (int)((int64)room * offset / maxOffset);
            thumb.Y = thumbY;
            Color color = Active == barId ? Theme.TextMuted : Hot == barId ? Theme.TextMuted : Theme.Border;
            FillRoundRect(thumb, thumb.Width / 2, color);
        }
        // the horizontal one
        var trackX = Rect.Create(outer.X + Line, outer.Y + outer.Height - bar - Line, viewWidth - 2 * Line, bar);
        uint32 barXId = l.Id ^ 0x27d4eb2fu;
        if (maxOffsetX > 0)
        {
            int thumbWidth = Math.Max(Px(20), trackX.Width * viewWidth / Math.Max(1, contentWidth));
            int room = Math.Max(1, trackX.Width - thumbWidth);
            int thumbX = trackX.X + (int)((int64)room * Math.Clamp(offsetX, 0, maxOffsetX) / maxOffsetX);
            var thumb = Rect.Create(thumbX, trackX.Y + Px(2), thumbWidth, bar - Px(4));
            bool hot = Interact(barXId, trackX, false);
            if (hot && In.MousePressed)
                DragOffset = thumb.Contains(In.MouseX, In.MouseY) ? In.MouseX - thumb.X : thumbWidth / 2;
            if (Active == barXId && In.MouseDown)
                offsetX = (int)((int64)(In.MouseX - DragOffset - trackX.X) * maxOffsetX / room);
            offsetX = Math.Clamp(offsetX, 0, maxOffsetX);
            thumb.X = trackX.X + (int)((int64)room * offsetX / maxOffsetX);
            Color color = Active == barXId || Hot == barXId ? Theme.TextMuted : Theme.Border;
            FillRoundRect(thumb, thumb.Height / 2, color);
        }
        LastId = lastId;
        LastHot = lastHot;
        offset = Math.Clamp(offset, 0, maxOffset);
        offsetX = Math.Clamp(offsetX, 0, maxOffsetX);
        if (offset != l.ScrollOffset || offsetX != l.ScrollOffsetX)
            Again = true;
        Scrolls.Set(l.Id, _UiScroll { Offset = offset, ContentHeight = content, OffsetX = offsetX, ContentWidth = contentWidth });
        StrokeRoundRect(outer, Radius, Line, Theme.Border);
        Commit(outer.Width, outer.Height);
        Last = outer;
    }

    // ---- interaction ----

    // Tracks the mouse for a widget: true if it is under the mouse. A press on it makes it active (and focused, if
    // focusable); the caller checks Active and In.MouseReleased for a click.
    bool Interact(uint32 id, Rect r, bool focusable)
    {
        LastId = id;
        LastHot = false;
        if (Skip > 0)
            return false;
        if (focusable && !KeysBlocked(id))
            FocusOrder.Add(id);
        bool inside = r.Contains(In.MouseX, In.MouseY) && Clip.Contains(In.MouseX, In.MouseY) && !MouseBlocked();
        bool hot = inside && (Active == 0u || Active == id) && (RightActive == 0u || RightActive == id);
        if (hot)
            Hot = id;
        if (hot && In.MousePressed && !Claimed)
        {
            Active = id;
            Claimed = true;
            Focus = focusable ? id : 0u;
            FocusVisible = false;
        }
        if (hot && In.RightPressed && !RightClaimed)
        {
            RightActive = id;
            RightClaimed = true;
        }
        LastHot = hot;
        return hot;
    }

    // a popup or a modal above the layer being drawn covers the mouse (as they were in the last frame, and those
    // drawn in this one already)
    bool MouseBlocked()
    {
        return Covers(PrevLayers) || Covers(Layers);
    }

    bool Covers(List<_UiLayer> layers)
    {
        foreach (var l in layers)
        {
            if (l.Level > Level && (l.Modal || l.Rect.Contains(In.MouseX, In.MouseY)))
                return true;
        }
        return false;
    }

    // a popup or a modal above the layer being drawn takes the keys (but a popup leaves them to its owner: the combo box
    // whose list is open)
    bool KeysBlocked(uint32 id)
    {
        foreach (var l in PrevLayers)
        {
            if (l.Level > Level && (l.Owner != id || l.Modal))
                return true;
        }
        foreach (var l in Layers)
        {
            if (l.Level > Level && (l.Owner != id || l.Modal))
                return true;
        }
        return false;
    }

    // the widget has the focus and gets the keys
    bool HasKeys(uint32 id)
    {
        return Focus == id && Skip == 0 && !KeysBlocked(id);
    }

    bool Clicked(uint32 id, bool hot)
    {
        return Active == id && In.MouseReleased && hot;
    }

    bool Activated(uint32 id)
    {
        return HasKeys(id) && (In.Pressed(Key.Enter) || In.Pressed(Key.Space));
    }

    // ---- popups and modal dialogs ----

    int FindPopup(uint32 id)
    {
        for (var i = 0; i < Popups.Count(); i += 1)
        {
            if (Popups.Get(i).Id == id)
                return i;
        }
        return -1;
    }

    // closes the popup at this index and the ones opened after it
    void ClosePopupsFrom(int index)
    {
        while (Popups.Count() > index)
        {
            uint32 id = Popups.Get(Popups.Count() - 1).Id;
            Popups.RemoveAt(Popups.Count() - 1);
            for (var i = PrevLayers.Count() - 1; i >= 0; i -= 1)
            {
                if (PrevLayers.Get(i).Id == id)
                    PrevLayers.RemoveAt(i);
            }
        }
        Again = true;
    }

    // Escape closes the innermost popup; a click outside of the popups closes them (a left click goes no further, a
    // right click does: it may open a context menu somewhere else)
    void ClosePopupsByInput()
    {
        if (Popups.Count() == 0)
            return;
        if (In.Pressed(Key.Escape))
        {
            ClosePopupsFrom(Popups.Count() - 1);
            In = _UiRemoveKey(In, Key.Escape);
        }
        if (Popups.Count() > 0 && (In.MousePressed || In.RightPressed))
        {
            int keep = 0;
            for (var i = Popups.Count() - 1; i >= 0; i -= 1)
            {
                if (Popups.Get(i).Shown.Contains(In.MouseX, In.MouseY))
                {
                    keep = i + 1;
                    break;
                }
            }
            if (keep < Popups.Count())
            {
                ClosePopupsFrom(keep);
                In.MousePressed = false;
            }
        }
    }

    // opens a popup at a point (an empty anchor) or below a widget; it replaces the popups opened from the same layer
    void OpenPopup(uint32 id, Rect anchor, uint32 owner, uint32 group)
    {
        if (Skip > 0)
            return;
        for (var i = 0; i < Popups.Count(); i += 1)
        {
            if (Popups.Get(i).OpenedAt >= Level || Popups.Get(i).Id == id)
            {
                ClosePopupsFrom(i);
                break;
            }
        }
        Popups.Add(_UiPopup { Id = id, Anchor = anchor, OpenedAt = Level, Owner = owner, Group = group, New = true, Highlight = -1 });
        Again = true;
    }

    void CloseCurrentPopup()
    {
        for (var t = Depth - 1; t >= 0; t -= 1)
        {
            if (Stack[t].Scope == 5)
            {
                int index = FindPopup(Stack[t].Id);
                if (index >= 0)
                    ClosePopupsFrom(index);
                return;
            }
        }
    }

    // a group whose widgets are not drawn and take no input: a popup that is closed
    void BeginSkipped()
    {
        var l = Top();
        l.Scope = 4;
        l.SavedClip = Clip;
        l.SavedLast = Last;
        l.SavedLastId = LastId;
        l.SavedLastHot = LastHot;
        Push(l);
        Skip += 1;
    }

    void BeginPopup(uint32 id)
    {
        int index = Skip > 0 ? -1 : FindPopup(id);
        if (index < 0)
        {
            BeginSkipped();
            return;
        }
        var p = Popups.Get(index);
        p.Drawn = true;
        Popups.Set(index, p);
        var size = PopupSizes.GetOrDefault(id, Rect.Create(0, 0, Px(120), 0));
        int w = Math.Min(Math.Max(size.Width, p.Anchor.Width), Bounds.Width);
        int h = Math.Min(size.Height, Bounds.Height);
        int x = p.Anchor.X;
        int y = p.Anchor.Y + p.Anchor.Height;
        if (y + h > Bounds.Height)
            y = p.Anchor.Height > 0 && p.Anchor.Y - h >= 0 ? p.Anchor.Y - h : Bounds.Height - h; // above the widget, or up
        if (x + w > Bounds.Width)
            x = Bounds.Width - w;
        var outer = Rect.Create(Math.Max(0, x), Math.Max(0, y), w, h);
        int saved = Level;
        Level = Level + 1;
        var clip = Clip;
        SetClip(Bounds);
        if (!Record)
            FillRoundRect(Rect.Create(outer.X + Px(2), outer.Y + Px(3), outer.Width, outer.Height), Radius, Color.FromArgb(0x30000000u));
        FillRoundRect(outer, Radius, Theme.Panel);
        var l = _UiLayout { Kind = 0, Area = Rect.Create(outer.X + Pad, outer.Y + Pad, Math.Max(0, outer.Width - 2 * Pad), 0), Scope = 5, Id = id, Outer = outer };
        l.X = l.Area.X;
        l.Y = l.Area.Y;
        l.Right = l.X;
        l.Bottom = l.Y;
        l.Natural = l.X;
        l.SavedClip = clip;
        l.SavedLevel = saved;
        l.SavedLast = Last;
        l.SavedLastId = LastId;
        l.SavedLastHot = LastHot;
        Push(l);
    }

    void BeginModal(string name, string title)
    {
        uint32 id = IdOf("#modal:" + name);
        if (Skip > 0)
        {
            BeginSkipped();
            return;
        }
        int saved = Level;
        Level = Level + 1;
        var clip = Clip;
        SetClip(Bounds);
        if (!Record)
            FillRect(Bounds, Color.FromArgb(0x66000000u)); // the rest of the window, dimmed (not with commands: no blending)
        var size = PopupSizes.GetOrDefault(id, Rect.Create(0, 0, Px(320), 0));
        int w = Math.Min(Math.Max(size.Width, Px(240)), Math.Max(1, Bounds.Width - 2 * Margin));
        int h = Math.Min(size.Height, Bounds.Height);
        var outer = Rect.Create((Bounds.Width - w) / 2, Math.Max(0, (Bounds.Height - h) / 2), w, h);
        FillRoundRect(outer, Radius, Theme.Panel);
        int top = outer.Y + Margin;
        if (title.Length > 0)
        {
            DrawText(outer.X + Margin, top, title, Theme.Text);
            top += Font.LineHeight() + Margin;
            FillRect(Rect.Create(outer.X, top - Margin / 2, outer.Width, Line), Theme.Border);
        }
        var l = _UiLayout { Kind = 0, Area = Rect.Create(outer.X + Margin, top, Math.Max(0, outer.Width - 2 * Margin), 0), Scope = 6, Id = id, Outer = outer };
        l.X = l.Area.X;
        l.Y = top;
        l.Right = l.X;
        l.Bottom = top;
        l.Natural = outer.X + Margin + Font.Measure(title);
        l.SavedClip = clip;
        l.SavedLevel = saved;
        l.SavedLast = Last;
        l.SavedLastId = LastId;
        l.SavedLastHot = LastHot;
        Push(l);
    }

    // the end of a popup (5) or a modal (6): its size for the next frame, its frame, the layer for the input
    void EndLayer(_UiLayout l)
    {
        int inset = l.Scope == 5 ? Pad : Margin;
        int width = Math.Max(Px(l.Scope == 5 ? 80 : 240), l.Natural - l.Outer.X + inset);
        int height = Math.Max(l.Bottom, l.Area.Y) - l.Outer.Y + inset;
        var size = Rect.Create(0, 0, width, height);
        if (!PopupSizes.GetOrDefault(l.Id, Rect.Create(0, 0, -1, -1)).Equals(size))
        {
            PopupSizes.Set(l.Id, size);
            Again = true;
        }
        StrokeRoundRect(l.Outer, Radius, Line, Theme.Border);
        Layers.Add(_UiLayer { Id = l.Id, Level = Level, Rect = l.Outer, Modal = l.Scope == 6 });
        if (l.Scope == 5)
        {
            int index = FindPopup(l.Id);
            if (index >= 0)
            {
                var p = Popups.Get(index);
                p.Shown = l.Outer;
                Popups.Set(index, p);
                var layer = Layers.Get(Layers.Count() - 1);
                layer.Owner = p.Owner;
                Layers.Set(Layers.Count() - 1, layer);
            }
        }
        Level = l.SavedLevel;
        Clip = l.SavedClip;
        Last = l.SavedLast;
        LastId = l.SavedLastId;
        LastHot = l.SavedLastHot;
    }

    bool MenuItem(string label, string shortcut)
    {
        uint32 id = IdOf(label);
        string shown = Shown(label);
        int gap = shortcut.Length > 0 ? Px(24) : 0;
        int textWidth = Font.Measure(shown);
        int keysWidth = Font.Measure(shortcut);
        var r = Place(textWidth + gap + keysWidth + 2 * Px(8), ControlHeight, true);
        bool hot = Interact(id, r, true);
        bool clicked = Clicked(id, hot) || Activated(id);
        if (hot)
            FillRoundRect(r, Radius, Theme.Selection);
        if (Focus == id)
            FocusRing(r, Radius);
        DrawTextOf(r.X + Px(8), TextY(r), shown, textWidth, Theme.Text);
        if (shortcut.Length > 0)
            DrawTextOf(r.X + r.Width - Px(8) - keysWidth, TextY(r), shortcut, keysWidth, Theme.TextMuted);
        if (clicked)
            ClosePopupsFrom(0);
        return clicked;
    }

    void BeginMenuBar()
    {
        var slot = Slot();
        FillRect(Rect.Create(slot.X, slot.Y, slot.Width, ControlHeight), Theme.Panel);
        BeginLayout(1, 0);
        Stack[Depth - 1].MenuBar = true;
        Stack[Depth - 1].Id = IdOf("#menubar");
    }

    bool GroupOpen(uint32 group)
    {
        foreach (var p in Popups)
        {
            if (p.Group == group)
                return true;
        }
        return false;
    }

    void BeginMenu(string label)
    {
        uint32 id = IdOf("#menu:" + label);
        uint32 popupId = id ^ 0x9e3779b9u;
        uint32 group = Top().MenuBar ? Seed() : 0u;
        string shown = Shown(label);
        int tw = Font.Measure(shown);
        var r = Place(tw + 2 * Px(10), ControlHeight, false);
        bool hot = Interact(id, r, false);
        bool open = FindPopup(popupId) >= 0;
        if (Skip == 0 && !open)
        {
            // a press opens it; with another menu of the bar open, the mouse moving onto it does
            if ((hot && Active == id && In.MousePressed) || (hot && group != 0u && GroupOpen(group)))
            {
                OpenPopup(popupId, r, id, group);
                open = true;
            }
        }
        if (open || hot)
            FillRoundRect(r, Radius, open ? Theme.Selection : Theme.ControlHover);
        DrawTextOf(r.X + (r.Width - tw) / 2, TextY(r), shown, tw, Theme.Text);
        BeginPopup(popupId);
    }

    bool ComboBox(string name, ref int selected, List<string> items)
    {
        uint32 id = IdOf(name);
        uint32 popupId = IdOf("#combo:" + name);
        int count = items.IsCreated() ? items.Count() : 0;
        int old = selected;
        string shown = selected >= 0 && selected < count ? items.Get(selected) : "";
        int arrow = Px(16);
        var r = Place(Font.Measure(shown) + 2 * Px(10) + arrow, ControlHeight, true);
        bool hot = Interact(id, r, true);
        int index = FindPopup(popupId);
        if (hot)
            WantCursor = Cursor.Hand;
        if (Skip == 0)
        {
            if (index < 0 && ((hot && Active == id && In.MousePressed) || (HasKeys(id) && (In.Pressed(Key.Enter) || In.Pressed(Key.Space)))))
            {
                OpenPopup(popupId, r, id, 0u);
                index = FindPopup(popupId);
                var p = Popups.Get(index);
                p.Highlight = selected;
                Popups.Set(index, p);
            }
            else if (HasKeys(id) && count > 0)
            {
                // the keys: in the open list they move the highlight, else the selection itself
                int at = index >= 0 ? Popups.Get(index).Highlight : selected;
                bool choose = false;
                foreach (var key in In.Keys)
                {
                    if (key == Key.Up)
                        at = Math.Max(0, at - 1);
                    else if (key == Key.Down)
                        at = Math.Min(count - 1, at + 1);
                    else if (key == Key.Home)
                        at = 0;
                    else if (key == Key.End)
                        at = count - 1;
                    else if (key == Key.Enter && index >= 0)
                        choose = true;
                }
                if (index >= 0)
                {
                    var p = Popups.Get(index);
                    p.Highlight = Math.Clamp(at, 0, count - 1);
                    Popups.Set(index, p);
                    if (choose)
                    {
                        selected = p.Highlight;
                        ClosePopupsFrom(index);
                        index = -1;
                    }
                }
                else
                    selected = Math.Clamp(at, 0, count - 1);
            }
        }
        Color fill = hot ? Theme.ControlHover : Theme.Control;
        FillRoundRect(r, Radius, fill);
        StrokeRoundRect(r, Radius, Line, index >= 0 ? Theme.Focus : Theme.Border);
        if (Focus == id)
            FocusRing(r, Radius);
        var saved = Clip;
        SetClip(Rect.Create(r.X, r.Y, Math.Max(0, r.Width - arrow), r.Height).Intersect(saved));
        DrawText(r.X + Px(10), TextY(r), shown, Theme.Text);
        SetClip(saved);
        // the arrow: a small "v", in 1/16 pixels
        int ax = (r.X + r.Width - arrow) * 16 + arrow * 4;
        int ay = (r.Y + r.Height / 2) * 16;
        int aw = Math.Max(20, (24 * ScaleQ + 128) >> 8);
        DrawLine(ax, ay - Px(2) * 16, ax + arrow * 4, ay + Px(2) * 16, aw, Theme.TextMuted);
        DrawLine(ax + arrow * 4, ay + Px(2) * 16, ax + arrow * 8, ay - Px(2) * 16, aw, Theme.TextMuted);
        if (index >= 0 && Skip == 0)
        {
            ComboList(popupId, index, ref selected, items, count);
        }
        return selected != old;
    }

    // the open list of a combo box, in its popup below the box
    void ComboList(uint32 popupId, int index, ref int selected, List<string> items, int count)
    {
        uint32 owner = Popups.Get(index).Owner;
        int highlight = Popups.Get(index).Highlight;
        BeginPopup(popupId);
        int visible = 10;
        bool scrolls = count > visible;
        int pitch = ControlHeight + Spacing;
        if (scrolls)
        {
            // keep the highlighted item in view
            uint32 scrollId = IdOf("#scroll:#list");
            var state = Scrolls.GetOrDefault(scrollId, _UiScroll { });
            int view = visible * pitch;
            if (highlight >= 0 && (highlight * pitch < state.Offset || (highlight + 1) * pitch > state.Offset + view))
            {
                state.Offset = Math.Max(0, highlight * pitch - view / 2);
                Scrolls.Set(scrollId, state);
            }
            BeginScrollPx("#list", 0, view + 2 * Pad - Spacing, false);
        }
        bool chosen = false;
        for (var i = 0; i < count; i += 1)
        {
            BeginId(i.ToString());
            if (ListItem(items.Get(i), i == (highlight >= 0 ? highlight : selected)))
            {
                selected = i;
                chosen = true;
            }
            EndScope();
        }
        if (scrolls)
            EndScope();
        EndScope();
        if (chosen)
        {
            ClosePopupsFrom(FindPopup(popupId) >= 0 ? FindPopup(popupId) : Popups.Count());
            FocusNext = owner;
            FocusSet = true;
        }
    }

    bool IntBox(string name, ref int value, int min, int max)
    {
        uint32 id = IdOf(name);
        int old = value;
        bool editing = IntEditId == id && Focus == id;
        string text = editing ? IntText : value.ToString();
        // only digits and the minus sign get into the box
        string typed = In.Text;
        var sb = StringBuilder.Create();
        for (var i = 0; i < typed.Length; i += 1)
        {
            char c = typed[i];
            if ((c >= '0' && c <= '9') || c == '-')
                sb.Append(c);
        }
        In.Text = sb.ToString();
        int step = 0;
        if (HasKeys(id))
        {
            foreach (var key in In.Keys)
            {
                if (key == Key.Up)
                    step += 1;
                else if (key == Key.Down)
                    step -= 1;
            }
        }
        bool changed = TextBox(name, ref text);
        In.Text = typed;
        if (Focus == id && Skip == 0)
        {
            IntEditId = id;
            if (changed && text.ParseInt() is int parsed)
                value = Math.Clamp(parsed, min, max);
            if (step != 0)
            {
                value = Math.Clamp(value + step, min, max);
                text = value.ToString();
                Caret = text.Length;
                Anchor = Caret;
            }
            if (Submitted(name))
                text = value.ToString();
            IntText = text;
        }
        value = Math.Clamp(value, min, max);
        return value != old;
    }

    // ---- the file dialog ----

    UiDialogResult FileDialog(string name, string title, ref string path)
    {
        uint32 id = IdOf("#file:" + name);
        var d = FileDialogs.GetOrDefault(id, _UiFileDialog { Frame = -10 });
        if (d.Frame < FrameNumber - 1)
        {
            // (again) shown: from the folder of the path
            string folder = Path.GetDirectory(path);
            if (folder.Length == 0 || !Directory.Exists(folder))
                folder = Directory.GetCurrentDirectory();
            d = _UiFileDialog { Folder = folder, FolderText = folder, Name = Path.GetFileName(path), Listed = "", Entries = List<string>.Create() };
        }
        d.Frame = FrameNumber;
        if (d.Listed != d.Folder)
        {
            d.FolderText = d.Folder;
            d.Entries = List<string>.Create();
            var files = List<string>.Create();
            foreach (var entry in Directory.GetEntries(d.Folder))
            {
                if (Directory.Exists(Path.Combine(d.Folder, entry)))
                    d.Entries.Add(entry + "/");
                else
                    files.Add(entry);
            }
            foreach (var file in files)
                d.Entries.Add(file);
            d.Listed = d.Folder;
        }
        var result = UiDialogResult.None;
        BeginModal(name, title);
        BeginLayout(1, 0);
        string folderText = d.FolderText;
        TextBox("folder", ref folderText);
        d.FolderText = folderText;
        if (Submitted("folder") && Directory.Exists(folderText))
            d.Folder = Path.Normalize(folderText);
        if (Button("Up"))
        {
            string up = Path.GetDirectory(Path.GetFullPath(d.Folder));
            if (up.Length > 0)
                d.Folder = up;
        }
        EndScope();
        BeginScrollPx("entries", Px(360), Px(220), false);
        for (var i = 0; i < d.Entries.Count(); i += 1)
        {
            string entry = d.Entries.Get(i);
            BeginId(i.ToString());
            bool folder = entry.EndsWith("/");
            if (ListItem(entry, !folder && entry == d.Name))
            {
                if (folder)
                    d.Folder = Path.Combine(d.Folder, entry.Substring(0, entry.Length - 1));
                else
                    d.Name = entry;
            }
            EndScope();
        }
        EndScope();
        string fileName = d.Name;
        TextBox("name", ref fileName);
        d.Name = fileName;
        bool submit = Submitted("name");
        BeginLayout(1, 0);
        if ((Button("OK") || submit) && d.Name.Length > 0)
        {
            path = Path.Combine(d.Folder, d.Name);
            result = UiDialogResult.Ok;
        }
        if (Button("Cancel") || (Skip == 0 && !KeysBlocked(0u) && In.Pressed(Key.Escape)))
            result = UiDialogResult.Cancel;
        EndScope();
        EndScope();
        if (result != UiDialogResult.None)
            d.Frame = -10; // closed: the next time it starts from the path again
        FileDialogs.Set(id, d);
        return result;
    }

    // ---- tooltips ----

    void Tooltip(string text)
    {
        if (!LastHot || Skip > 0 || LastId == 0u)
            return;
        if (TooltipId != LastId)
        {
            TooltipId = LastId;
            TooltipStart = In.Time;
        }
        double since = In.Time - TooltipStart;
        if (In.Time == 0.0 || In.Steady || since >= 0.5)
            TooltipText = text; // without a clock (a frame without a window) or on a slow window: at once
        else
        {
            int ms = (int)((0.5 - since) * 1000.0) + 1;
            WaitMs = WaitMs < 0 ? ms : Math.Min(WaitMs, ms);
        }
    }

    // at the end of the frame: over everything, next to the mouse
    void DrawTooltip()
    {
        if (TooltipText.Length == 0)
            return;
        Level = MaxLevel + 1;
        SetClip(Bounds);
        int tw = Font.Measure(TooltipText);
        var r = Rect.Create(In.MouseX + Px(12), In.MouseY + Px(18), tw + 2 * Px(6), Font.LineHeight() + 2 * Px(4));
        if (r.X + r.Width > Bounds.Width)
            r.X = Math.Max(0, Bounds.Width - r.Width);
        if (r.Y + r.Height > Bounds.Height)
            r.Y = Math.Max(0, In.MouseY - Px(4) - r.Height);
        FillRoundRect(r, Radius, Theme.Panel);
        StrokeRoundRect(r, Radius, Line, Theme.Border);
        DrawTextOf(r.X + Px(6), r.Y + Px(4), TooltipText, tw, Theme.Text);
        Level = 0;
    }

    void FocusRing(Rect r, int radius)
    {
        if (!FocusVisible)
            return;
        StrokeRoundRect(r.Shrink(-Line - Line), radius + Line + Line, Line + Line, Theme.Focus);
    }

    // the part of a label before "##"
    static string Shown(string label)
    {
        int cut = label.IndexOf("##");
        return cut >= 0 ? label.Substring(0, cut) : label;
    }

    int TextY(Rect r)
    {
        return r.Y + (r.Height - Font.LineHeight()) / 2;
    }

    // ---- widgets ----

    void Label(string text, bool muted)
    {
        int width = Font.Measure(text);
        var r = Place(width, ControlHeight, false);
        DrawTextOf(r.X, TextY(r), text, width, muted ? Theme.TextMuted : Theme.Text);
    }

    void Paragraph(string text)
    {
        var slot = Slot();
        int cw = Font.CharWidth();
        int perLine = Math.Max(1, slot.Width / Math.Max(1, cw));
        var lines = List<string>.Create();
        foreach (var part in text.Split('\n'))
            Wrap(part, perLine, lines);
        int lh = Font.LineHeight() + Px(2);
        int widest = 0;
        foreach (var line in lines)
            widest = Math.Max(widest, Font.Measure(line));
        var r = Place(widest, lines.Count() * lh, false);
        int y = r.Y;
        foreach (var line in lines)
        {
            DrawText(r.X, y + Px(1), line, Theme.Text);
            y += lh;
        }
    }

    // breaks a line at spaces so that no part is longer than perLine characters (a longer word is cut)
    static void Wrap(StringSlice text, int perLine, List<string> lines)
    {
        StringSlice rest = text;
        while (_CountChars(rest) > perLine)
        {
            int cut = ByteOfChar(rest, perLine);
            int space = rest.Substring(0, Math.Min(cut + 1, rest.Length)).LastIndexOf(' ');
            if (space > 0)
            {
                lines.Add(rest.Substring(0, space).ToString());
                rest = rest.Substring(space + 1);
            }
            else
            {
                lines.Add(rest.Substring(0, cut).ToString());
                rest = rest.Substring(cut);
            }
        }
        lines.Add(rest.ToString());
    }

    // the byte index of the character with the given number (the length if there are fewer)
    static int ByteOfChar(StringSlice text, int index)
    {
        int count = 0;
        for (var i = 0; i < text.Length; i += 1)
        {
            if (((int)text[i] & 0xC0) != 0x80)
            {
                if (count == index)
                    return i;
                count += 1;
            }
        }
        return text.Length;
    }

    bool Button(string label)
    {
        uint32 id = IdOf(label);
        string shown = Shown(label);
        var r = Place(Font.Measure(shown) + 2 * Px(14), ControlHeight, false);
        bool hot = Interact(id, r, true);
        bool clicked = Clicked(id, hot) || Activated(id);
        if (hot)
            WantCursor = Cursor.Hand;
        Color fill = Active == id && hot ? Theme.ControlPressed : hot ? Theme.ControlHover : Theme.Control;
        FillRoundRect(r, Radius, fill);
        StrokeRoundRect(r, Radius, Line, Theme.Border);
        if (Focus == id)
            FocusRing(r, Radius);
        int tw = Font.Measure(shown);
        DrawTextOf(r.X + (r.Width - tw) / 2, TextY(r), shown, tw, Theme.Text);
        return clicked;
    }

    bool Checkbox(string label, ref bool value)
    {
        uint32 id = IdOf(label);
        string shown = Shown(label);
        int box = Font.LineHeight() + Px(3);
        int gap = shown.Length > 0 ? Px(8) : 0;
        var r = Place(box + gap + Font.Measure(shown), ControlHeight, false);
        bool hot = Interact(id, r, true);
        bool changed = Clicked(id, hot) || Activated(id);
        if (changed)
            value = !value;
        if (hot)
            WantCursor = Cursor.Hand;
        var b = Rect.Create(r.X, r.Y + (r.Height - box) / 2, box, box);
        if (value)
        {
            FillRoundRect(b, Radius, Theme.Accent);
            // the check mark, in 1/16 pixels: from 25 %, 52 % of the box down to 43 %, 70 % and up to 76 %, 32 %
            int x = b.X * 16;
            int y = b.Y * 16;
            int w = Math.Max(24, (32 * ScaleQ + 128) >> 8); // 2 pixels at the scale, at least 1.5
            DrawLine(x + box * 4, y + box * 832 / 100, x + box * 688 / 100, y + box * 1120 / 100, w, Theme.AccentText);
            DrawLine(x + box * 688 / 100, y + box * 1120 / 100, x + box * 1216 / 100, y + box * 512 / 100, w, Theme.AccentText);
        }
        else
        {
            FillRoundRect(b, Radius, hot ? Theme.ControlHover : Theme.Input);
            StrokeRoundRect(b, Radius, Line, hot ? Theme.TextMuted : Theme.Border);
        }
        if (Focus == id)
            FocusRing(b, Radius);
        DrawText(b.X + box + gap, TextY(r), shown, Theme.Text);
        return changed;
    }

    bool Radio(string label, ref int value, int option)
    {
        uint32 id = IdOf(label);
        string shown = Shown(label);
        int box = Font.LineHeight() + Px(3);
        int gap = shown.Length > 0 ? Px(8) : 0;
        var r = Place(box + gap + Font.Measure(shown), ControlHeight, false);
        bool hot = Interact(id, r, true);
        bool changed = (Clicked(id, hot) || Activated(id)) && value != option;
        if (changed)
            value = option;
        if (hot)
            WantCursor = Cursor.Hand;
        int cx = r.X * 16 + box * 8; // in 1/16 pixels
        int cy = r.Y * 16 + r.Height * 8;
        int radius = box * 8;
        if (value == option)
        {
            FillCircle(cx, cy, radius, Theme.Accent);
            FillCircle(cx, cy, radius * 2 / 5, Theme.AccentText);
        }
        else
        {
            FillCircle(cx, cy, radius, hot ? Theme.TextMuted : Theme.Border);
            FillCircle(cx, cy, radius - Line * 16, hot ? Theme.ControlHover : Theme.Input);
        }
        if (Focus == id)
            FocusRing(Rect.Create(r.X, r.Y + (r.Height - box) / 2, box, box), box / 2);
        DrawText(r.X + box + gap, TextY(r), shown, Theme.Text);
        return changed;
    }

    bool Slider(string name, ref double value, double min, double max, bool whole)
    {
        uint32 id = IdOf(name);
        var r = Place(Px(160), ControlHeight, true);
        bool hot = Interact(id, r, true);
        double range = max - min;
        double old = value;
        int thumb = Px(8);
        int left = r.X + thumb;
        int width = Math.Max(1, r.Width - 2 * thumb);
        if (Active == id && In.MouseDown && range != 0)
            value = min + (double)(In.MouseX - left) / (double)width * range;
        if (HasKeys(id) && range != 0)
        {
            double step = whole ? Math.Max(1.0, Math.Round(range / 100.0)) : range / 100.0;
            foreach (var key in In.Keys)
            {
                if (key == Key.Left || key == Key.Down)
                    value -= step;
                else if (key == Key.Right || key == Key.Up)
                    value += step;
                else if (key == Key.Home)
                    value = min;
                else if (key == Key.End)
                    value = max;
            }
        }
        value = range >= 0 ? Math.Clamp(value, min, max) : Math.Clamp(value, max, min);
        if (whole)
            value = Math.Round(value);
        if (hot)
            WantCursor = Cursor.Hand;
        double t = range != 0 ? (value - min) / range : 0.0;
        int cy = r.Y + r.Height / 2;
        int trackHeight = Math.Max(2, Px(4));
        var track = Rect.Create(left, cy - trackHeight / 2, width, trackHeight);
        FillRoundRect(track, trackHeight / 2, Theme.Border);
        int x = left + (int)(t * (double)width + 0.5);
        FillRoundRect(Rect.Create(left, track.Y, x - left, trackHeight), trackHeight / 2, Theme.Accent);
        int radius = thumb * 16; // in 1/16 pixels
        FillCircle(x * 16, cy * 16, radius, Theme.Border);
        FillCircle(x * 16, cy * 16, radius - Line * 16, Theme.Control);
        FillCircle(x * 16, cy * 16, Active == id ? radius * 9 / 20 : hot ? radius * 3 / 5 : radius / 2, Theme.Accent);
        if (Focus == id)
            FocusRing(Rect.Create(x - thumb, cy - thumb, 2 * thumb, 2 * thumb), thumb);
        return value != old;
    }

    void ProgressBar(double fraction)
    {
        int height = Math.Max(4, Px(6));
        var r = Place(Px(160), ControlHeight, true);
        var track = Rect.Create(r.X, r.Y + (r.Height - height) / 2, r.Width, height);
        FillRoundRect(track, height / 2, Theme.Border);
        int filled = (int)(Math.Clamp(fraction, 0.0, 1.0) * (double)track.Width + 0.5);
        if (filled > 0)
            FillRoundRect(Rect.Create(track.X, track.Y, filled, height), height / 2, Theme.Accent);
    }

    bool ListItem(string label, bool selected)
    {
        uint32 id = IdOf(label);
        string shown = Shown(label);
        var r = Place(Font.Measure(shown) + 2 * Pad, ControlHeight, true);
        bool hot = Interact(id, r, true);
        bool clicked = Clicked(id, hot) || Activated(id);
        if (selected)
            FillRoundRect(r, Radius, Theme.Accent);
        else if (hot)
            FillRoundRect(r, Radius, Theme.Selection);
        if (Focus == id)
            FocusRing(r, Radius);
        DrawText(r.X + Pad, TextY(r), shown, selected ? Theme.AccentText : Theme.Text);
        return clicked;
    }

    void ImageWidget(Image image)
    {
        var r = Place(image.Width, image.Height, false);
        DrawImage(image, r.X, r.Y);
    }

    void Separator()
    {
        var r = Place(0, Spacing, true);
        FillRect(Rect.Create(r.X, r.Y + r.Height / 2, r.Width, Line), Theme.Border);
    }

    void Space(int size)
    {
        int px = Px(size);
        Commit(Top().Kind == 1 ? px : 0, Top().Kind == 1 ? 0 : Math.Max(0, px - Spacing));
    }

    // ---- text boxes ----

    bool Submitted(string name)
    {
        return SubmittedId != 0u && SubmittedId == IdOf(name);
    }

    bool TextBox(string name, ref string text)
    {
        uint32 id = IdOf(name);
        var r = Place(Px(200), ControlHeight, true);
        bool hot = Interact(id, r, true);
        if (hot || Active == id)
            WantCursor = Cursor.Text;
        var inner = Rect.Create(r.X + Px(6), r.Y, Math.Max(0, r.Width - 2 * Px(6)), r.Height);
        int cw = Font.CharWidth();
        string old = text;
        if (Focus == id && EditId != id)
        {
            // the box got the focus: the cursor at the end
            EditId = id;
            Caret = text.Length;
            Anchor = Caret;
            ScrollX = 0;
            BlinkStart = In.Time;
        }
        if (Focus == id)
        {
            Caret = Math.Clamp(Caret, 0, text.Length);
            Anchor = Math.Clamp(Anchor, 0, text.Length);
            if (Active == id && In.MouseDown)
            {
                int column = Math.Max(0, (In.MouseX - inner.X + ScrollX + cw / 2) / Math.Max(1, cw));
                int at = ByteOfChar(text, column);
                Caret = at;
                if (In.MousePressed)
                    Anchor = at;
                BlinkStart = In.Time;
            }
            if (HasKeys(id))
                EditKeys(id, ref text);
        }
        // keep the cursor visible
        if (Focus == id)
        {
            int caretX = _CountChars(text.Substring(0, Caret)) * cw;
            if (caretX - ScrollX > inner.Width - cw)
                ScrollX = caretX - inner.Width + cw;
            if (caretX - ScrollX < 0)
                ScrollX = caretX;
            ScrollX = Math.Max(0, ScrollX);
        }
        int scroll = Focus == id ? ScrollX : 0;
        FillRoundRect(r, Radius, Theme.Input);
        StrokeRoundRect(r, Radius, Line, Focus == id ? Theme.Focus : hot ? Theme.TextMuted : Theme.Border);
        if (Focus == id)
            StrokeRoundRect(r, Radius, Line + Line, Theme.Focus);
        var saved = Clip;
        SetClip(inner.Intersect(saved));
        int ty = TextY(r);
        if (Focus == id && Caret != Anchor)
        {
            int a = _CountChars(text.Substring(0, Math.Min(Caret, Anchor)));
            int b = _CountChars(text.Substring(0, Math.Max(Caret, Anchor)));
            FillRect(Rect.Create(inner.X - scroll + a * cw, ty, (b - a) * cw, Font.LineHeight()), Theme.Selection);
        }
        DrawText(inner.X - scroll, ty, text, Theme.Text);
        if (Focus == id && (In.Time == 0.0 || In.Steady))
        {
            // no clock, or a slow window (no frames to blink): the cursor stays on
            int x = inner.X - scroll + _CountChars(text.Substring(0, Caret)) * cw;
            FillRect(Rect.Create(x, ty - Px(1), Line, Font.LineHeight() + Px(2)), Theme.Text);
        }
        else if (Focus == id)
        {
            double since = In.Time - BlinkStart;
            double phase = since - Math.Floor(since / 1.06) * 1.06;
            if (phase < 0.53)
            {
                int x = inner.X - scroll + _CountChars(text.Substring(0, Caret)) * cw;
                FillRect(Rect.Create(x, ty - Px(1), Line, Font.LineHeight() + Px(2)), Theme.Text);
            }
            int next = (int)((0.53 - (phase < 0.53 ? phase : phase - 0.53)) * 1000.0) + 1;
            WaitMs = WaitMs < 0 ? next : Math.Min(WaitMs, next);
        }
        SetClip(saved);
        return text != old;
    }

    void EditKeys(uint32 id, ref string text)
    {
        for (var ki = 0; ki < In.Keys.Count(); ki += 1)
        {
            var key = In.Keys.Get(ki);
            // the modifier keys held with this press
            var mods = In.ModifiersAt(ki);
            bool ctrl = (mods & KeyModifiers.Ctrl) != KeyModifiers.None;
            bool select = (mods & KeyModifiers.Shift) != KeyModifiers.None;
            switch (key)
            {
            case Key.Left:
                if (Caret != Anchor && !select)
                    Caret = Math.Min(Caret, Anchor);
                else
                    Caret = PrevChar(text, Caret);
                break;
            case Key.Right:
                if (Caret != Anchor && !select)
                    Caret = Math.Max(Caret, Anchor);
                else
                    Caret = NextChar(text, Caret);
                break;
            case Key.Home:
                Caret = 0;
                break;
            case Key.End:
                Caret = text.Length;
                break;
            case Key.Backspace:
                if (Caret == Anchor)
                    Anchor = PrevChar(text, Caret);
                text = Cut(text);
                select = false;
                break;
            case Key.Delete:
                if (Caret == Anchor)
                    Anchor = NextChar(text, Caret);
                text = Cut(text);
                select = false;
                break;
            case Key.A:
                if (ctrl)
                {
                    Anchor = 0;
                    Caret = text.Length;
                    select = true;
                }
                break;
            case Key.C:
            case Key.X:
                if (ctrl && Caret != Anchor)
                {
                    Clipboard.SetText(text.Substring(Math.Min(Caret, Anchor), Math.Abs(Caret - Anchor)));
                    if (key == Key.X)
                    {
                        text = Cut(text);
                        select = false;
                    }
                    else
                        select = true;
                }
                break;
            case Key.V:
                if (ctrl)
                {
                    text = Insert(text, OneLine(Clipboard.GetText()));
                    select = false;
                }
                break;
            case Key.Enter:
                SubmittedId = id;
                break;
            case Key.Escape:
                Focus = 0u;
                break;
            default:
                continue; // other keys leave the text and the selection alone
            }
            if (!select)
                Anchor = Caret;
            BlinkStart = In.Time;
        }
        // with the modifiers of each key (a window's input, UiInput.AddKey) the text has no characters typed with Ctrl;
        // in an input of the old kind, Ctrl drops it
        if (In.Text.Length > 0 && (In.Modifiers.IsCreated() || !In.Ctrl))
        {
            text = Insert(text, OneLine(In.Text));
            Anchor = Caret;
            BlinkStart = In.Time;
        }
    }

    // removes the selection (Caret..Anchor) and puts the cursor there
    string Cut(string text)
    {
        int a = Math.Min(Caret, Anchor);
        int b = Math.Max(Caret, Anchor);
        Caret = a;
        Anchor = a;
        if (a == b)
            return text;
        return text.Substring(0, a) + text.Substring(b);
    }

    // replaces the selection with the inserted text
    string Insert(string text, string inserted)
    {
        string rest = Cut(text);
        string result = rest.Substring(0, Caret) + inserted + rest.Substring(Caret);
        Caret += inserted.Length;
        Anchor = Caret;
        return result;
    }

    // without control characters (a line end becomes a space)
    static string OneLine(string text)
    {
        var sb = StringBuilder.Create();
        for (var i = 0; i < text.Length; i += 1)
        {
            char c = text[i];
            if (c == '\n' || c == '\t')
                sb.Append(' ');
            else if (c >= 32 || (int)c >= 128)
                sb.Append(c);
        }
        return sb.ToString();
    }

    static int PrevChar(StringSlice text, int index)
    {
        int i = Math.Max(0, index - 1);
        while (i > 0 && ((int)text[i] & 0xC0) == 0x80)
            i -= 1;
        return i;
    }

    static int NextChar(StringSlice text, int index)
    {
        int i = Math.Min(text.Length, index + 1);
        while (i < text.Length && ((int)text[i] & 0xC0) == 0x80)
            i += 1;
        return i;
    }
}
