namespace BlackTemple.Common;

/// A linear RGB color with float channels. Values above 1 are allowed (bright lights).
struct Color
{
    float R;
    float G;
    float B;

    static Color Create(float r, float g, float b) { return Color { R = r, G = g, B = b }; }
    static Color Black() { return Color { R = 0, G = 0, B = 0 }; }
    static Color White() { return Color { R = 1, G = 1, B = 1 }; }

    /// Parses "#rrggbb" (the '#' is optional).
    static Optional<Color> Parse(StringSlice text)
    {
        var hex = text.Trim();

        if (hex.StartsWith("#"))
            hex = hex[1..];

        if (hex.Length != 6)
            return null;

        int value = 0;

        for (var i = 0; i < 6; i += 1)
        {
            char c = hex[i];

            if (!Char.IsHexDigit(c))
                return null;

            value = value * 16 + Char.HexValue(c);
        }

        return Color
        {
            R = ((value >> 16) & 255) / 255.0f,
            G = ((value >> 8) & 255) / 255.0f,
            B = (value & 255) / 255.0f
        };
    }

    Color Scale(float factor) { return Color { R = R * factor, G = G * factor, B = B * factor }; }

    static Color Lerp(Color a, Color b, float t)
    {
        return Color { R = MathUtil.Lerp(a.R, b.R, t), G = MathUtil.Lerp(a.G, b.G, t), B = MathUtil.Lerp(a.B, b.B, t) };
    }

    bool IsBlack() { return R <= 0 && G <= 0 && B <= 0; }

    string ToString() { return $"rgb({R}, {G}, {B})"; }
}
