// Loads the OpenGL functions listed in include/glfuncs.h into the global `gl`.
//
// Once a context is current, LoadGl() asks GLFW for each function's address, so the rest of the engine calls
// gl.Clear(...), gl.CreateShader(...), ...

using Glfw from "GLFW/glfw3.h";
using Gl from "glfuncs.h";

Gl.GlFunctions gl;

bool _glLoadOk = true;

void _LoadGlFunction<T>(ref T slot, string name)
{
    unsafe
    {
        void* address = (void*)Glfw.glfwGetProcAddress(name);
        if (address == null)
        {
            Console.WriteErrorLine("OpenGL function not found: " + name);
            _glLoadOk = false;
        }
        slot = (T)address;
    }
}

/// Needs a current OpenGL context. Returns false if a function is missing.
bool LoadGl()
{
    _LoadGlFunction(ref gl.GetString, "glGetString");
    _LoadGlFunction(ref gl.GetError, "glGetError");
    _LoadGlFunction(ref gl.Viewport, "glViewport");
    _LoadGlFunction(ref gl.ClearColor, "glClearColor");
    _LoadGlFunction(ref gl.Clear, "glClear");
    _LoadGlFunction(ref gl.Enable, "glEnable");
    _LoadGlFunction(ref gl.Disable, "glDisable");
    _LoadGlFunction(ref gl.DepthMask, "glDepthMask");
    _LoadGlFunction(ref gl.CullFace, "glCullFace");
    _LoadGlFunction(ref gl.DrawArrays, "glDrawArrays");
    _LoadGlFunction(ref gl.ReadPixels, "glReadPixels");
    _LoadGlFunction(ref gl.PixelStorei, "glPixelStorei");

    _LoadGlFunction(ref gl.CreateShader, "glCreateShader");
    _LoadGlFunction(ref gl.ShaderSource, "glShaderSource");
    _LoadGlFunction(ref gl.CompileShader, "glCompileShader");
    _LoadGlFunction(ref gl.GetShaderiv, "glGetShaderiv");
    _LoadGlFunction(ref gl.GetShaderInfoLog, "glGetShaderInfoLog");
    _LoadGlFunction(ref gl.DeleteShader, "glDeleteShader");
    _LoadGlFunction(ref gl.CreateProgram, "glCreateProgram");
    _LoadGlFunction(ref gl.AttachShader, "glAttachShader");
    _LoadGlFunction(ref gl.LinkProgram, "glLinkProgram");
    _LoadGlFunction(ref gl.GetProgramiv, "glGetProgramiv");
    _LoadGlFunction(ref gl.GetProgramInfoLog, "glGetProgramInfoLog");
    _LoadGlFunction(ref gl.UseProgram, "glUseProgram");
    _LoadGlFunction(ref gl.DeleteProgram, "glDeleteProgram");
    _LoadGlFunction(ref gl.GetUniformLocation, "glGetUniformLocation");
    _LoadGlFunction(ref gl.Uniform1i, "glUniform1i");
    _LoadGlFunction(ref gl.Uniform1f, "glUniform1f");
    _LoadGlFunction(ref gl.Uniform3f, "glUniform3f");
    _LoadGlFunction(ref gl.Uniform1fv, "glUniform1fv");
    _LoadGlFunction(ref gl.Uniform3fv, "glUniform3fv");
    _LoadGlFunction(ref gl.UniformMatrix4fv, "glUniformMatrix4fv");

    _LoadGlFunction(ref gl.GenVertexArrays, "glGenVertexArrays");
    _LoadGlFunction(ref gl.BindVertexArray, "glBindVertexArray");
    _LoadGlFunction(ref gl.DeleteVertexArrays, "glDeleteVertexArrays");
    _LoadGlFunction(ref gl.GenBuffers, "glGenBuffers");
    _LoadGlFunction(ref gl.BindBuffer, "glBindBuffer");
    _LoadGlFunction(ref gl.BufferData, "glBufferData");
    _LoadGlFunction(ref gl.DeleteBuffers, "glDeleteBuffers");
    _LoadGlFunction(ref gl.VertexAttribPointer, "glVertexAttribPointer");
    _LoadGlFunction(ref gl.EnableVertexAttribArray, "glEnableVertexAttribArray");

    _LoadGlFunction(ref gl.GenTextures, "glGenTextures");
    _LoadGlFunction(ref gl.DeleteTextures, "glDeleteTextures");
    _LoadGlFunction(ref gl.BindTexture, "glBindTexture");
    _LoadGlFunction(ref gl.ActiveTexture, "glActiveTexture");
    _LoadGlFunction(ref gl.TexImage3D, "glTexImage3D");
    _LoadGlFunction(ref gl.TexSubImage3D, "glTexSubImage3D");
    _LoadGlFunction(ref gl.TexParameteri, "glTexParameteri");
    _LoadGlFunction(ref gl.GenerateMipmap, "glGenerateMipmap");
    return _glLoadOk;
}

/// glGetString returns a C string (as uint8*); copies it into a string.
string GlString(uint32 name)
{
    unsafe
    {
        uint8* text = gl.GetString(name);
        if (text == null)
            return "?";
        return string.FromCStr((char*)text);
    }
}
