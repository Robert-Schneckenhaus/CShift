// The first person camera. Yaw 0 looks north (-Z), PI/2 east (+X); pitch > 0 looks up.

struct Camera
{
    Vec3 Position;
    float Yaw;
    float Pitch;
    /// Vertical field of view in radians.
    float Fov;

    Vec3 Forward()
    {
        float cp = (float)Math.Cos(Pitch);
        return Vec3.Create((float)Math.Sin(Yaw) * cp, (float)Math.Sin(Pitch), -(float)Math.Cos(Yaw) * cp);
    }

    /// Horizontal right vector (billboards turn around the vertical axis only).
    Vec3 Right() { return Vec3.Create((float)Math.Cos(Yaw), 0, (float)Math.Sin(Yaw)); }

    Vec3 Up() { return Right().Cross(Forward()).Normalized(); }

    Mat4 ViewProjection(float aspect)
    {
        var projection = Mat4.Perspective(Fov, aspect, 0.05f, 200.0f);
        var view = Mat4.LookDirection(Position, Forward(), Vec3.Create(0, 1, 0));
        return projection.Multiply(view);
    }
}
