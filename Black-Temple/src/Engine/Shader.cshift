// Compiling and linking GLSL programs, and setting their uniforms.

using System;
using Gl from "glfuncs.h";

struct ShaderProgram
{
    uint32 Handle;
    Dictionary<string, int> _locations;

    static Error<ShaderProgram> Create(string name, string vertexSource, string fragmentSource)
    {
        uint32 vertex = try _Compile(name + " (vertex)", Gl.GL_VERTEX_SHADER, vertexSource);
        uint32 fragment = try _Compile(name + " (fragment)", Gl.GL_FRAGMENT_SHADER, fragmentSource);
        uint32 program = gl.CreateProgram();
        gl.AttachShader(program, vertex);
        gl.AttachShader(program, fragment);
        gl.LinkProgram(program);
        gl.DeleteShader(vertex);
        gl.DeleteShader(fragment);
        unsafe
        {
            int ok = 0;
            gl.GetProgramiv(program, Gl.GL_LINK_STATUS, &ok);
            if (ok == 0)
            {
                char* log = (char*)Memory.Allocate(4096);
                gl.GetProgramInfoLog(program, 4096, null, log);
                string message = string.FromCStr(log);
                Memory.Free(log);
                gl.DeleteProgram(program);
                return error($"cannot link shader '{name}': {message}");
            }
        }
        return ShaderProgram { Handle = program, _locations = Dictionary<string, int>.Create() };
    }

    static Error<uint32> _Compile(string name, uint32 kind, string source)
    {
        uint32 shader = gl.CreateShader(kind);
        unsafe
        {
            char* text = source.CStr();
            gl.ShaderSource(shader, 1, &text, null);
            gl.CompileShader(shader);
            int ok = 0;
            gl.GetShaderiv(shader, Gl.GL_COMPILE_STATUS, &ok);
            if (ok == 0)
            {
                char* log = (char*)Memory.Allocate(4096);
                gl.GetShaderInfoLog(shader, 4096, null, log);
                string message = string.FromCStr(log);
                Memory.Free(log);
                gl.DeleteShader(shader);
                return error($"cannot compile shader '{name}': {message}");
            }
        }
        return shader;
    }

    void Use() { gl.UseProgram(Handle); }

    int Location(string name)
    {
        if (_locations.TryGet(name) is int cached)
            return cached;
        int location = 0;
        unsafe
        {
            location = gl.GetUniformLocation(Handle, name.CStr());
        }
        _locations[name] = location;
        return location;
    }

    void SetInt(string name, int value) { gl.Uniform1i(Location(name), value); }
    void SetFloat(string name, float value) { gl.Uniform1f(Location(name), value); }
    void SetVec3(string name, Vec3 v) { gl.Uniform3f(Location(name), v.X, v.Y, v.Z); }

    void SetMat4(string name, const ref Mat4 m)
    {
        var copy = m;
        unsafe
        {
            gl.UniformMatrix4fv(Location(name), 1, (uint8)Gl.GL_FALSE, &copy.M[0]);
        }
    }

    void SetVec3Array(string name, float[] values, int count)
    {
        if (count <= 0)
            return;
        unsafe
        {
            gl.Uniform3fv(Location(name), count, &values[0]);
        }
    }

    void SetFloatArray(string name, float[] values, int count)
    {
        if (count <= 0)
            return;
        unsafe
        {
            gl.Uniform1fv(Location(name), count, &values[0]);
        }
    }
}
