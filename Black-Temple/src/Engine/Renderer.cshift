// Draws a map: the sky (outdoors), the static geometry (walls, floors, ceilings) and the billboards, all lit by the
// same fragment shader (src/Shaders/lighting.glsl).

using System;
using Gl from "glfuncs.h";

const string WorldVertexShader = embed("../Shaders/world.vert");
const string BillboardVertexShader = embed("../Shaders/billboard.vert");
const string LightingFragmentShader = embed("../Shaders/lighting.glsl");
const string SkyVertexShader = embed("../Shaders/sky.vert");
const string SkyFragmentShader = embed("../Shaders/sky.frag");

const int MaxLights = 32;
const int WorldVertexFloats = 9;       // position 3, uv 2, layer 1, normal 3
const int BillboardVertexFloats = 9;   // center 3, corner 2, uv 2, layer 1, fullbright 1

/// The lighting and fog of the current frame.
struct Environment
{
    Vec3 Ambient;
    Vec3 FogColor;
    float FogStart;
    float FogEnd;
    Vec3 SunDir;
    Vec3 SunColor;
    bool Outdoor;
    SkyState Sky;
    float Brightness;
    /// Debug switch: fog off.
    bool FogEnabled;
}

struct Renderer
{
    ShaderProgram World;
    ShaderProgram Billboards;
    ShaderProgram Sky;
    TextureArray Textures;
    TextureArray Sprites;

    uint32 _worldVao;
    uint32 _worldVbo;
    int _worldVertexCount;
    uint32 _billboardVao;
    uint32 _billboardVbo;
    uint32 _skyVao;

    float[] _lightPos;
    float[] _lightColor;
    float[] _lightRadius;

    static Error<Renderer> Create(TextureArray textures, TextureArray sprites)
    {
        var r = Renderer {
            World = try ShaderProgram.Create("world", WorldVertexShader, LightingFragmentShader),
            Billboards = try ShaderProgram.Create("billboard", BillboardVertexShader, LightingFragmentShader),
            Sky = try ShaderProgram.Create("sky", SkyVertexShader, SkyFragmentShader),
            Textures = textures,
            Sprites = sprites,
            _lightPos = new float[MaxLights * 3],
            _lightColor = new float[MaxLights * 3],
            _lightRadius = new float[MaxLights]
        };
        uint32 vao = 0;
        uint32 vbo = 0;
        unsafe
        {
            // static geometry
            gl.GenVertexArrays(1, &vao);
            gl.GenBuffers(1, &vbo);
            r._worldVao = vao;
            r._worldVbo = vbo;
            gl.BindVertexArray(vao);
            gl.BindBuffer(Gl.GL_ARRAY_BUFFER, vbo);
            int stride = WorldVertexFloats * sizeof(float);
            _Attribute(0, 3, stride, 0);
            _Attribute(1, 2, stride, 3);
            _Attribute(2, 1, stride, 5);
            _Attribute(3, 3, stride, 6);

            // billboards (rebuilt every frame)
            gl.GenVertexArrays(1, &vao);
            gl.GenBuffers(1, &vbo);
            r._billboardVao = vao;
            r._billboardVbo = vbo;
            gl.BindVertexArray(vao);
            gl.BindBuffer(Gl.GL_ARRAY_BUFFER, vbo);
            stride = BillboardVertexFloats * sizeof(float);
            _Attribute(0, 3, stride, 0);
            _Attribute(1, 2, stride, 3);
            _Attribute(2, 2, stride, 5);
            _Attribute(3, 1, stride, 7);
            _Attribute(4, 1, stride, 8);

            // the sky's full screen triangle needs no buffer, but core profile needs a bound VAO
            gl.GenVertexArrays(1, &vao);
            r._skyVao = vao;
        }
        gl.BindVertexArray(0);
        return r;
    }

    static void _Attribute(uint32 index, int size, int stride, int offsetFloats)
    {
        unsafe
        {
            gl.VertexAttribPointer(index, size, Gl.GL_FLOAT, (uint8)Gl.GL_FALSE, stride, (void*)(offsetFloats * sizeof(float)));
        }
        gl.EnableVertexAttribArray(index);
    }

    /// Builds the static geometry of a map (call once after loading a map).
    void BuildMap(const ref Map map)
    {
        var v = List<float>.Create();
        float h = map.WallHeight;
        float rep = map.WallTextureRepeat;
        for (var y = 0; y < map.Height; y += 1)
        {
            for (var x = 0; x < map.Width; x += 1)
            {
                int index = y * map.Width + x;
                if (map.WallLayer[index] >= 0)
                    continue;
                float fx = x;
                float fz = y;
                int floor = map.FloorLayer[index];
                if (floor >= 0)
                {
                    _Quad(v, floor, Vec3.Create(0, 1, 0), 0, 0, 1, 1,
                        Vec3.Create(fx, 0, fz + 1), Vec3.Create(fx + 1, 0, fz + 1),
                        Vec3.Create(fx + 1, 0, fz), Vec3.Create(fx, 0, fz));
                }
                int ceiling = map.CeilingLayer[index];
                if (ceiling >= 0)
                {
                    _Quad(v, ceiling, Vec3.Create(0, -1, 0), 0, 0, 1, 1,
                        Vec3.Create(fx, h, fz), Vec3.Create(fx + 1, h, fz),
                        Vec3.Create(fx + 1, h, fz + 1), Vec3.Create(fx, h, fz + 1));
                }
                // walls of the neighbors, facing into this tile (bottom left, bottom right, top right, top left as
                // seen from this tile)
                if (map.InBounds(x, y - 1) && map.IsWall(x, y - 1))
                {
                    _Quad(v, map.WallLayer[index - map.Width], Vec3.Create(0, 0, 1), 0, rep, 1, 0,
                        Vec3.Create(fx, 0, fz), Vec3.Create(fx + 1, 0, fz), Vec3.Create(fx + 1, h, fz), Vec3.Create(fx, h, fz));
                }
                if (map.InBounds(x + 1, y) && map.IsWall(x + 1, y))
                {
                    _Quad(v, map.WallLayer[index + 1], Vec3.Create(-1, 0, 0), 0, rep, 1, 0,
                        Vec3.Create(fx + 1, 0, fz), Vec3.Create(fx + 1, 0, fz + 1), Vec3.Create(fx + 1, h, fz + 1), Vec3.Create(fx + 1, h, fz));
                }
                if (map.InBounds(x, y + 1) && map.IsWall(x, y + 1))
                {
                    _Quad(v, map.WallLayer[index + map.Width], Vec3.Create(0, 0, -1), 0, rep, 1, 0,
                        Vec3.Create(fx + 1, 0, fz + 1), Vec3.Create(fx, 0, fz + 1), Vec3.Create(fx, h, fz + 1), Vec3.Create(fx + 1, h, fz + 1));
                }
                if (map.InBounds(x - 1, y) && map.IsWall(x - 1, y))
                {
                    _Quad(v, map.WallLayer[index - 1], Vec3.Create(1, 0, 0), 0, rep, 1, 0,
                        Vec3.Create(fx, 0, fz + 1), Vec3.Create(fx, 0, fz), Vec3.Create(fx, h, fz), Vec3.Create(fx, h, fz + 1));
                }
            }
        }
        var data = v.ToArray();
        _worldVertexCount = data.Length / WorldVertexFloats;
        gl.BindBuffer(Gl.GL_ARRAY_BUFFER, _worldVbo);
        if (data.Length > 0)
        {
            unsafe
            {
                gl.BufferData(Gl.GL_ARRAY_BUFFER, data.Length * sizeof(float), &data[0], Gl.GL_STATIC_DRAW);
            }
        }
    }

    /// Two triangles. Corners: bottom left, bottom right, top right, top left; (u0, v0) at the bottom left,
    /// (u1, v1) at the top right.
    static void _Quad(List<float> v, int layer, Vec3 n, float u0, float v0, float u1, float v1,
        Vec3 bl, Vec3 br, Vec3 tr, Vec3 tl)
    {
        _Vertex(v, bl, u0, v0, layer, n);
        _Vertex(v, br, u1, v0, layer, n);
        _Vertex(v, tr, u1, v1, layer, n);
        _Vertex(v, bl, u0, v0, layer, n);
        _Vertex(v, tr, u1, v1, layer, n);
        _Vertex(v, tl, u0, v1, layer, n);
    }

    static void _Vertex(List<float> v, Vec3 p, float u, float tv, int layer, Vec3 n)
    {
        v.Add(p.X);
        v.Add(p.Y);
        v.Add(p.Z);
        v.Add(u);
        v.Add(tv);
        v.Add(layer);
        v.Add(n.X);
        v.Add(n.Y);
        v.Add(n.Z);
    }

    void Render(const ref Map map, const ref ObjectDatabase db, const ref Camera camera, const ref Environment env,
        int width, int height)
    {
        gl.Viewport(0, 0, width, height);
        Vec3 clear = env.FogColor.Mul(env.Brightness);
        gl.ClearColor(clear.X, clear.Y, clear.Z, 1);
        gl.Clear((uint32)(Gl.GL_COLOR_BUFFER_BIT | Gl.GL_DEPTH_BUFFER_BIT));
        float aspect = (float)width / (float)Math.Max(height, 1);

        if (env.Outdoor)
            _RenderSky(camera, env, aspect);

        gl.Enable(Gl.GL_DEPTH_TEST);
        gl.DepthMask((uint8)Gl.GL_TRUE);
        gl.Disable(Gl.GL_CULL_FACE);
        var viewProj = camera.ViewProjection(aspect);
        int lightCount = _CollectLights(map, camera);

        // walls, floors, ceilings
        World.Use();
        _SetLighting(ref World, camera, env, lightCount);
        World.SetMat4("uViewProj", viewProj);
        World.SetInt("uTexture", 0);
        Textures.Bind(0);
        gl.BindVertexArray(_worldVao);
        gl.DrawArrays(Gl.GL_TRIANGLES, 0, _worldVertexCount);

        // billboards
        var data = _BuildBillboards(map, db);
        if (data.Length > 0)
        {
            Billboards.Use();
            _SetLighting(ref Billboards, camera, env, lightCount);
            Billboards.SetMat4("uViewProj", viewProj);
            Billboards.SetVec3("uCameraRight", camera.Right());
            Billboards.SetInt("uTexture", 0);
            Sprites.Bind(0);
            gl.BindVertexArray(_billboardVao);
            gl.BindBuffer(Gl.GL_ARRAY_BUFFER, _billboardVbo);
            unsafe
            {
                gl.BufferData(Gl.GL_ARRAY_BUFFER, data.Length * sizeof(float), &data[0], Gl.GL_STREAM_DRAW);
            }
            gl.DrawArrays(Gl.GL_TRIANGLES, 0, data.Length / BillboardVertexFloats);
        }
        gl.BindVertexArray(0);
    }

    void _RenderSky(const ref Camera camera, const ref Environment env, float aspect)
    {
        gl.Disable(Gl.GL_DEPTH_TEST);
        gl.DepthMask((uint8)Gl.GL_FALSE);
        Sky.Use();
        Sky.SetVec3("uForward", camera.Forward());
        Sky.SetVec3("uRight", camera.Right());
        Sky.SetVec3("uUp", camera.Up());
        Sky.SetFloat("uTanHalfFov", (float)Math.Tan(camera.Fov / 2));
        Sky.SetFloat("uAspect", aspect);
        Sky.SetVec3("uZenith", env.Sky.Zenith);
        Sky.SetVec3("uHorizon", env.Sky.Horizon);
        Sky.SetVec3("uSunDir", env.SunDir);
        Sky.SetVec3("uSunColor", env.SunColor);
        Sky.SetFloat("uNight", env.Sky.Night);
        Sky.SetFloat("uBrightness", env.Brightness);
        gl.BindVertexArray(_skyVao);
        gl.DrawArrays(Gl.GL_TRIANGLES, 0, 3);
        gl.DepthMask((uint8)Gl.GL_TRUE);
    }

    void _SetLighting(ref ShaderProgram p, const ref Camera camera, const ref Environment env, int lightCount)
    {
        p.SetVec3("uCameraPos", camera.Position);
        p.SetVec3("uAmbient", env.Ambient);
        p.SetFloat("uFaceShade", env.Outdoor ? 0.1f : 0.18f);
        p.SetVec3("uSunDir", env.SunDir);
        p.SetVec3("uSunColor", env.SunColor);
        p.SetVec3("uFogColor", env.FogColor);
        p.SetFloat("uFogStart", env.FogEnabled ? env.FogStart : 1000.0f);
        p.SetFloat("uFogEnd", env.FogEnabled ? env.FogEnd : 1001.0f);
        p.SetFloat("uBrightness", env.Brightness);
        p.SetInt("uLightCount", lightCount);
        p.SetVec3Array("uLightPos", _lightPos, lightCount);
        p.SetVec3Array("uLightColor", _lightColor, lightCount);
        p.SetFloatArray("uLightRadius", _lightRadius, lightCount);
    }

    /// Picks the (up to 32) lights that matter most for the camera: the nearest ones relative to their radius.
    int _CollectLights(const ref Map map, const ref Camera camera)
    {
        int total = map.Lights.Count();
        var order = List<int>.Create();
        var score = new float[total];
        for (var i = 0; i < total; i += 1)
        {
            var light = map.Lights[i];
            score[i] = light.Position.Sub(camera.Position).Length() - light.Radius;
            order.Add(i);
        }
        int count = Math.Min(total, MaxLights);
        // partial selection sort: the `count` best lights first
        for (var i = 0; i < count; i += 1)
        {
            int best = i;
            for (var j = i + 1; j < total; j += 1)
            {
                if (score[order[j]] < score[order[best]])
                    best = j;
            }
            int tmp = order[i];
            order[i] = order[best];
            order[best] = tmp;
            var light = map.Lights[order[i]];
            _lightPos[i * 3] = light.Position.X;
            _lightPos[i * 3 + 1] = light.Position.Y;
            _lightPos[i * 3 + 2] = light.Position.Z;
            _lightColor[i * 3] = light.Color.X;
            _lightColor[i * 3 + 1] = light.Color.Y;
            _lightColor[i * 3 + 2] = light.Color.Z;
            _lightRadius[i] = Math.Max(light.Radius, 0.01f);
        }
        return count;
    }

    float[] _BuildBillboards(const ref Map map, const ref ObjectDatabase db)
    {
        var v = List<float>.Create();
        foreach (var o in map.Objects)
        {
            var def = db.Objects[o.Type];
            int layer = def.SpriteLayers[o.Frame];
            var info = Sprites.Get(layer);
            float half = def.Width / 2;
            float full = def.Fullbright ? 1.0f : 0.0f;
            var center = Vec3.Create(o.X, o.BaseY, o.Z);
            // bottom left, bottom right, top right / bottom left, top right, top left
            _BillboardVertex(v, center, -half, 0, 0, info.UvMaxV, layer, full);
            _BillboardVertex(v, center, half, 0, info.UvMaxU, info.UvMaxV, layer, full);
            _BillboardVertex(v, center, half, def.Height, info.UvMaxU, 0, layer, full);
            _BillboardVertex(v, center, -half, 0, 0, info.UvMaxV, layer, full);
            _BillboardVertex(v, center, half, def.Height, info.UvMaxU, 0, layer, full);
            _BillboardVertex(v, center, -half, def.Height, 0, 0, layer, full);
        }
        return v.ToArray();
    }

    static void _BillboardVertex(List<float> v, Vec3 c, float cx, float cy, float u, float tv, int layer, float full)
    {
        v.Add(c.X);
        v.Add(c.Y);
        v.Add(c.Z);
        v.Add(cx);
        v.Add(cy);
        v.Add(u);
        v.Add(tv);
        v.Add(layer);
        v.Add(full);
    }
}
