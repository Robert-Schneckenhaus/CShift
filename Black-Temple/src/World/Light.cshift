// Point lights. A light can be animated: every animation frame is a light color, an intensity and optionally a radius.
// Lights of objects (torches, braziers...) run in sync with the object's sprite animation: light frame N is shown
// together with sprite frame N.

using System;

struct LightFrame
{
    Vec3 Color;
    float Intensity;
    float Radius;
}

/// The description of a light (objects.json "light" of an object, "lights" presets, or a light in a map).
struct LightDef
{
    LightFrame[] Frames;
    /// Seconds per frame. 0 = take the frame time of the object the light belongs to.
    float FrameTime;
    /// Blend smoothly between the frames instead of switching.
    bool Interpolate;
    /// Extra random flicker of the intensity (0.1 = +-10 %).
    float Flicker;
    /// Height of the light above the object's base (object lights) or above the floor (map lights).
    float OffsetY;

    static LightDef Parse(JsonValue json)
    {
        float radius = JsonFloat(json, "radius", 4.0f);
        var frames = List<LightFrame>.Create();
        var frameList = json["frames"];
        if (frameList.IsArray())
        {
            foreach (var f in frameList.Items())
            {
                frames.Add(LightFrame {
                    Color = JsonColor(f, "color", Vec3.One()),
                    Intensity = JsonFloat(f, "intensity", 1.0f),
                    Radius = JsonFloat(f, "radius", radius)
                });
            }
        }
        if (frames.Count() == 0)
        {
            frames.Add(LightFrame {
                Color = JsonColor(json, "color", Vec3.One()),
                Intensity = JsonFloat(json, "intensity", 1.0f),
                Radius = radius
            });
        }
        return LightDef {
            Frames = frames.ToArray(),
            FrameTime = JsonFloat(json, "frameTime", 0),
            Interpolate = JsonBool(json, "interpolate", true),
            Flicker = JsonFloat(json, "flicker", 0),
            OffsetY = JsonFloat(json, "offsetY", 0.5f)
        };
    }
}

/// A light in a map, with its current (animated) state.
struct Light
{
    LightDef Def;
    Vec3 Position;
    float FrameTime;
    float Phase;
    /// Current color * intensity, and radius.
    Vec3 Color;
    float Radius;
    float _flickerValue;
    float _flickerTarget;

    static Light Create(LightDef def, Vec3 position, float defaultFrameTime, float phase)
    {
        float frameTime = def.FrameTime > 0 ? def.FrameTime : defaultFrameTime;
        if (frameTime <= 0.001f)
            frameTime = 0.15f;
        var light = Light {
            Def = def, Position = position, FrameTime = frameTime, Phase = phase,
            _flickerValue = 1, _flickerTarget = 1
        };
        return light;
    }

    void Update(double time, float deltaTime, ref Random random)
    {
        var frames = Def.Frames;
        double pos = (time + Phase) / FrameTime;
        double whole = Math.Floor(pos);
        int index = (int)(whole % frames.Length);
        if (index < 0)
            index += frames.Length;
        LightFrame a = frames[index];
        Vec3 color = a.Color;
        float intensity = a.Intensity;
        float radius = a.Radius;
        if (Def.Interpolate && frames.Length > 1)
        {
            LightFrame b = frames[(index + 1) % frames.Length];
            float t = Smoothstep01((float)(pos - whole));
            color = Vec3.Lerp(a.Color, b.Color, t);
            intensity = a.Intensity + (b.Intensity - a.Intensity) * t;
            radius = a.Radius + (b.Radius - a.Radius) * t;
        }
        if (Def.Flicker > 0)
        {
            float diff = _flickerTarget - _flickerValue;
            if (diff < 0.01f && diff > -0.01f)
                _flickerTarget = 1.0f + ((float)random.NextDouble() * 2.0f - 1.0f) * Def.Flicker;
            _flickerValue += (_flickerTarget - _flickerValue) * Math.Min(1.0f, deltaTime * 20.0f);
        }
        Color = color.Mul(intensity * _flickerValue);
        Radius = radius;
    }
}
