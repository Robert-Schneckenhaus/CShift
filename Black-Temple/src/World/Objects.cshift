// Object types (Assets/objects.json): billboards with optional animation and an optional light.

using System;

struct ObjectDef
{
    string Name;
    /// Layers in the sprite texture array, one per animation frame.
    int[] SpriteLayers;
    float FrameTime;
    /// Size in the world (1 = one tile). Without "height" in the file, it follows the sprite's aspect ratio.
    float Width;
    float Height;
    /// Height of the billboard's bottom above the floor.
    float BaseY;
    /// Not affected by lighting (flames, glowing crystals).
    bool Fullbright;
    bool Blocking;
    /// Collision radius when blocking.
    float Radius;
    bool HasLight;
    LightDef Light;
}

struct ObjectDatabase
{
    List<ObjectDef> Objects;
    Dictionary<string, int> _byName;
    Dictionary<string, LightDef> LightPresets;

    int Find(StringSlice name)
    {
        if (_byName.TryGet(name.ToString()) is int index)
            return index;
        return -1;
    }

    static Error<ObjectDatabase> Load(string path, const ref TextureArray sprites)
    {
        var doc = try LoadJsonFile(path);
        var db = ObjectDatabase {
            Objects = List<ObjectDef>.Create(),
            _byName = Dictionary<string, int>.Create(),
            LightPresets = Dictionary<string, LightDef>.Create()
        };

        var objects = doc["objects"];
        foreach (var name in objects.Keys())
        {
            var o = objects[name];
            var layers = List<int>.Create();
            foreach (var spriteName in o["sprites"].Items())
            {
                int layer = sprites.Find(spriteName.AsString());
                if (layer < 0)
                    return error($"object '{name}': no sprite 'Assets/Sprites/{spriteName.AsString()}.png'");
                layers.Add(layer);
            }
            if (layers.Count() == 0)
                return error($"object '{name}' has no sprites");

            var first = sprites.Get(layers[0]);
            float width = JsonFloat(o, "width", 0.5f);
            float height = JsonFloat(o, "height", width * first.Height / first.Width);
            var def = ObjectDef {
                Name = name,
                SpriteLayers = layers.ToArray(),
                FrameTime = JsonFloat(o, "frameTime", 0.15f),
                Width = width,
                Height = height,
                BaseY = JsonFloat(o, "baseY", 0),
                Fullbright = JsonBool(o, "fullbright", false),
                Blocking = JsonBool(o, "blocking", false),
                Radius = JsonFloat(o, "radius", 0.25f)
            };
            if (o["light"].IsObject())
            {
                def.HasLight = true;
                def.Light = LightDef.Parse(o["light"]);
            }
            db._byName[name] = db.Objects.Count();
            db.Objects.Add(def);
        }

        var presets = doc["lights"];
        if (presets.IsObject())
        {
            foreach (var name in presets.Keys())
                db.LightPresets[name] = LightDef.Parse(presets[name]);
        }
        return db;
    }
}
