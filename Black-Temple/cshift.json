{
	"name": "black-temple",
	"version": "0.1.0",
	"type": "executable",
	"sources": ["src"],
	"output": "bin/black-temple",
	"optimize": 2,
	"includePaths": ["include"],
	"defines": ["GLFW_INCLUDE_NONE"],
	"libraryPaths": ["lib"],
	"platforms": {
		"windows": { "links": ["glfw3", "opengl32", "gdi32", "user32", "shell32"] },
		"linux": { "links": ["glfw", "GL"] },
		"macos": { "links": ["glfw"] }
	}
}
