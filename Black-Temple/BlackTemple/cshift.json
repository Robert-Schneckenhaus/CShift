{
	"name": "BlackTemple",
	"version": "0.1.0",
	"type": "executable",
	"sources": ["src"],
	"output": "bin/black-temple",
	"optimize": 2,
	"includePaths": ["include"],
	"defines": ["GLFW_INCLUDE_NONE"],
	"libraryPaths": ["lib"],
	"dependencies": ["../BlackTemple.Renderer.OpenGL"],
	"platforms": {
		"windows": { "links": ["glfw3", "gdi32", "user32", "shell32"] },
		"linux": { "links": ["glfw"] },
		"macos": { "links": ["glfw"] }
	}
}
