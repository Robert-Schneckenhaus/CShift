namespace BlackTemple.Renderer.OpenGL;

using System;
using System.Image;
using BlackTemple.Common;
using BlackTemple.Data;
using BlackTemple.Core;
using Gl from "glfuncs.h";

/// The OpenGL 3.3 implementation of IRenderer. Needs a current context with loaded functions (LoadGl).
///
/// A frame: sky (outdoors), the map geometry, then the billboards, all lit by lighting.glsl.
struct GlRenderer : IRenderer
{
    TextureArray Textures;
    TextureArray Sprites;
    MapGeometry Geometry;
    BillboardPass Billboards;
    SkyPass Sky;
    LightSet Lights;
    int ViewportWidth;
    int ViewportHeight;
    int _mapGeneration;

    static Error<GlRenderer> Create(const ref GameData data)
    {
        return GlRenderer
        {
            Textures = TextureArray.Create(data.Textures, TextureArrayMode.Scaled),
            Sprites = TextureArray.Create(data.Sprites, TextureArrayMode.Padded),
            Geometry = try MapGeometry.Create(),
            Billboards = try BillboardPass.Create(),
            Sky = try SkyPass.Create(),
            Lights = LightSet.Create(),
            ViewportWidth = 1,
            ViewportHeight = 1
        };
    }

    void SetViewport(int width, int height)
    {
        ViewportWidth = Math.Max(width, 1);
        ViewportHeight = Math.Max(height, 1);
    }

    void Render(const ref RenderFrame frame)
    {
        if (frame.MapGeneration != _mapGeneration)
        {
            Geometry.Build(frame.Map.Data);
            _mapGeneration = frame.MapGeneration;
        }

        var lighting = frame.Lighting;
        var clear = lighting.FogColor.Scale(lighting.Brightness);
        gl.Viewport(0, 0, ViewportWidth, ViewportHeight);
        gl.ClearColor(clear.R, clear.G, clear.B, 1);
        gl.Clear((uint32)(Gl.GL_COLOR_BUFFER_BIT | Gl.GL_DEPTH_BUFFER_BIT));
        float aspect = (float)ViewportWidth / (float)ViewportHeight;

        if (lighting.HasSky)
            Sky.Draw(frame, aspect);

        gl.Enable(Gl.GL_DEPTH_TEST);
        gl.DepthMask((uint8)Gl.GL_TRUE);
        gl.Disable(Gl.GL_CULL_FACE);
        var viewProjection = frame.Camera.ViewProjection(aspect);
        Lights.Collect(frame.Map, frame.Camera.Position);
        Geometry.Draw(frame, ref Lights, viewProjection, ref Textures);
        Billboards.Draw(frame, ref Lights, viewProjection, ref Sprites);
        gl.BindVertexArray(0);
    }

    /// The rendered image (read from the back buffer, before it is shown).
    Image Capture()
    {
        int width = ViewportWidth;
        int height = ViewportHeight;
        var pixels = new uint32[width * height];
        gl.PixelStorei(Gl.GL_PACK_ALIGNMENT, 4);

        unsafe
        {
            gl.ReadPixels(0, 0, width, height, Gl.GL_BGRA, Gl.GL_UNSIGNED_BYTE, &pixels[0]);
        }

        var image = Image.Create(width, height);

        for (var y = 0; y < height; y += 1)
        {
            int source = (height - 1 - y) * width;   // OpenGL's rows start at the bottom

            for (var x = 0; x < width; x += 1)
                image.Pixels[y * width + x] = pixels[source + x] | 0xFF000000;
        }

        return image;
    }
}
