// Register allocation of the 68000 backend (linear scan): the scalar values of a function (up to 32 bits: its
// parameters as well, which the prologue then loads from their slots) and its scalar variables (allocas whose address
// is only loaded from and stored to) get the registers d4-d7 and a2-a5 (d2 and d3 too where the code of the function
// does not need them) for their whole lifetime, if they fit; the others stay in their stack slots. Apart from the values
// split in step 4, a value lives in a register or in its slot everywhere.
//
//   1. Liveness: a data flow analysis over the blocks (a load of a variable uses it, a store defines it; the arguments
//      of a phi are used at the end of the predecessor).
//   2. Intervals: the blocks in their order, every instruction numbered; a value's interval has a part in each block
//      where it lives, from its first to its last point there (holes in between: other values can use the register).
//   3. Linear scan in the order of the interval starts: a free register (no value there overlaps the new one) of the
//      preferred kind (address registers for pointers), else the one whose overlapping values are worth least
//      together, if the new one is worth more. The worth: the uses and definitions, weighted by the loop nesting (8
//      per level).
//   4. A value without a register may still get one outside the blocks that it only lives through (SplitValues): there
//      it is in its slot, and it is loaded again on the ways out of them.

namespace CShift.M68k;

using System;

// A value in a register but in some blocks, where it only lives on (it is neither computed nor used there) and the
// register holds other values: it is written to its slot as well where it is computed, and loaded into the register
// again on the ways out of such blocks: at the end of one that only goes on to one block (without phis), else at the
// start of the block it enters.
struct SplitHome
{
    string Name;
    string Reg;
    HashSet<string> InSlot;       // the blocks where it is in its slot
    HashSet<string> Reload;       // the blocks that load it at their start
    HashSet<string> ReloadAtEnd;  // the blocks that load it before their branch
}

struct LiveInterval
{
    string Name;
    int Start;
    int End;
    int Weight;
    bool Pointer;
}

void AllocateRegisters(Gen g, IrFunc f)
{
    g.Home.Clear();
    g.Saved.Clear();
    g.Splits.Clear();
    g.Saved.Add("%d2-%d3");
    var blocks = f.Blocks.ToArray();
    int n = blocks.Length;
    var index = Dictionary<string, int>.Create();
    for (var i = 0; i < n; i += 1)
        index.Set(blocks[i].Label, i);

    // ---- the candidates ----
    var allocaSize = Dictionary<string, int>.Create();
    var isPointer = Dictionary<string, bool>.Create();
    var excluded = HashSet<string>.Create();
    foreach (var p in f.Params)
    {
        if (IsScalar4(g, p.Type))
            isPointer.Set(p.Name, g.T.Kind(p.Type) == IrKind.Ptr);
        else
            excluded.Add(p.Name);
    }
    foreach (var b in blocks)
    {
        foreach (var inst in b.Insts.ToArray())
        {
            if (inst.Op == "alloca")
            {
                if (IsScalar4(g, inst.OpType) && (inst.Args.Length == 0 || !IsLocal(g, inst.Args[0])))
                {
                    allocaSize.Set(inst.Res, g.L.Size(inst.OpType));
                    isPointer.Set(inst.Res, g.T.Kind(inst.OpType) == IrKind.Ptr);
                }
                else
                    excluded.Add(inst.Res);
            }
            else if (inst.Res.Length > 0)
            {
                if (IsScalar4(g, inst.Type) && !g.Skip.Contains(inst.Res))
                    isPointer.Set(inst.Res, g.T.Kind(inst.Type) == IrKind.Ptr);
                else
                    excluded.Add(inst.Res);
            }
        }
    }
    // a variable whose address is used otherwise stays in memory
    foreach (var b in blocks)
    {
        foreach (var inst in b.Insts.ToArray())
        {
            for (var a = 0; a < inst.Args.Length; a += 1)
            {
                var v = g.M.Vals.Get(inst.Args[a]);
                if (v.Kind != ValKind.Local)
                    continue;
                var size = allocaSize.TryGet(v.Name);
                if (size is int s)
                {
                    bool plain = (inst.Op == "load" && a == 0 && g.L.Size(inst.Type) == s && IsScalar4(g, inst.Type)) ||
                                 (inst.Op == "store" && a == 1 && g.L.Size(inst.OpType) == s && IsScalar4(g, inst.OpType));
                    if (!plain)
                        excluded.Add(v.Name);
                }
            }
        }
    }
    // values that only the next instruction uses: they stay in d0 (no register, no slot)
    var forwarded = ForwardedValues(g, f);
    foreach (var name in forwarded)
        excluded.Add(name);

    // ---- loop nesting (for the weights): the loops of the branches back to a block that dominates them ----
    var depth = new int[n];
    var succs = new List<int>[n];
    for (var j = 0; j < n; j += 1)
    {
        succs[j] = List<int>.Create();
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            if (inst.Op != "br" && inst.Op != "switch")
                continue;
            foreach (var label in inst.Labels)
            {
                var target = index.TryGet(label);
                if (target is int i)
                {
                    if (!succs[j].Contains(i))
                        succs[j].Add(i);
                }
            }
        }
    }

    // (the blocks of the loop of each branch back: the ones that reach it without passing its target; a block that
    // leaves the loop, a panic or a return, is not in it, and its uses do not count as uses in the loop)
    var preds = new List<int>[n];
    for (var j = 0; j < n; j += 1)
        preds[j] = List<int>.Create();
    for (var j = 0; j < n; j += 1)
    {
        foreach (var t in succs[j].ToArray())
            preds[t].Add(j);
    }
    var idom = Dominators(f);
    for (var head = 0; head < n; head += 1)
    {
        // (all branches back to the same block, from blocks that it dominates: one loop)
        var inLoop = new bool[n];
        var work = List<int>.Create();
        bool loops = false;
        foreach (var j in preds[head].ToArray())
        {
            if (!Dominates(idom, head, j))
                continue;
            loops = true;
            if (j != head && !inLoop[j])
            {
                inLoop[j] = true;
                work.Add(j); // (a block that branches back to itself is a loop of its own: nothing before it is in it)
            }
        }
        if (!loops)
            continue;
        inLoop[head] = true;
        while (work.Count() > 0)
        {
            int b = work.Get(work.Count() - 1);
            work.RemoveAt(work.Count() - 1);
            foreach (var p in preds[b].ToArray())
            {
                if (!inLoop[p])
                {
                    inLoop[p] = true;
                    work.Add(p);
                }
            }
        }
        for (var k = 0; k < n; k += 1)
        {
            if (inLoop[k])
                depth[k] += 1;
        }
    }

    // ---- positions, uses and definitions per block ----
    var blockStart = new int[n];
    var blockEnd = new int[n];
    var gen = new HashSet<string>[n];
    var kill = new HashSet<string>[n];
    var phiDefs = new HashSet<string>[n];
    var phiUses = new List<string>[n];   // values that phis of other blocks take from this block (used at its end)
    var weight = Dictionary<string, int>.Create();
    var uses = Dictionary<string, int>.Create();
    var defPos = Dictionary<string, int>.Create();
    var defBlock = Dictionary<string, int>.Create();
    var loads = List<IrInst>.Create();          // loads of variables, with their positions
    var loadPos = List<int>.Create();
    var stores = List<IrInst>.Create();
    var storePos = List<int>.Create();
    var storeBlock = List<int>.Create();
    var lo = Dictionary<string, int>.Create();
    var hi = Dictionary<string, int>.Create();
    var touchName = List<string>.Create();      // every point of every value (for the parts of its interval)
    var touchPos = List<int>.Create();
    var lastUse = Dictionary<string, int>.Create();   // "block|value" -> the last position in the block that uses it
    var phiEnds = List<string>.Create();        // phi results and their predecessors: the predecessor writes the
    var phiFrom = List<int>.Create();           // result's register before its branch (and its compare)
    int pos = 0;
    for (var j = 0; j < n; j += 1)
    {
        gen[j] = HashSet<string>.Create();
        kill[j] = HashSet<string>.Create();
        phiDefs[j] = HashSet<string>.Create();
        phiUses[j] = List<string>.Create();
    }
    for (var j = 0; j < n; j += 1)
    {
        int d = depth[j] > 3 ? 3 : depth[j];
        int w = d == 0 ? 1 : (d == 1 ? 8 : (d == 2 ? 64 : 512));
        blockStart[j] = pos;
        pos += 1;
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            pos += 1;
            if (inst.Res.Length > 0 && g.Skip.Contains(inst.Res))
                continue; // folded: its operands are used where it is used
            // a folded access uses the base and the index of its address
            if (inst.Op == "load" || inst.Op == "store")
            {
                var ptr = g.M.Vals.Get(inst.Args[inst.Op == "load" ? 0 : 1]);
                var fold = ptr.Kind == ValKind.Local ? g.Folds.TryGet(ptr.Name) : null;
                if (fold is AddrFold af)
                {
                    int[] parts = [af.Base, af.Index];
                    foreach (var pv in parts)
                    {
                        if (pv < 0)
                            continue;
                        var v = g.M.Vals.Get(pv);
                        if (v.Kind != ValKind.Local || !IsCandidate(v.Name, isPointer, excluded))
                            continue;
                        uses.Set(v.Name, uses.GetOrDefault(v.Name, 0) + 1);
                        if (!kill[j].Contains(v.Name))
                            gen[j].Add(v.Name);
                        Touch(v.Name, pos, w, weight, lo, hi, touchName, touchPos);
                        lastUse.Set(j.ToString() + "|" + v.Name, pos);
                    }
                }
            }
            if (inst.Op == "phi")
            {
                if (IsCandidate(inst.Res, isPointer, excluded))
                {
                    phiDefs[j].Add(inst.Res);
                    kill[j].Add(inst.Res);
                    Touch(inst.Res, blockStart[j], w, weight, lo, hi, touchName, touchPos);
                }
                for (var a = 0; a < inst.Args.Length; a += 1)
                {
                    var v = g.M.Vals.Get(inst.Args[a]);
                    if (v.Kind == ValKind.Local)
                        uses.Set(v.Name, uses.GetOrDefault(v.Name, 0) + 1);
                    var from = index.TryGet(inst.Labels[a]);
                    if (v.Kind == ValKind.Local && IsCandidate(v.Name, isPointer, excluded) && from is int pj)
                        phiUses[pj].Add(v.Name);
                    if (from is int pk && IsCandidate(inst.Res, isPointer, excluded))
                    {
                        phiEnds.Add(inst.Res);
                        phiFrom.Add(pk);
                    }
                }
                continue;
            }
            // uses first (a store's value; a load's variable), then the definition
            if (inst.Op == "load" && IsLocal(g, inst.Args[0]) && allocaSize.ContainsKey(g.M.Vals.Get(inst.Args[0]).Name))
            {
                loads.Add(inst);
                loadPos.Add(pos);
            }
            if (inst.Op == "store" && IsLocal(g, inst.Args[1]) && allocaSize.ContainsKey(g.M.Vals.Get(inst.Args[1]).Name))
            {
                stores.Add(inst);
                storePos.Add(pos);
                storeBlock.Add(j);
            }
            for (var a = 0; a < inst.Args.Length; a += 1)
            {
                var v = g.M.Vals.Get(inst.Args[a]);
                if (v.Kind == ValKind.Local)
                    uses.Set(v.Name, uses.GetOrDefault(v.Name, 0) + 1);
                if (v.Kind != ValKind.Local || !IsCandidate(v.Name, isPointer, excluded))
                    continue;
                if (inst.Op == "store" && a == 1 && allocaSize.ContainsKey(v.Name))
                    continue; // the variable is written, not read
                if (!kill[j].Contains(v.Name))
                    gen[j].Add(v.Name);
                Touch(v.Name, pos, w, weight, lo, hi, touchName, touchPos);
                lastUse.Set(j.ToString() + "|" + v.Name, pos);
            }
            if (inst.Op == "store" && inst.Args.Length > 1)
            {
                var target = g.M.Vals.Get(inst.Args[1]);
                if (target.Kind == ValKind.Local && allocaSize.ContainsKey(target.Name) && IsCandidate(target.Name, isPointer, excluded))
                {
                    kill[j].Add(target.Name);
                    Touch(target.Name, pos, w, weight, lo, hi, touchName, touchPos);
                }
            }
            // the called value of an indirect call is used here as well
            if (inst.Callee >= 0)
            {
                var cv = g.M.Vals.Get(inst.Callee);
                if (cv.Kind == ValKind.Local && IsCandidate(cv.Name, isPointer, excluded))
                {
                    uses.Set(cv.Name, uses.GetOrDefault(cv.Name, 0) + 1);
                    if (!kill[j].Contains(cv.Name))
                        gen[j].Add(cv.Name);
                    Touch(cv.Name, pos, w, weight, lo, hi, touchName, touchPos);
                    lastUse.Set(j.ToString() + "|" + cv.Name, pos);
                }
            }
            if (inst.Res.Length > 0 && inst.Op != "alloca" && IsCandidate(inst.Res, isPointer, excluded))
            {
                defPos.Set(inst.Res, pos);
                defBlock.Set(inst.Res, j);
                kill[j].Add(inst.Res);
                Touch(inst.Res, pos, w, weight, lo, hi, touchName, touchPos);
            }
        }
        pos += 1;
        blockEnd[j] = pos;
        pos += 1;
        foreach (var u in phiUses[j].ToArray())
            Touch(u, blockEnd[j], w, weight, lo, hi, touchName, touchPos);
    }

    // a comparison that only decides the branch after it and the flag of a checked add before its branch are flags in
    // the code (Gen.cshift: GenCompareBranch, GenOverflowBranch): no register for them
    foreach (var b in blocks)
    {
        var insts = b.Insts.ToArray();
        for (var k = 0; k < insts.Length; k += 1)
        {
            var inst = insts[k];
            if (inst.Op == "icmp" && k + 1 < insts.Length && insts[k + 1].Op == "br" && insts[k + 1].Labels.Length == 2 &&
                IsLocal(g, insts[k + 1].Args[0]) && g.M.Vals.Get(insts[k + 1].Args[0]).Name == inst.Res &&
                uses.GetOrDefault(inst.Res, 0) == 1 && g.T.Bits(inst.OpType) != 64)
                weight.Set(inst.Res, 0);
            else if (k + 3 < insts.Length && IsFusableOverflow(g, insts, k, uses))
                weight.Set(g.M.Vals.Get(insts[k + 3].Args[0]).Name, 0);
        }
    }

    // a parameter has its value from the start
    foreach (var p in f.Params)
    {
        if (IsCandidate(p.Name, isPointer, excluded))
            Touch(p.Name, 0, 0, weight, lo, hi, touchName, touchPos);
    }
    for (var i = 0; i < phiEnds.Count(); i += 1)
    {
        int end = blockEnd[phiFrom.Get(i)];
        Touch(phiEnds.Get(i), end - 2, 0, weight, lo, hi, touchName, touchPos);
        Touch(phiEnds.Get(i), end - 1, 0, weight, lo, hi, touchName, touchPos);
    }

    // ---- liveness: live-in = gen + (live-out - kill); live-out = the live-ins of the successors (without their
    //      phis) + the phi arguments from this block ----
    var liveIn = new HashSet<string>[n];
    var liveOut = new HashSet<string>[n];
    for (var j = 0; j < n; j += 1)
    {
        liveIn[j] = HashSet<string>.Create();
        liveOut[j] = HashSet<string>.Create();
    }
    bool changed = true;
    while (changed)
    {
        changed = false;
        for (var j = n - 1; j >= 0; j -= 1)
        {
            foreach (var s in succs[j].ToArray())
            {
                foreach (var v in liveIn[s].ToArray())
                {
                    if (!phiDefs[s].Contains(v) && !liveOut[j].Contains(v))
                    {
                        liveOut[j].Add(v);
                        changed = true;
                    }
                }
            }
            foreach (var v in phiUses[j].ToArray())
            {
                if (!liveOut[j].Contains(v))
                {
                    liveOut[j].Add(v);
                    changed = true;
                }
            }
            foreach (var v in gen[j].ToArray())
            {
                if (!liveIn[j].Contains(v))
                {
                    liveIn[j].Add(v);
                    changed = true;
                }
            }
            foreach (var v in liveOut[j].ToArray())
            {
                if (!kill[j].Contains(v) && !liveIn[j].Contains(v))
                {
                    liveIn[j].Add(v);
                    changed = true;
                }
            }
        }
    }
    for (var j = 0; j < n; j += 1)
    {
        foreach (var v in liveIn[j].ToArray())
            Touch(v, blockStart[j], 0, weight, lo, hi, touchName, touchPos);
        foreach (var v in liveOut[j].ToArray())
            Touch(v, blockEnd[j], 0, weight, lo, hi, touchName, touchPos);
    }

    // ---- values that share their variable's register ----
    var nonLocal = HashSet<string>.Create();
    for (var j = 0; j < n; j += 1)
    {
        foreach (var v in liveIn[j].ToArray())
            nonLocal.Add(v);
        foreach (var v in liveOut[j].ToArray())
            nonLocal.Add(v);
    }
    var aliasOf = Dictionary<string, string>.Create();
    var aliasEnd = Dictionary<string, int>.Create();   // the last use of a load that shares its variable's register
    // a load whose value is used in its block before the variable is written again: the variable's register
    for (var i = 0; i < loads.Count(); i += 1)
    {
        var ld = loads.Get(i);
        string t = ld.Res;
        string variable = g.M.Vals.Get(ld.Args[0]).Name;
        if (!IsCandidate(t, isPointer, excluded) || !IsCandidate(variable, isPointer, excluded) || !hi.ContainsKey(t))
            continue;
        int from = loadPos.Get(i);
        int until = hi.Get(t);
        int home = BlockAt(blockStart, from);
        // the variable must keep its value while the loaded value lives: no store after the load in its block (up to the
        // last use there, or to the end if it lives on), none in any other block where it lives
        bool written = false;
        for (var k = 0; k < stores.Count() && !written; k += 1)
        {
            if (g.M.Vals.Get(stores.Get(k).Args[1]).Name != variable)
                continue;
            int sp = storePos.Get(k);
            int sb = storeBlock.Get(k);
            if (sb == home)
            {
                if (sp > from && (sp <= until || liveOut[home].Contains(t)))
                    written = true;
            }
            else if (liveOut[sb].Contains(t) || phiUses[sb].Contains(t) ||
                     (liveIn[sb].Contains(t) && sp <= lastUse.GetOrDefault(sb.ToString() + "|" + t, 2147483647)))
                written = true; // (a store after the last use in a block where the value ends is no conflict)
        }
        // (a loaded value that lives into a loop that also contains the load: not shared)
        if (!written && liveIn[home].Contains(t))
            written = true;
        if (written)
            continue;
        Touch(variable, lo.Get(t), 0, weight, lo, hi, touchName, touchPos);
        Touch(variable, until, 0, weight, lo, hi, touchName, touchPos);
        weight.Set(variable, weight.GetOrDefault(variable, 0) + weight.GetOrDefault(t, 0));
        aliasOf.Set(t, variable);
        aliasEnd.Set(t, until);
        lo.Remove(t);
        hi.Remove(t);
    }
    // a value that is stored into a variable, which is not read in between: computed in the variable's register (other
    // uses of the value in its block are fine while the variable is not written again: 'from = dst - x; if (from < s)')
    for (var k = 0; k < stores.Count(); k += 1)
    {
        var st = stores.Get(k);
        var val = g.M.Vals.Get(st.Args[0]);
        string variable = g.M.Vals.Get(st.Args[1]).Name;
        if (val.Kind != ValKind.Local || !IsCandidate(val.Name, isPointer, excluded) || !IsCandidate(variable, isPointer, excluded))
            continue;
        string x = val.Name;
        if (aliasOf.ContainsKey(x) || nonLocal.Contains(x) || !defPos.ContainsKey(x) ||
            defBlock.Get(x) != storeBlock.Get(k) || !lo.ContainsKey(x))
            continue;
        int d = defPos.Get(x);
        int sp = storePos.Get(k);
        bool read = false;
        if (uses.GetOrDefault(x, 0) != 1)
        {
            // (its uses before its last one: no other store of the variable from the definition on)
            int last = hi.Get(x);
            for (var i = 0; i < stores.Count() && !read; i += 1)
            {
                int op = storePos.Get(i);
                if (i != k && op > d && op <= last && g.M.Vals.Get(stores.Get(i).Args[1]).Name == variable)
                    read = true;
            }
            if (last < sp)
                read = true;
        }
        for (var i = 0; i < loads.Count() && !read; i += 1)
        {
            int lp = loadPos.Get(i);
            var ld = loads.Get(i);
            if (g.M.Vals.Get(ld.Args[0]).Name != variable)
                continue;
            // a load in between, or an earlier load whose shared value is still used after the definition
            if (lp > d && lp < sp)
                read = true;
            var ali = aliasOf.TryGet(ld.Res);
            if (ali is string av && av == variable && lp <= d)
            {
                if (aliasEnd.GetOrDefault(ld.Res, 0) > d)
                    read = true;
            }
        }
        for (var i = 0; i < stores.Count() && !read; i += 1)
        {
            int op = storePos.Get(i);
            if (op > d && op < sp && g.M.Vals.Get(stores.Get(i).Args[1]).Name == variable)
                read = true;
        }
        if (read)
            continue;
        Touch(variable, d, 0, weight, lo, hi, touchName, touchPos);
        weight.Set(variable, weight.GetOrDefault(variable, 0) + weight.GetOrDefault(x, 0));
        aliasOf.Set(x, variable);
        lo.Remove(x);
        hi.Remove(x);
    }

    // ---- linear scan ----
    var intervals = List<LiveInterval>.Create();
    foreach (var entry in lo.Entries())
    {
        string name = entry.Key;
        intervals.Add(LiveInterval { Name = name, Start = entry.Value, End = hi.Get(name), Weight = weight.GetOrDefault(name, 0),
                                     Pointer = isPointer.GetOrDefault(name, false) });
    }
    var sorted = intervals.ToArray();
    for (var i = 1; i < sorted.Length; i += 1)
    {
        var x = sorted[i];
        int k = i - 1;
        while (k >= 0 && (sorted[k].Start > x.Start || (sorted[k].Start == x.Start && sorted[k].Name.CompareTo(x.Name) > 0)))
        {
            sorted[k + 1] = sorted[k];
            k -= 1;
        }
        sorted[k + 1] = x;
    }
    // the parts of each interval: per block from its first to its last point there (a value that only lives in some
    // blocks between its start and its end leaves the register to others in the rest)
    var slot = Dictionary<string, int>.Create();
    for (var i = 0; i < sorted.Length; i += 1)
        slot.Set(sorted[i].Name, i);
    var segBlock = new List<int>[sorted.Length];
    var segStart = new List<int>[sorted.Length];
    var segEnd = new List<int>[sorted.Length];
    for (var i = 0; i < sorted.Length; i += 1)
    {
        segBlock[i] = List<int>.Create();
        segStart[i] = List<int>.Create();
        segEnd[i] = List<int>.Create();
    }
    for (var t = 0; t < touchName.Count(); t += 1)
    {
        string name = touchName.Get(t);
        var ali = aliasOf.TryGet(name);
        if (ali is string variable)
            name = variable; // (a value in its variable's register: its points are the variable's)
        if (!slot.ContainsKey(name))
            continue;
        int k = slot.Get(name);
        int at = touchPos.Get(t);
        int b = BlockAt(blockStart, at);
        int s = segBlock[k].IndexOf(b);
        if (s < 0)
        {
            segBlock[k].Add(b);
            segStart[k].Add(at);
            segEnd[k].Add(at);
        }
        else if (at < segStart[k].Get(s))
            segStart[k].Set(s, at);
        else if (at > segEnd[k].Get(s))
            segEnd[k].Set(s, at);
    }
    var parts = new int[sorted.Length][];   // start, end, start, end, ... in order
    for (var i = 0; i < sorted.Length; i += 1)
    {
        int count = segStart[i].Count();
        var p = new int[count * 2];
        for (var s = 0; s < count; s += 1)
        {
            int a = segStart[i].Get(s);
            int e = segEnd[i].Get(s);
            int k = s - 1;
            while (k >= 0 && p[k * 2] > a)
            {
                p[k * 2 + 2] = p[k * 2];
                p[k * 2 + 3] = p[k * 2 + 1];
                k -= 1;
            }
            p[k * 2 + 2] = a;
            p[k * 2 + 3] = e;
        }
        parts[i] = p;
    }

    // d2 and d3 too where no instruction of the function needs them for its own code (Gen.cshift: 64-bit values,
    // products, remainders)
    bool d23 = !NeedsD2D3(g, f);
    string[] regs = ["%d4", "%d5", "%d6", "%d7", "%a2", "%a3", "%a4", "%a5"];
    if (d23)
        regs = ["%d4", "%d5", "%d6", "%d7", "%d2", "%d3", "%a2", "%a3", "%a4", "%a5"];
    int nData = d23 ? 6 : 4;
    int nRegs = regs.Length;
    var byRegister = new List<int>[nRegs];   // the intervals in each register
    var used = new bool[nRegs];
    for (var r = 0; r < nRegs; r += 1)
        byRegister[r] = List<int>.Create();
    var assigned = new int[sorted.Length];
    for (var i = 0; i < sorted.Length; i += 1)
    {
        assigned[i] = -1;
        var cur = sorted[i];
        if (cur.Weight < 2)
            continue; // not worth a register
        // a free register (no value there overlaps this one): of the preferred kind first
        int pick = -1;
        for (var pass = 0; pass < 2 && pick < 0; pass += 1)
        {
            bool address = cur.Pointer == (pass == 0);
            for (var r = address ? nData : 0; r < (address ? nRegs : nData) && pick < 0; r += 1)
            {
                if (Conflicts(parts, byRegister[r], i, -1) == 0)
                    pick = r;
            }
        }
        if (pick < 0)
        {
            // the register whose overlapping values are worth least gives them up, if the new one is worth more
            int best = -1;
            int bestWorth = 0;
            for (var r = 0; r < nRegs; r += 1)
            {
                int w = 0;
                foreach (var k in byRegister[r].ToArray())
                {
                    if (Overlap(parts[k], parts[i]))
                        w += Worth(sorted[k]);
                }
                if (best < 0 || w < bestWorth)
                {
                    best = r;
                    bestWorth = w;
                }
            }
            if (best >= 0 && bestWorth < Worth(cur))
            {
                foreach (var k in byRegister[best].ToArray())
                {
                    if (Overlap(parts[k], parts[i]))
                    {
                        assigned[k] = -1;
                        byRegister[best].Remove(k);
                    }
                }
                pick = best;
            }
        }
        // a register of the other kind (an integer in an address register: no dbra, no byte operations): a value of
        // the preferred kind that is worth less and is the only one in its register in the way moves there, if it fits
        if (pick >= 0 && (pick >= nData) != cur.Pointer)
        {
            int first = cur.Pointer ? nData : 0;
            int last = cur.Pointer ? nRegs : nData;
            int from = -1;
            int moved = -1;
            for (var r = first; r < last; r += 1)
            {
                int only = -1;
                int count = 0;
                foreach (var k in byRegister[r].ToArray())
                {
                    if (Overlap(parts[k], parts[i]))
                    {
                        only = k;
                        count += 1;
                    }
                }
                if (count != 1 || Worth(sorted[only]) >= Worth(cur) || Conflicts(parts, byRegister[pick], only, -1) != 0)
                    continue;
                if (moved < 0 || Worth(sorted[only]) < Worth(sorted[moved]))
                {
                    from = r;
                    moved = only;
                }
            }
            if (moved >= 0)
            {
                byRegister[from].Remove(moved);
                byRegister[pick].Add(moved);
                assigned[moved] = pick;
                pick = from;
            }
        }
        if (pick >= 0)
        {
            byRegister[pick].Add(i);
            assigned[i] = pick;
        }
    }
    // a pointer in a data register: the two registers exchange their values over its time (the other values of the address
    // register then, and those of the data register over their time), where each fits into the other register and the
    // pointers that end up in the data register (and half the integers that end up in the address register) are worth
    // less than the ones that end up in the address register
    for (var i = 0; i < sorted.Length; i += 1)
    {
        int rd = assigned[i];
        if (rd < 0 || rd >= nData || !sorted[i].Pointer)
            continue;
        for (var ra = nData; ra < nRegs; ra += 1)
        {
            var toData = List<int>.Create();
            foreach (var k in byRegister[ra].ToArray())
            {
                if (Overlap(parts[k], parts[i]))
                    toData.Add(k);
            }
            var toAddress = List<int>.Create();
            toAddress.Add(i);
            foreach (var k in byRegister[rd].ToArray())
            {
                if (k == i)
                    continue;
                foreach (var m in toData.ToArray())
                {
                    if (Overlap(parts[k], parts[m]) && !toAddress.Contains(k))
                        toAddress.Add(k);
                }
            }
            // (what goes to the address register must not meet what stays there)
            bool fits = true;
            int lost = 0;
            int won = 0;
            foreach (var k in toAddress.ToArray())
            {
                if (Conflicts(parts, byRegister[ra], k, -1) - ConflictsWith(parts, toData, k) != 0)
                    fits = false;
                if (sorted[k].Pointer)
                    won += Worth(sorted[k]);
                else
                    lost += Worth(sorted[k]) / 2; // (an integer in an address register: no byte operations)
            }
            foreach (var k in toData.ToArray())
            {
                if (sorted[k].Pointer)
                    lost += Worth(sorted[k]);
            }
            if (!fits || lost >= won)
                continue;
            foreach (var k in toAddress.ToArray())
            {
                assigned[k] = ra;
                byRegister[rd].Remove(k);
                byRegister[ra].Add(k);
            }
            foreach (var k in toData.ToArray())
            {
                assigned[k] = rd;
                byRegister[ra].Remove(k);
                byRegister[rd].Add(k);
            }
            break;
        }
    }
    SplitValues(g, f, blocks, index, depth, preds, sorted, segBlock, segStart, segEnd, parts, byRegister, assigned, regs, nData,
                allocaSize, phiDefs, phiUses);
    for (var i = 0; i < sorted.Length; i += 1)
    {
        if (assigned[i] >= 0)
        {
            g.Home.Set(sorted[i].Name, regs[assigned[i]]);
            used[assigned[i]] = true;
        }
    }
    foreach (var entry in aliasOf.Entries())
    {
        var home = g.Home.TryGet(entry.Value);
        if (home is string reg)
            g.Home.Set(entry.Key, reg);
        else if (allocaSize.GetOrDefault(entry.Value, 0) == 4)
            g.Home.Set(entry.Key, Frame(g.Alloca.Get(entry.Value))); // the variable's slot: read (or written) there
    }
    for (var r = 0; r < nRegs; r += 1)
    {
        if (used[r] && regs[r] != "%d2" && regs[r] != "%d3")
            g.Saved.Add(regs[r]); // (d2 and d3 are always saved)
    }
    foreach (var name in forwarded)
        g.Home.Set(name, "%d0");
}

// The values that got no register: one where its other values are only in blocks that the value passes (neither
// computed nor used there), if its uses elsewhere are worth more than the loads at the blocks entered from those (the
// weights of the blocks: 1, 8, 64, 512 by their loop depth). Not for variables, parameters, phis and their values, and
// not for the results of comparisons and checked additions (their code is fused with the branch).
void SplitValues(Gen g, IrFunc f, IrBlock[] blocks, Dictionary<string, int> index, int[] depth, List<int>[] preds,
                 LiveInterval[] sorted, List<int>[] segBlock, List<int>[] segStart, List<int>[] segEnd, int[][] parts,
                 List<int>[] byRegister, int[] assigned, string[] regs, int nData, Dictionary<string, int> allocaSize,
                 HashSet<string>[] phiDefs, List<string>[] phiUses)
{
    int n = blocks.Length;
    var weightOf = new int[n];
    for (var j = 0; j < n; j += 1)
    {
        int d = depth[j] > 3 ? 3 : depth[j];
        weightOf[j] = d == 0 ? 1 : (d == 1 ? 8 : (d == 2 ? 64 : 512));
    }
    var succCount = new int[n];
    var hasPhis = new bool[n];
    for (var j = 0; j < n; j += 1)
    {
        foreach (var p in preds[j].ToArray())
            succCount[p] += 1;
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            if (inst.Op == "phi")
                hasPhis[j] = true;
        }
    }
    // the blocks that each round of their innermost loop passes (they dominate all its branches back): their uses
    // count twice as much as those of a block on one way of several
    var idom = Dominators(f);
    var always = new bool[n];
    for (var j = 0; j < n; j += 1)
        always[j] = depth[j] == 0;
    for (var head = 0; head < n; head += 1)
    {
        var back = List<int>.Create();
        foreach (var p in preds[head].ToArray())
        {
            if (Dominates(idom, head, p))
                back.Add(p);
        }
        if (back.Count() == 0)
            continue;
        for (var j = 0; j < n; j += 1)
        {
            if (depth[j] != depth[head] || !Dominates(idom, head, j))
                continue;
            bool all = true;
            foreach (var p in back.ToArray())
            {
                if (!Dominates(idom, j, p))
                    all = false;
            }
            if (all)
                always[j] = true;
        }
    }
    // where each value is computed and used (with the weights of the uses)
    var defBlock = Dictionary<string, int>.Create();
    var defOp = Dictionary<string, IrInst>.Create();
    var useWeight = Dictionary<string, int>.Create();    // "value|block" -> the weight of its uses there
    var excluded = HashSet<string>.Create();
    foreach (var p in f.Params)
        excluded.Add(p.Name);
    for (var j = 0; j < n; j += 1)
    {
        foreach (var name in phiDefs[j].ToArray())
            excluded.Add(name);
        foreach (var name in phiUses[j].ToArray())
            excluded.Add(name);
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            if (inst.Res.Length > 0 && g.Skip.Contains(inst.Res))
                continue;
            if (inst.Res.Length > 0)
            {
                defBlock.Set(inst.Res, j);
                defOp.Set(inst.Res, inst);
            }
            var used = List<int>.Create();
            foreach (var a in inst.Args)
                used.Add(a);
            if (inst.Callee >= 0)
                used.Add(inst.Callee);
            if (inst.Op == "load" || inst.Op == "store")
            {
                var ptr = g.M.Vals.Get(inst.Args[inst.Op == "load" ? 0 : 1]);
                var fold = ptr.Kind == ValKind.Local ? g.Folds.TryGet(ptr.Name) : null;
                if (fold is AddrFold af)
                {
                    if (af.Base >= 0)
                        used.Add(af.Base);
                    if (af.Index >= 0)
                        used.Add(af.Index);
                }
            }
            foreach (var a in used.ToArray())
            {
                var v = g.M.Vals.Get(a);
                if (v.Kind != ValKind.Local)
                    continue;
                string key = v.Name + "|" + j.ToString();
                useWeight.Set(key, useWeight.GetOrDefault(key, 0) + weightOf[j]);
            }
        }
    }
    for (var i = 0; i < sorted.Length; i += 1)
    {
        string name = sorted[i].Name;
        if (assigned[i] >= 0 || sorted[i].Weight < 2 || allocaSize.ContainsKey(name) || excluded.Contains(name) ||
            !defBlock.ContainsKey(name))
            continue;
        var def = defOp.Get(name);
        if (def.Op == "icmp" || def.Op == "extractvalue" || def.Op == "phi" || def.Op == "call")
            continue;
        int best = -1;
        int bestGain = 0;
        HashSet<string> bestSlot = HashSet<string>.Create();
        HashSet<string> bestReload = HashSet<string>.Create();
        HashSet<string> bestAtEnd = HashSet<string>.Create();
        for (var r = 0; r < regs.Length; r += 1)
        {
            // the blocks where another value of the register overlaps this one
            var inSlot = HashSet<int>.Create();
            for (var s = 0; s < segBlock[i].Count(); s += 1)
            {
                int[] one = [segStart[i].Get(s), segEnd[i].Get(s)];
                foreach (var k in byRegister[r].ToArray())
                {
                    if (Overlap(parts[k], one))
                        inSlot.Add(segBlock[i].Get(s));
                }
            }
            if (inSlot.Count() == 0 || inSlot.Contains(defBlock.Get(name)))
                continue;
            bool usedThere = false;
            foreach (var b in inSlot.ToArray())
            {
                if (useWeight.GetOrDefault(name + "|" + b.ToString(), 0) > 0)
                    usedThere = true;
            }
            if (usedThere)
                continue;
            // what the register saves: the uses; what it costs: the store where it is computed and the loads (at the
            // end of a block that leaves the slot's blocks: half its weight, it is one way of several)
            int gain = 0;
            var reload = HashSet<int>.Create();
            var reloadAtEnd = HashSet<int>.Create();
            int cost = weightOf[defBlock.Get(name)];
            for (var s = 0; s < segBlock[i].Count(); s += 1)
            {
                int b = segBlock[i].Get(s);
                if (inSlot.Contains(b))
                    continue;
                gain += useWeight.GetOrDefault(name + "|" + b.ToString(), 0) * (always[b] ? 2 : 1);
                foreach (var pb in preds[b].ToArray())
                {
                    if (!inSlot.Contains(pb))
                        continue;
                    if (succCount[pb] == 1 && !hasPhis[b])
                    {
                        if (!reloadAtEnd.Contains(pb))
                            cost += weightOf[pb] / 2 + 1;
                        reloadAtEnd.Add(pb);
                    }
                    else if (!reload.Contains(b))
                    {
                        reload.Add(b);
                        cost += weightOf[b];
                    }
                }
            }
            // (an integer in an address register or a pointer in a data register: worth less)
            if ((r >= nData) != sorted[i].Pointer)
                gain = gain / 2;
            if (gain - cost > bestGain)
            {
                best = r;
                bestGain = gain - cost;
                bestSlot = HashSet<string>.Create();
                foreach (var b in inSlot.ToArray())
                    bestSlot.Add(blocks[b].Label);
                bestReload = HashSet<string>.Create();
                foreach (var b in reload.ToArray())
                    bestReload.Add(blocks[b].Label);
                bestAtEnd = HashSet<string>.Create();
                foreach (var b in reloadAtEnd.ToArray())
                    bestAtEnd.Add(blocks[b].Label);
            }
        }
        if (best < 0)
            continue;
        assigned[i] = best;
        byRegister[best].Add(i);
        g.Splits.Add(SplitHome { Name = name, Reg = regs[best], InSlot = bestSlot, Reload = bestReload, ReloadAtEnd = bestAtEnd });
    }
}

// The values that go from their instruction straight to the next one in d0: the next instruction is their only use and
// takes them as its first operand. Their instructions are ones whose code leaves the result in d0 at its end
// (StoreResult, or the result register: then d0), and the next instruction is one whose code reads its first operand
// before it changes d0. Such a value needs neither a register of its own nor its slot.
List<string> ForwardedValues(Gen g, IrFunc f)
{
    // (the uses by instructions that are written, and by the addresses of folded accesses: 'a[i + 1]' uses i there)
    var uses = Dictionary<string, int>.Create();
    foreach (var entry in g.Folds.Entries())
    {
        foreach (var part in [entry.Value.Base, entry.Value.Index])
        {
            if (part >= 0 && g.M.Vals.Get(part).Kind == ValKind.Local)
                uses.Set(g.M.Vals.Get(part).Name, uses.GetOrDefault(g.M.Vals.Get(part).Name, 0) + 1);
        }
    }
    foreach (var b in f.Blocks.ToArray())
    {
        foreach (var inst in b.Insts.ToArray())
        {
            if (inst.Res.Length > 0 && g.Skip.Contains(inst.Res))
                continue;
            foreach (var a in inst.Args)
            {
                var v = g.M.Vals.Get(a);
                if (v.Kind == ValKind.Local)
                    uses.Set(v.Name, uses.GetOrDefault(v.Name, 0) + 1);
            }
            if (inst.Callee >= 0 && g.M.Vals.Get(inst.Callee).Kind == ValKind.Local)
                uses.Set(g.M.Vals.Get(inst.Callee).Name, uses.GetOrDefault(g.M.Vals.Get(inst.Callee).Name, 0) + 1);
        }
    }
    var result = List<string>.Create();
    foreach (var b in f.Blocks.ToArray())
    {
        // the instructions in the order their code is written (phis, allocas and folded instructions write none)
        var code = List<IrInst>.Create();
        foreach (var inst in b.Insts.ToArray())
        {
            if (inst.Op != "phi" && inst.Op != "alloca" && !(inst.Res.Length > 0 && g.Skip.Contains(inst.Res)))
                code.Add(inst);
        }
        var insts = code.ToArray();
        for (var k = 0; k + 1 < insts.Length; k += 1)
        {
            var def = insts[k];
            var user = insts[k + 1];
            if (def.Res.Length == 0 || uses.GetOrDefault(def.Res, 0) != 1 || !IsScalar4(g, def.Type) || !LeavesInD0(g, def))
                continue;
            if (user.Args.Length == 0 || !IsLocal(g, user.Args[0]) || g.M.Vals.Get(user.Args[0]).Name != def.Res)
                continue;
            if (ReadsFirstOperandFirst(g, insts, k + 1))
                result.Add(def.Res);
        }
    }
    return result;
}

bool IsArithmetic32(Gen g, IrInst inst)
{
    string op = inst.Op;
    bool arithmetic = op == "add" || op == "sub" || op == "mul" || op == "and" || op == "or" || op == "xor" ||
                      op == "shl" || op == "lshr" || op == "ashr" || op == "sdiv" || op == "udiv" || op == "srem" ||
                      op == "urem";
    return arithmetic && g.T.Kind(inst.OpType) == IrKind.Int && g.T.Bits(inst.OpType) <= 32;
}

bool IsIntCast(string op)
{
    return op == "sext" || op == "zext" || op == "trunc" || op == "bitcast" || op == "ptrtoint" || op == "inttoptr";
}

// whether the code of an instruction has its result in d0 at its end (GenBinary32, GenIcmp, GenIntCast, loads)
bool LeavesInD0(Gen g, IrInst inst)
{
    if (IsArithmetic32(g, inst) || IsIntCast(inst.Op))
        return true;
    if (inst.Op == "icmp")
        return !(g.T.Kind(inst.OpType) == IrKind.Int && g.T.Bits(inst.OpType) == 64);
    // a load, but not one of a variable (that shares the variable's register)
    if (inst.Op == "load")
        return !(IsLocal(g, inst.Args[0]) && g.Alloca.ContainsKey(g.M.Vals.Get(inst.Args[0]).Name)) &&
               !g.T.IsAggregate(inst.Type);
    return false;
}

// whether the code of insts[k] reads its first operand before it writes d0
bool ReadsFirstOperandFirst(Gen g, IrInst[] insts, int k)
{
    var inst = insts[k];
    if (IsArithmetic32(g, inst) || IsIntCast(inst.Op))
        return true;
    if (inst.Op == "icmp")
    {
        if (g.T.Kind(inst.OpType) == IrKind.Int && g.T.Bits(inst.OpType) == 64)
            return false;
        // compared and branched together (GenCompareBranch): the phi copies of the branch come first
        if (k + 1 < insts.Length && insts[k + 1].Op == "br")
        {
            foreach (var label in insts[k + 1].Labels)
            {
                if (g.Phis.ContainsKey(label))
                    return false;
            }
        }
        return true;
    }
    // (not into a variable: a value only stored into a variable is computed in the variable's register)
    if (inst.Op == "store")
        return IsScalar4(g, inst.OpType) && !(IsLocal(g, inst.Args[1]) && g.Alloca.ContainsKey(g.M.Vals.Get(inst.Args[1]).Name));
    if (inst.Op == "load")
        return true;
    if (inst.Op == "call" && inst.Callee >= 0)
    {
        // checked addition and subtraction (GenOverflowBranch, GenOverflow)
        var callee = g.M.Vals.Get(inst.Callee);
        if (callee.Kind != ValKind.Global || !callee.Name.StartsWith("llvm.") || !callee.Name.Contains(".with.overflow.") ||
            callee.Name.Contains("mul"))
            return false;
        int t = g.M.Vals.Get(inst.Args[0]).Type;
        return g.T.Kind(t) == IrKind.Int && g.T.Bits(t) <= 32;
    }
    return false;
}

// the block that contains a position
int BlockAt(int[] blockStart, int at)
{
    int low = 0;
    int high = blockStart.Length - 1;
    while (low < high)
    {
        int mid = (low + high + 1) / 2;
        if (blockStart[mid] <= at)
            low = mid;
        else
            high = mid - 1;
    }
    return low;
}

// whether two intervals (their parts: start, end, ... in order) have a point in common
bool Overlap(int[] a, int[] b)
{
    int i = 0;
    int k = 0;
    while (i < a.Length && k < b.Length)
    {
        if (a[i + 1] < b[k])
            i += 2;
        else if (b[k + 1] < a[i])
            k += 2;
        else
            return true;
    }
    return false;
}

// how many of the intervals in 'others' overlap interval i
int ConflictsWith(int[][] parts, List<int> others, int i)
{
    int count = 0;
    foreach (var k in others.ToArray())
    {
        if (k != i && Overlap(parts[k], parts[i]))
            count += 1;
    }
    return count;
}

// the intervals of a register (but 'except') that overlap interval i
int Conflicts(int[][] parts, List<int> inRegister, int i, int except)
{
    int count = 0;
    foreach (var k in inRegister.ToArray())
    {
        if (k != except && k != i && Overlap(parts[k], parts[i]))
            count += 1;
    }
    return count;
}

bool IsCandidate(string name, Dictionary<string, bool> isPointer, HashSet<string> excluded)
{
    return isPointer.ContainsKey(name) && !excluded.Contains(name);
}

void Touch(string name, int at, int w, Dictionary<string, int> weight, Dictionary<string, int> lo, Dictionary<string, int> hi,
           List<string> touchName, List<int> touchPos)
{
    touchName.Add(name);
    touchPos.Add(at);
    var l = lo.TryGet(name);
    if (!(l is int low) || at < low)
        lo.Set(name, at);
    var h = hi.TryGet(name);
    if (!(h is int high) || at > high)
        hi.Set(name, at);
    if (w > 0)
        weight.Set(name, weight.GetOrDefault(name, 0) + w);
}

// what a register saves: the uses weighted by loop nesting (a long-lived value used in a loop beats short temporaries)
int Worth(LiveInterval iv)
{
    return iv.Weight;
}

// whether the code of an instruction of the function uses d2 or d3 (Gen.cshift): 64-bit arithmetic and comparisons,
// products (but by constants of 16 bits and powers of two), remainders, products with an overflow check. (A 64-bit
// value that is only extended, truncated or passed on, as in the message of a failed bounds check, needs neither.)
bool NeedsD2D3(Gen g, IrFunc f)
{
    foreach (var b in f.Blocks.ToArray())
    {
        foreach (var inst in b.Insts.ToArray())
        {
            if (inst.Res.Length > 0 && g.Skip.Contains(inst.Res))
                continue;
            string op = inst.Op;
            // (a division by 1 or a power of two is a shift or nothing: '(int)(p - q)' divides by sizeof(uint8))
            if ((op == "srem" || op == "urem" || op == "sdiv" || op == "udiv") && !CheapDivisor(g, inst))
                return true;
            if (op == "mul" && !SmallFactor(g, inst.Args[0]) && !SmallFactor(g, inst.Args[1]))
                return true;
            bool arithmetic = op == "add" || op == "sub" || op == "mul" || op == "and" || op == "or" || op == "xor" ||
                              op == "shl" || op == "lshr" || op == "ashr" || op == "icmp" || op == "select";
            if (arithmetic && (Is64(g, inst.Type) || Is64(g, inst.OpType)))
                return true;
            if (op == "call" && inst.Callee >= 0)
            {
                var c = g.M.Vals.Get(inst.Callee);
                // (a checked 32-bit product by a power of two from 2 to 256 is an asl and a bvs)
                if (c.Kind == ValKind.Global && c.Name.StartsWith("llvm.") &&
                    (c.Name.Contains("mul") || c.Name.EndsWith(".i64")) &&
                    !(c.Name == "llvm.smul.with.overflow.i32" && inst.Args.Length == 2 &&
                      (ShiftFactor(g, inst.Args[0]) || ShiftFactor(g, inst.Args[1]))))
                    return true;
            }
        }
    }
    return false;
}

// a constant 2, 4, ... 256
bool ShiftFactor(Gen g, int vi)
{
    var v = g.M.Vals.Get(vi);
    return v.Kind == ValKind.Int && v.Int >= 2 && v.Int <= 256 && (v.Int & (v.Int - 1)) == 0;
}

// a 32-bit division or remainder by a constant 1 or 2..2^30, which Gen.cshift makes without d2/d3 (but a signed
// remainder by a power of two: it keeps the dividend in d2)
bool CheapDivisor(Gen g, IrInst inst)
{
    int64 c = 0;
    if (inst.Args.Length != 2 || Is64(g, inst.Type) || !ConstFactor(g, inst.Args[1], ref c))
        return false;
    return c == 1 || (inst.Op != "srem" && PowerOfTwo(c) >= 1 && PowerOfTwo(c) <= 30);
}

// a constant factor whose product takes neither d2 nor d3: a power of two or one of 16 bits
bool SmallFactor(Gen g, int vi)
{
    int64 c = 0;
    if (!ConstFactor(g, vi, ref c))
        return false;
    c = c & 4294967295;
    return ((c >> 16) & 65535) == 0 || PowerOfTwo(c) >= 0;
}

bool Is64(Gen g, int t)
{
    return t >= 0 && g.T.Kind(t) == IrKind.Int && g.T.Bits(t) == 64;
}
