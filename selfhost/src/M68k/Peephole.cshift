// A peephole optimizer for the assembly of one function (Gen.cshift writes simple, regular code): copies through
// a0/a1 become direct moves, stores that are loaded again right away keep the register, arguments are pushed
// directly, branches over branches are inverted. It only changes a pattern when the scratch registers it removes
// (d0/d1/a0/a1) are not read afterwards.

namespace CShift.M68k;

using System;

string Peephole(Gen g, string text)
{
    var lines = List<string>.Create();
    foreach (var l in text.Split('\n'))
    {
        if (l.Length > 0)
            lines.Add(l.ToString());
    }
    for (var pass = 0; pass < 4; pass += 1)
    {
        if (!PeepholePass(g, lines))
            break;
    }
    // jump towers for short counted loops (not with -O0/-O1: they make the code larger)
    if (g.Counters[2] >= 2)
        JumpTowers(g, lines);
    var sb = StringBuilder.Create();
    foreach (var l in lines.ToArray())
    {
        sb.Append(l);
        sb.Append('\n');
    }
    return sb.ToString();
}

bool IsInstrLine(string line)
{
    return line.StartsWith("\t") && !line.StartsWith("\t.");
}

string Mnemonic(string line)
{
    if (!IsInstrLine(line))
        return "";
    int tab = line.IndexOf('\t', 1);
    return tab < 0 ? line.Substring(1).ToString() : line.Substring(1, tab - 1).ToString();
}

string[] Operands(string line)
{
    int tab = line.IndexOf('\t', 1);
    if (tab < 0)
        return new string[0];
    return SplitOperands(line.Substring(tab + 1).ToString());
}

string Instr(string mnemonic, string operands)
{
    return "\t" + mnemonic + "\t" + operands;
}

bool Mentions(string operand, string reg)
{
    return operand.Contains(reg);
}

string Negate(string cond)
{
    switch (cond)
    {
    case "eq": return "ne";
    case "ne": return "eq";
    case "lt": return "ge";
    case "ge": return "lt";
    case "le": return "gt";
    case "gt": return "le";
    case "cs": return "cc";
    case "cc": return "cs";
    case "ls": return "hi";
    case "hi": return "ls";
    case "mi": return "pl";
    case "pl": return "mi";
    case "vs": return "vc";
    case "vc": return "vs";
    default: return "";
    }
}

// Is the register (d0, d1, a0 or a1: "%d0") not read before it is written again, after line 'from'?
bool DeadAfter(List<string> lines, int from, string reg)
{
    for (var i = from; i < lines.Count(); i += 1)
    {
        string line = lines.Get(i);
        if (!line.StartsWith("\t"))
            return false; // a label: other code may come here
        if (line.StartsWith("\t."))
            continue;
        string mn = Mnemonic(line);
        var ops = Operands(line);
        if (mn == "jsr")
        {
            if (ops.Length > 0 && (Mentions(ops[0], reg) || ops[0].StartsWith("__cs68k_")))
                return false; // the register helpers take d0/d1
            return true;      // the called function does not keep the scratch registers
        }
        if (mn == "rts" || mn == "jmp" || mn == "bra" || mn.StartsWith("db") || (mn.StartsWith("b") && mn.Length <= 3))
            return false;
        if (ops.Length == 0)
            continue;
        for (var k = 0; k < ops.Length - 1; k += 1)
        {
            if (Mentions(ops[k], reg))
                return false;
        }
        string last = ops[ops.Length - 1];
        if (last == reg)
        {
            // (move.w/move.b write only part of a data register; to an address register, move.w writes all of it)
            bool fullWrite = mn == "move.l" || mn == "moveq" || mn == "lea" || (reg.StartsWith("%a") && mn == "move.w");
            if (ops.Length == 2 && fullWrite)
                return true;
            return false;
        }
        if (Mentions(last, reg))
            return false;
    }
    return false;
}

// whether no way from line 'from' on reads reg before it writes it: DeadAfter, through branches as well (the targets
// of a branch and the line after it are both followed; a way that comes back to a line seen before adds nothing). A
// byte or word written to a data register may be read with that size or less afterwards.
bool DeadOnAllPaths(List<string> lines, int from, string reg)
{
    var labels = Dictionary<string, int>.Create();
    for (var i = 0; i < lines.Count(); i += 1)
    {
        string line = lines.Get(i);
        if (!line.StartsWith("\t") && line.EndsWith(":"))
            labels.Set(line.Substring(0, line.Length - 1).ToString(), i);
    }
    var seen = HashSet<int>.Create();   // line * 8 + the size written on the way there
    var work = List<int>.Create();
    work.Add(from * 8);
    while (work.Count() > 0)
    {
        int item = work.Get(work.Count() - 1);
        work.RemoveAt(work.Count() - 1);
        int written = item % 8;
        bool ended = false;
        for (var i = item / 8; i < lines.Count() && !ended; i += 1)
        {
            if (seen.Contains(i * 8 + written))
            {
                ended = true;
                break;
            }
            seen.Add(i * 8 + written);
            string line = lines.Get(i);
            if (!line.StartsWith("\t") || line.StartsWith("\t."))
                continue;
            string mn = Mnemonic(line);
            var ops = Operands(line);
            int size = mn.EndsWith(".b") ? 1 : mn.EndsWith(".w") ? 2 : 4;
            if (mn == "jsr")
            {
                if (written == 0 && ops.Length > 0 && (Mentions(ops[0], reg) || ops[0].StartsWith("__cs68k_")))
                    return false;
                ended = true; // the called function does not keep the scratch registers
                break;
            }
            if ((mn == "rts" || mn == "jmp") && written == 0)
                return false;
            if (mn == "rts" || mn == "jmp")
            {
                ended = true;
                break;
            }
            for (var k = 0; k < ops.Length; k += 1)
            {
                if (!Mentions(ops[k], reg))
                    continue;
                bool write = k == ops.Length - 1 && ops[k] == reg && ops.Length == 2 && (mn.StartsWith("move") || mn == "lea");
                if (write)
                {
                    int now = reg.StartsWith("%a") || mn == "moveq" || mn == "lea" ? 4 : size;
                    if (now > written)
                        written = now;
                    if (written == 4)
                        ended = true;
                }
                else if (written == 0 || size > written || k == ops.Length - 1)
                    return false;
            }
            if (ended)
                break;
            string bare = mn.IndexOf('.') > 0 ? mn.Substring(0, mn.IndexOf('.')).ToString() : mn;
            bool branch = bare == "bra" || (bare.StartsWith("b") && bare.Length == 3) || (bare.StartsWith("db") && bare.Length == 4);
            if (!branch)
                continue;
            if (!labels.ContainsKey(ops[ops.Length - 1]))
                return false;
            work.Add(labels.Get(ops[ops.Length - 1]) * 8 + written);
            if (bare == "bra")
            {
                ended = true;
                break;
            }
        }
        if (!ended)
            return false; // (the end of the code without a return)
    }
    return true;
}

// Does the instruction read the condition codes (a conditional branch or set, an operation with the X flag)?
bool ReadsFlags(string line)
{
    string mn = Mnemonic(line);
    if (mn.Length == 0)
        return false;
    int dot = mn.IndexOf('.');
    if (dot > 0)
        mn = mn.Substring(0, dot).ToString(); // beq.s, dbra.w, ...
    if (mn == "bra" || mn == "bsr")
        return false;
    if ((mn.StartsWith("b") && mn.Length == 3) || (mn.StartsWith("db") && mn.Length == 4))
        return true;
    if (mn.StartsWith("s") && (mn.Length == 3 || mn == "st" || mn == "sf") && Negate(mn.Substring(1).ToString()).Length > 0)
        return true;
    return mn.StartsWith("addx") || mn.StartsWith("subx") || mn.StartsWith("negx") || mn.StartsWith("rox") ||
           mn.StartsWith("abcd") || mn.StartsWith("sbcd") || Operands(line).Length > 0 && Mentions(line, "%sr") ||
           Mentions(line, "%ccr");
}

// (-8,%a6): a long of the frame
bool IsFrameSlot(string operand)
{
    return operand.StartsWith("(-") && operand.EndsWith(",%a6)") && RegisterOffset(operand, "%a6") != -99999;
}

// whether no line of the function but the two given ones touches the 4 bytes of a frame slot (also not a part of them,
// nor an address in the frame near them, which could be the start of a copy)
bool SlotUnused(List<string> lines, string slot, int a, int b)
{
    int at = RegisterOffset(slot, "%a6");
    for (var i = 0; i < lines.Count(); i += 1)
    {
        if (i == a || i == b)
            continue;
        string line = lines.Get(i);
        if (!line.Contains(",%a6)"))
            continue;
        foreach (var o in Operands(line))
        {
            if (!o.Contains("%a6"))
                continue;
            int r = RegisterOffset(o, "%a6");
            if (r == -99999 || (Mnemonic(line) == "lea" && r <= at) || (r > at - 8 && r < at + 4))
                return false;
        }
    }
    return true;
}

// (%a2) .. (%a5): an address register's memory without an offset
bool IsPlainIndirect(string operand)
{
    return operand.Length == 5 && operand.StartsWith("(%a") && operand.EndsWith(")") && operand[3] >= '2' && operand[3] <= '5';
}

bool IsRegister(string operand)
{
    return operand.Length == 3 && (operand.StartsWith("%d") || operand.StartsWith("%a"));
}

// "(d,%a6)" -> the same place plus 'plus' bytes; "" if the operand is not of that form
string OffsetOperand(string operand, int plus)
{
    if (!operand.StartsWith("(") || !operand.EndsWith(",%a6)"))
        return "";
    string d = operand.Substring(1, operand.Length - 6).ToString();
    var n = TryAsmNumber(d);
    if (n is int64 v)
        return "(" + (v + (int64)plus).ToString() + ",%a6)";
    return "";
}

// "(%aX)" -> 0, "(n,%aX)" -> n; -99999 for any other use of the register
int RegisterOffset(string operand, string reg)
{
    if (operand == "(" + reg + ")")
        return 0;
    string tail = "," + reg + ")";
    if (operand.StartsWith("(") && operand.EndsWith(tail))
    {
        var n = TryAsmNumber(operand.Substring(1, operand.Length - 1 - tail.Length).ToString());
        if (n is int64 v && v >= -32768 && v <= 32767)
            return (int)v;
    }
    return -99999;
}

bool PeepholePass(Gen g, List<string> lines)
{
    bool changed = false;
    int i = 0;
    while (i < lines.Count())
    {
        string line = lines.Get(i);
        string mn = Mnemonic(line);
        if (mn.Length == 0)
        {
            i += 1;
            continue;
        }
        var ops = Operands(line);

        // move.b (%a3)+,%d0 / move.b %d0,(%a4)+ -> move.b (%a3)+,(%a4)+ (memory to memory; the flags are those of the
        // value either way), where d0 is not read on any way afterwards and the two operands share no address register
        if ((mn == "move.b" || mn == "move.w" || mn == "move.l") && ops.Length == 2 && ops[1] == "%d0" && !Mentions(ops[0], "%d0") &&
            i + 1 < lines.Count())
        {
            string next = lines.Get(i + 1);
            var ops2 = Operands(next);
            bool shared = false;
            foreach (var r in ["%a0", "%a1", "%a2", "%a3", "%a4", "%a5", "%a6", "%sp"])
            {
                if (Mentions(ops[0], r) && Mentions(ops2.Length == 2 ? ops2[1] : "", r))
                    shared = true;
            }
            if (Mnemonic(next) == mn && ops2.Length == 2 && ops2[0] == "%d0" && !Mentions(ops2[1], "%d0") &&
                !ops2[1].StartsWith("%a") && !shared && DeadOnAllPaths(lines, i + 2, "%d0"))
            {
                lines.Set(i, Instr(mn, ops[0] + "," + ops2[1]));
                lines.RemoveAt(i + 1);
                changed = true;
                continue;
            }
        }

        // lea (d,%a6),%aX / lea (c,%aX),%aX -> lea (d+c,%a6),%aX
        if (mn == "lea" && ops.Length == 2 && ops[1].StartsWith("%a") && OffsetOperand(ops[0], 0).Length > 0 && i + 1 < lines.Count())
        {
            string next = lines.Get(i + 1);
            var ops2 = Operands(next);
            if (Mnemonic(next) == "lea" && ops2.Length == 2 && ops2[1] == ops[1])
            {
                int at = RegisterOffset(ops2[0], ops[1]);
                if (at != -99999)
                {
                    lines.Set(i, Instr("lea", OffsetOperand(ops[0], at) + "," + ops[1]));
                    lines.RemoveAt(i + 1);
                    changed = true;
                    continue;
                }
            }
        }

        // move.l %aX,%aY / lea (n,%aY),%aY -> lea (n,%aX),%aY (neither sets the flags)
        if (mn == "move.l" && ops.Length == 2 && ops[0].StartsWith("%a") && ops[1].StartsWith("%a") && ops[0] != ops[1] &&
            ops[0].Length == 3 && ops[1].Length == 3 && ops[0] != "%a7" && i + 1 < lines.Count())
        {
            string next = lines.Get(i + 1);
            var ops2 = Operands(next);
            if (Mnemonic(next) == "lea" && ops2.Length == 2 && ops2[1] == ops[1])
            {
                int at = RegisterOffset(ops2[0], ops[1]);
                if (at != -99999 && at >= -32768 && at <= 32767)
                {
                    lines.Set(i, Instr("lea", "(" + at.ToString() + "," + ops[0] + ")," + ops[1]));
                    lines.RemoveAt(i + 1);
                    changed = true;
                    continue;
                }
            }
        }

        // lea (d,%a6),%a0 / op ...(n,%a0)... -> op ...(d+n,%a6)... (a0 not needed afterwards; same for a1)
        // move.l %aN,%a0 / op ...(n,%a0)... -> op ...(n,%aN)...
        if ((mn == "lea" || mn == "move.l") && ops.Length == 2 && (ops[1] == "%a0" || ops[1] == "%a1") && i + 1 < lines.Count())
        {
            string scratch = ops[1];
            bool fromFrame = mn == "lea" && OffsetOperand(ops[0], 0).Length > 0;
            bool fromReg = mn == "move.l" && ops[0].StartsWith("%a") && ops[0] != "%a0" && ops[0] != "%a1" && ops[0] != "%sp";
            string next = lines.Get(i + 1);
            string mn2 = Mnemonic(next);
            var ops2 = Operands(next);
            if ((fromFrame || fromReg) && mn2.Length > 0 && !mn2.StartsWith("lea") && mn2 != "jsr" && mn2 != "jmp" && ops2.Length >= 1 &&
                DeadAfter(lines, i + 2, scratch))
            {
                var rewritten = new string[ops2.Length];
                bool ok = true;
                int uses = 0;
                for (var k = 0; k < ops2.Length && ok; k += 1)
                {
                    string o = ops2[k];
                    if (!Mentions(o, scratch))
                    {
                        rewritten[k] = o;
                        continue;
                    }
                    int at = RegisterOffset(o, scratch);
                    if (at == -99999)
                    {
                        ok = false;
                        break;
                    }
                    uses += 1;
                    rewritten[k] = fromFrame ? OffsetOperand(ops[0], at) : "(" + at.ToString() + "," + ops[0] + ")";
                }
                if (ok && uses > 0)
                {
                    lines.RemoveAt(i);
                    lines.Set(i, Instr(mn2, string.Join(",", rewritten)));
                    changed = true;
                    continue;
                }
            }
        }

        // lea (0,%aN),%aN
        if (mn == "lea" && ops.Length == 2 && ops[0] == "(0," + ops[1] + ")")
        {
            lines.RemoveAt(i);
            changed = true;
            continue;
        }

        // lea (s,%a6),%a0 / lea (d,%a6),%a1 (either order) / move.l (%a0)+,(%a1)+ ... -> move.l (s,%a6),(d,%a6) ...
        if (mn == "lea" && ops.Length == 2 && (ops[1] == "%a0" || ops[1] == "%a1") && i + 2 < lines.Count())
        {
            string second = lines.Get(i + 1);
            var ops2 = Operands(second);
            if (Mnemonic(second) == "lea" && ops2.Length == 2 && (ops2[1] == "%a0" || ops2[1] == "%a1") && ops2[1] != ops[1])
            {
                string src = ops[1] == "%a0" ? ops[0] : ops2[0];
                string dst = ops[1] == "%a1" ? ops[0] : ops2[0];
                int count = 0;
                while (i + 2 + count < lines.Count() && lines.Get(i + 2 + count) == "\tmove.l\t(%a0)+,(%a1)+" && count < 4)
                    count += 1;
                int end = i + 2 + count;
                if (count > 0 && OffsetOperand(src, 0).Length > 0 && OffsetOperand(dst, 0).Length > 0 &&
                    DeadAfter(lines, end, "%a0") && DeadAfter(lines, end, "%a1"))
                {
                    for (var k = 0; k < count + 2; k += 1)
                        lines.RemoveAt(i);
                    for (var k = count - 1; k >= 0; k -= 1)
                        lines.Insert(i, Instr("move.l", OffsetOperand(src, 4 * k) + "," + OffsetOperand(dst, 4 * k)));
                    changed = true;
                    continue;
                }
            }
        }

        // suba.l #n,%sp / move.l %sp,%a1 / lea (s,%a6),%a0 / move.l (%a0)+,(%a1)+ x n/4 -> push the longs
        if (mn == "suba.l" && ops.Length == 2 && ops[1] == "%sp" && ops[0].StartsWith("#") && i + 3 < lines.Count() &&
            lines.Get(i + 1) == "\tmove.l\t%sp,%a1")
        {
            var n = TryAsmNumber(ops[0].Substring(1).ToString());
            string third = lines.Get(i + 2);
            var ops3 = Operands(third);
            if (n is int64 bytes && bytes % 4 == 0 && bytes > 0 && bytes <= 16 && Mnemonic(third) == "lea" && ops3.Length == 2 &&
                ops3[1] == "%a0" && OffsetOperand(ops3[0], 0).Length > 0)
            {
                int count = (int)(bytes / 4);
                bool all = i + 3 + count <= lines.Count();
                for (var k = 0; all && k < count; k += 1)
                    all = lines.Get(i + 3 + k) == "\tmove.l\t(%a0)+,(%a1)+";
                int end = i + 3 + count;
                if (all && DeadAfter(lines, end, "%a0") && DeadAfter(lines, end, "%a1"))
                {
                    for (var k = 0; k < count + 3; k += 1)
                        lines.RemoveAt(i);
                    for (var k = 0; k < count; k += 1)
                        lines.Insert(i, Instr("move.l", OffsetOperand(ops3[0], 4 * k) + ",-(%sp)"));
                    changed = true;
                    continue;
                }
            }
        }

        if (i + 1 < lines.Count())
        {
            string next = lines.Get(i + 1);
            string mn2 = Mnemonic(next);
            var ops2 = Operands(next);

            // move.l %X,%Y / move.l %Y,%X -> the second is not needed (X still has the value; the flags of the second,
            // if Y is an address register and the first set none, only matter for an instruction that reads them)
            if (mn == "move.l" && mn2 == "move.l" && ops.Length == 2 && ops2.Length == 2 && IsRegister(ops[0]) &&
                IsRegister(ops[1]) && ops2[0] == ops[1] && ops2[1] == ops[0] &&
                (ops[1].StartsWith("%d") || !ops[0].StartsWith("%d") || i + 2 >= lines.Count() || !ReadsFlags(lines.Get(i + 2))))
            {
                lines.RemoveAt(i + 1);
                changed = true;
                continue;
            }

            // move.b M,%dX / and.l #255,%dX -> moveq #0,%dX / move.b M,%dX (the same for move.w and #65535)
            if ((mn == "move.b" || mn == "move.w") && mn2 == "and.l" && ops.Length == 2 && ops2.Length == 2 &&
                ops[1].StartsWith("%d") && ops2[1] == ops[1] && ops2[0] == (mn == "move.b" ? "#255" : "#65535") &&
                !Mentions(ops[0], ops[1]) && (i + 2 >= lines.Count() || !ReadsFlags(lines.Get(i + 2))))
            {
                lines.Set(i, Instr("moveq", "#0," + ops[1]));
                lines.Set(i + 1, line);
                changed = true;
                continue;
            }

            // move.l %dX,M / move.l M,%dX -> the second is not needed
            if (mn == "move.l" && mn2 == "move.l" && ops.Length == 2 && ops2.Length == 2 && ops[0].StartsWith("%d") &&
                ops2[1] == ops[0] && ops2[0] == ops[1] && !Mentions(ops[1], ops[0]) && ops[1].StartsWith("("))
            {
                lines.RemoveAt(i + 1);
                changed = true;
                continue;
            }

            // move.l M,%d0 / move.l %d0,D -> move.l M,D (d0 not needed afterwards)
            if (mn == "move.l" && mn2 == "move.l" && ops.Length == 2 && ops2.Length == 2 && (ops[1] == "%d0" || ops[1] == "%d1") &&
                ops2[0] == ops[1] && !Mentions(ops2[1], ops[1]) && !ops2[1].StartsWith("%a") && DeadAfter(lines, i + 2, ops[1]))
            {
                lines.RemoveAt(i);
                lines.Set(i, Instr("move.l", ops[0] + "," + ops2[1]));
                changed = true;
                continue;
            }

            // move.l M,%d0 / move.l %d0,%aN -> move.l M,%aN (movea)
            if (mn == "move.l" && mn2 == "move.l" && ops.Length == 2 && ops2.Length == 2 && ops[1] == "%d0" && ops2[0] == "%d0" &&
                ops2[1].StartsWith("%a") && !ops[0].StartsWith("#") && DeadAfter(lines, i + 2, "%d0"))
            {
                lines.RemoveAt(i);
                lines.Set(i, Instr("move.l", ops[0] + "," + ops2[1]));
                changed = true;
                continue;
            }

            // moveq #0,%dX / cmp.l %dX,%dY -> tst.l %dY
            if (mn == "moveq" && ops.Length == 2 && ops[0] == "#0" && mn2.StartsWith("cmp.") && ops2.Length == 2 && ops2[0] == ops[1] &&
                ops2[1].StartsWith("%d") && DeadAfter(lines, i + 2, ops[1]))
            {
                lines.RemoveAt(i);
                lines.Set(i, Instr("tst" + mn2.Substring(3).ToString(), ops2[1]));
                changed = true;
                continue;
            }

            // bra L / L:
            if (mn == "bra" && ops.Length == 1 && next == ops[0] + ":")
            {
                lines.RemoveAt(i);
                changed = true;
                continue;
            }

            // bCC L1 / bra L2 / L1: -> b!CC L2 / L1:
            if (mn.Length == 3 && mn.StartsWith("b") && mn != "bra" && mn != "bsr" && mn2 == "bra" && ops.Length == 1 && ops2.Length == 1 &&
                i + 2 < lines.Count() && lines.Get(i + 2) == ops[0] + ":")
            {
                string negated = Negate(mn.Substring(1).ToString());
                if (negated.Length > 0)
                {
                    lines.Set(i, Instr("b" + negated, ops2[0]));
                    lines.RemoveAt(i + 1);
                    changed = true;
                    continue;
                }
            }
        }

        // move.w x,(%aN) / ... / lea (2,%aN),%aN -> move.w x,(%aN)+ / ... (and loads; a walking pointer, Loops.cshift),
        // when the lines in between are in the same block and do not use aN
        if ((mn == "move.b" || mn == "move.w" || mn == "move.l") && ops.Length == 2)
        {
            int side = IsPlainIndirect(ops[1]) ? 1 : IsPlainIndirect(ops[0]) ? 0 : -1;
            string reg = side >= 0 ? ops[side].Substring(1, ops[side].Length - 2).ToString() : "";
            if (side >= 0 && !Mentions(ops[1 - side], reg))
            {
                int size = mn == "move.b" ? 1 : mn == "move.w" ? 2 : 4;
                for (var k = i + 1; k < lines.Count() && k <= i + 8; k += 1)
                {
                    string next = lines.Get(k);
                    string mn2 = Mnemonic(next);
                    if (mn2.Length == 0 || mn2.StartsWith("b") || mn2.StartsWith("j") || mn2.StartsWith("db") || mn2 == "rts" ||
                        mn2.StartsWith("movem"))
                        break;
                    var ops2 = Operands(next);
                    if (mn2 == "lea" && ops2.Length == 2 && ops2[1] == reg && ops2[0] == "(" + size.ToString() + "," + reg + ")")
                    {
                        string walked = "(" + reg + ")+";
                        lines.Set(i, Instr(mn, side == 1 ? ops[0] + "," + walked : walked + "," + ops[1]));
                        lines.RemoveAt(k);
                        changed = true;
                        break;
                    }
                    if (Mentions(next, reg))
                        break;
                }
            }
        }

        // and.l #128,%d0 / tst.l %d0 -> and.l #128,%d0: and, or and eor set N and Z by the result and clear V and C, as tst
        if ((mn == "and.l" || mn == "or.l" || mn == "eor.l" || mn == "and.w" || mn == "or.w" || mn == "eor.w" ||
             mn == "and.b" || mn == "or.b" || mn == "eor.b") && ops.Length == 2 && ops[1].StartsWith("%d") && ops[1].Length == 3 &&
            i + 1 < lines.Count())
        {
            var ops2 = Operands(lines.Get(i + 1));
            if (Mnemonic(lines.Get(i + 1)) == "tst" + mn.Substring(mn.Length - 2).ToString() && ops2.Length == 1 && ops2[0] == ops[1])
            {
                lines.RemoveAt(i + 1);
                changed = true;
                continue;
            }
        }

        // move.l %d0,(-8,%a6) / move.l (-8,%a6),%d5 -> move.l %d0,(-8,%a6) / move.l %d0,%d5 (the value is in the register:
        // the slot is written and read back right away); the write goes too where nothing else in the function uses the
        // slot (SlotUnused)
        if (mn == "move.l" && ops.Length == 2 && IsRegister(ops[0]) && IsFrameSlot(ops[1]) && i + 1 < lines.Count())
        {
            var ops2 = Operands(lines.Get(i + 1));
            if (Mnemonic(lines.Get(i + 1)) == "move.l" && ops2.Length == 2 && ops2[0] == ops[1] && IsRegister(ops2[1]))
            {
                if (SlotUnused(lines, ops[1], i, i + 1))
                {
                    if (ops2[1] == ops[0])
                    {
                        lines.RemoveAt(i + 1);
                        lines.RemoveAt(i);
                    }
                    else
                    {
                        lines.Set(i, Instr(ops2[1].StartsWith("%a") ? "move.l" : "move.l", ops[0] + "," + ops2[1]));
                        lines.RemoveAt(i + 1);
                    }
                }
                else if (ops2[1] == ops[0])
                    lines.RemoveAt(i + 1);
                else
                    lines.Set(i + 1, Instr("move.l", ops[0] + "," + ops2[1]));
                changed = true;
                continue;
            }
        }

        // sub.l #1,%d7 / tst.l %d7 / bne -> sub.l #1,%d7 / bne: the sub sets Z and N as the tst does (C and V differ, so
        // only before beq, bne, bmi, bpl), and so do shifts and and/or/eor; a move to a data register sets them all as
        // the tst does
        bool setsZN = mn == "asr.l" || mn == "lsr.l" || mn == "lsl.l" || mn == "and.l" || mn == "or.l" || mn == "eor.l";
        if ((mn == "sub.l" || mn == "add.l" || mn == "move.l" || mn == "move.w" || mn == "move.b" || setsZN) && ops.Length == 2 &&
            ops[1].StartsWith("%d") && ops[1].Length == 3 && i + 1 < lines.Count())
        {
            string next = lines.Get(i + 1);
            string size = mn.Substring(mn.Length - 2).ToString();
            var ops2 = Operands(next);
            if (Mnemonic(next) == "tst" + size && ops2.Length == 1 && ops2[0] == ops[1])
            {
                string branch = i + 2 < lines.Count() ? Mnemonic(lines.Get(i + 2)) : "";
                bool zeroOrSign = branch == "beq" || branch == "bne" || branch == "bmi" || branch == "bpl" ||
                                  branch == "beq.s" || branch == "bne.s" || branch == "bmi.s" || branch == "bpl.s";
                if (mn.StartsWith("move") || zeroOrSign)
                {
                    lines.RemoveAt(i + 1);
                    changed = true;
                    continue;
                }
            }
        }

        // sub.l #1,%d7 / cmp.l #-1,%d7 / bne L -> dbra %d7,L, then the high word: a count down to -1 (Loops.cshift).
        // dbra counts the low word only; when it ends (at 0xffff), the high word is counted down once, and while it is
        // not -1 the loop goes on with the low word at 0xffff (65536 more rounds). At the end the register is -1 either
        // way, as after the sub.
        if (mn == "sub.l" && ops.Length == 2 && ops[0] == "#1" && ops[1].StartsWith("%d") && ops[1].Length == 3 && i + 2 < lines.Count())
        {
            string reg = ops[1];
            var cmp = Operands(lines.Get(i + 1));
            string mn3 = Mnemonic(lines.Get(i + 2));
            var target = Operands(lines.Get(i + 2));
            if (Mnemonic(lines.Get(i + 1)) == "cmp.l" && cmp.Length == 2 && cmp[1] == reg &&
                (cmp[0] == "#4294967295" || cmp[0] == "#-1") && (mn3 == "bne" || mn3 == "bne.s") && target.Length == 1)
            {
                string done = g.NewLabel();
                lines.Set(i, Instr("dbra", reg + "," + target[0]));
                lines.Set(i + 1, Instr("swap", reg));
                lines.Set(i + 2, Instr("sub.w", "#1," + reg));
                lines.Insert(i + 3, Instr("bcs.s", done));
                lines.Insert(i + 4, Instr("swap", reg));
                lines.Insert(i + 5, Instr("bra", target[0]));
                lines.Insert(i + 6, done + ":");
                changed = true;
                i += 7;
                continue;
            }
        }

        // lea (n,%sp),%sp -> addq.l #n,%sp
        if (mn == "lea" && ops.Length == 2 && ops[1] == "%sp" && ops[0].StartsWith("(") && ops[0].EndsWith(",%sp)"))
        {
            var n = TryAsmNumber(ops[0].Substring(1, ops[0].Length - 6).ToString());
            if (n is int64 v && v >= 1 && v <= 8)
            {
                lines.Set(i, Instr("addq.l", "#" + v.ToString() + ",%sp"));
                changed = true;
            }
        }
        i += 1;
    }
    return changed;
}

// A jump tower for a short counted loop (written by the dbra rule above, after a test that skips it):
//
//     bcc   exit              the test before the loop
//   L:  body                  one to three instructions, without branches, calls or the count
//     dbra  %dN,L  ...        the count of the rounds after this one (Loops.cshift), down to -1
//
// The body is copied 16 times (8 times for two or three instructions), and a count of at least that many enters the
// copies in the middle through a table: the first pass does the rounds that are left over (count & 15, plus one), every
// further pass 16 rounds for one dbra. A smaller count runs the loop as it is. A fill of a uint16[] then takes about 9
// cycles per element instead of 18.
void JumpTowers(Gen g, List<string> lines)
{
    var tables = List<string>.Create();
    for (var k = 1; k + 2 < lines.Count(); k += 1)
    {
        string label = lines.Get(k);
        if (IsInstrLine(label) || !label.EndsWith(":") || label.StartsWith("\t"))
            continue;
        string name = label.Substring(0, label.Length - 1).ToString();
        // the test before the loop falls through into it
        string before = Mnemonic(lines.Get(k - 1));
        if (!before.StartsWith("b") || before.StartsWith("bra") || before.StartsWith("bsr") || !IsBranch(before.Replace(".s", "")))
            continue;
        // the body and the dbra
        int m = 0;
        while (m < 3 && k + 1 + m < lines.Count() && IsInstrLine(lines.Get(k + 1 + m)) && !Mnemonic(lines.Get(k + 1 + m)).StartsWith("db"))
            m += 1;
        int d = k + 1 + m;
        if (m == 0 || d + 6 >= lines.Count() || Mnemonic(lines.Get(d)) != "dbra")
            continue;
        var dops = Operands(lines.Get(d));
        if (dops.Length != 2 || dops[1] != name)
            continue;
        string reg = dops[0];
        string done = lines.Get(d + 6);
        if (Mnemonic(lines.Get(d + 1)) != "swap" || Mnemonic(lines.Get(d + 5)) != "bra" || IsInstrLine(done) || !done.EndsWith(":"))
            continue;
        bool ok = !ReadsFlags(lines.Get(k + 1));
        for (var b = k + 1; b < d && ok; b += 1)
        {
            string mb = Mnemonic(lines.Get(b));
            if (mb.StartsWith("b") || mb.StartsWith("j") || mb == "rts" || mb.StartsWith("movem") || mb == "link" ||
                mb == "unlk" || mb == "trap" || Mentions(lines.Get(b), reg) || Mentions(lines.Get(b), "%sp") ||
                !ScratchWrittenFirst(lines, k + 1, d, "%d0") || !ScratchWrittenFirst(lines, k + 1, d, "%a0"))
                ok = false;
        }
        // only the test before it and the loop's own branches come here
        int refs = 0;
        foreach (var l in lines.ToArray())
        {
            if (IsInstrLine(l))
            {
                foreach (var o in Operands(l))
                {
                    if (o == name)
                        refs += 1;
                }
            }
        }
        if (!ok || refs != 2)
            continue;
        int copies = m == 1 ? 16 : 8;
        int shift = m == 1 ? 4 : 3;
        var body = List<string>.Create();
        for (var b = k + 1; b < d; b += 1)
            body.Add(lines.Get(b));
        string table = g.NewLabel();
        string towerDone = g.NewLabel();
        var copyLabels = new string[copies];
        for (var c = 0; c < copies; c += 1)
            copyLabels[c] = g.NewLabel();
        var tower = List<string>.Create();
        // a count below the copies: the loop as it is
        tower.Add(Instr("moveq", "#" + (copies - 1).ToString() + ",%d0"));
        tower.Add(Instr("cmp.l", "%d0," + reg));
        tower.Add(Instr("bls", name));
        // the entry: the copy that leaves (count & 15) + 1 rounds for the first pass
        tower.Add(Instr("and.l", reg + ",%d0"));
        tower.Add(Instr("lsl.l", "#2,%d0"));
        tower.Add(Instr("lea", table + ",%a0"));
        tower.Add(Instr("move.l", "(0,%a0,%d0.l),%a0"));
        tower.Add(Instr("lsr.l", "#" + shift.ToString() + "," + reg));
        tower.Add(Instr("jmp", "(%a0)"));
        for (var c = 0; c < copies; c += 1)
        {
            tower.Add(copyLabels[c] + ":");
            foreach (var l in body.ToArray())
                tower.Add(l);
        }
        tower.Add(Instr("dbra", reg + "," + copyLabels[0]));
        tower.Add(Instr("swap", reg));
        tower.Add(Instr("sub.w", "#1," + reg));
        tower.Add(Instr("bcs.s", towerDone));
        tower.Add(Instr("swap", reg));
        tower.Add(Instr("bra", copyLabels[0]));
        tower.Add(towerDone + ":");
        tower.Add(Instr("bra", done.Substring(0, done.Length - 1).ToString()));
        for (var t = tower.Count() - 1; t >= 0; t -= 1)
            lines.Insert(k, tower.Get(t));
        // the table: entry r starts r + 1 copies before the dbra
        var entries = List<string>.Create();
        for (var r = 0; r < copies; r += 1)
            entries.Add(copyLabels[copies - 1 - r]);
        tables.Add("\t.even");
        tables.Add(table + ":");
        tables.Add("\t.long\t" + string.Join(",", entries.ToArray()));
        k += tower.Count() + m + 7;
    }
    if (tables.Count() == 0)
        return;
    lines.Add("\t.data");
    foreach (var t in tables.ToArray())
        lines.Add(t);
    lines.Add("\t.text");
}

// whether a body does not read a scratch register before it writes it (the tower's entry uses d0 and a0); a byte or
// word written to a data register may be read with that size or less afterwards
bool ScratchWrittenFirst(List<string> lines, int from, int to, string reg)
{
    int written = 0;   // the size written, 0 before the write
    for (var i = from; i < to; i += 1)
    {
        string mn = Mnemonic(lines.Get(i));
        var ops = Operands(lines.Get(i));
        int size = mn.EndsWith(".b") ? 1 : mn.EndsWith(".w") ? 2 : 4;
        for (var k = 0; k < ops.Length; k += 1)
        {
            if (!Mentions(ops[k], reg))
                continue;
            bool write = k == ops.Length - 1 && ops[k] == reg && ops.Length == 2 && (mn.StartsWith("move") || mn == "lea");
            if (write && written == 0)
                written = reg.StartsWith("%a") || mn == "moveq" || mn == "lea" ? 4 : size;
            else if (written == 0 || size > written || (k == ops.Length - 1 && !write))
                return false;
        }
    }
    return true;
}
