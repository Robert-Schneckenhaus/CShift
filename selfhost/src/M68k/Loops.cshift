// Counted loops (Prepare.cshift, after the facts): 'for (var i = start; i < n; i += 1) ... a[i] ...'.
//
//   * Walking pointers: an element address 'a + i * size' whose array does not change in the loop gets a variable of
//     its own, set to the element of the first round before the loop and moved on by the size at the end of each
//     round. The access goes through that address register, (a3) instead of (8,a2,d1.l) after a copy and a shift of i;
//     a store or load right before the step becomes (a3)+ (Peephole.cshift). An index 'j' that steps with i (stored
//     once in the loop, in the latch, as j + 1) walks the same way; when nothing else reads j in the loop and every way
//     out of it writes j before it reads it, j's step goes.
//   * Rotation: the test of the loop is written once more at the end of the round, so a round ends in one taken
//     branch back to its start instead of a branch to the test and a branch over the exit. The test before the loop
//     stays: it skips a loop that runs no round.
//
// The loop: a header that loads i, compares it with a value from before the loop and branches into the loop or out
// of it; the header's other predecessor ends in a plain branch to it, and one block of the loop (the latch) branches
// back to it. i is a plain variable that only the latch stores, with i + 1 (an add that the facts made plain: it does
// not overflow).

namespace CShift.M68k;

using System;

struct CountedLoop
{
    int Header;
    int Pre;            // the block before the loop
    int Latch;          // the block that branches back to the header
    int Body;           // the header's target in the loop
    int Exit;
    string Counter;     // the variable i
    string Index;       // the value of i in a round (the header's load)
    int Cmp;            // the header's comparison (instruction index)
    bool[] InLoop;      // the blocks of the loop, the header included
    int Step;           // the store of i in the latch (instruction index)
}

// the instructions of a block that are written (not skipped)
List<int> LiveInsts(Gen g, IrBlock b)
{
    var live = List<int>.Create();
    var insts = b.Insts.ToArray();
    for (var k = 0; k < insts.Length; k += 1)
    {
        if (insts[k].Res.Length > 0 && g.Skip.Contains(insts[k].Res))
            continue;
        live.Add(k);
    }
    return live;
}

bool IsLocalNamed(Gen g, int vi, string name)
{
    var v = g.M.Vals.Get(vi);
    return v.Kind == ValKind.Local && v.Name == name;
}

// the counted loop whose header is block h, if it is one
Optional<CountedLoop> FindCountedLoop(Gen g, IrFunc f, Edges e, int[] idom, Dictionary<string, int> plain,
                                      Dictionary<string, int> defBlock, int h)
{
    var blocks = f.Blocks.ToArray();
    var insts = blocks[h].Insts.ToArray();
    var live = LiveInsts(g, blocks[h]);
    if (live.Count() != 3 || e.Preds[h].Count() != 2)
        return null;
    var load = insts[live.Get(0)];
    var cmp = insts[live.Get(1)];
    var br = insts[live.Get(2)];
    string counter = AccessedVariable(g, load, plain);
    if (counter.Length == 0 || g.L.Size(load.Type) != 4 || g.T.Kind(load.Type) != IrKind.Int)
        return null;
    if (cmp.Op != "icmp" || cmp.Args.Length != 2 || !IsLocalNamed(g, cmp.Args[0], load.Res))
        return null;
    if (br.Op != "br" || br.Labels.Length != 2 || br.Args.Length != 1 || !IsLocalNamed(g, br.Args[0], cmp.Res))
        return null;
    var bodyAt = e.Index.TryGet(br.Labels[0]);
    var exitAt = e.Index.TryGet(br.Labels[1]);
    if (bodyAt is not int body)
        return null;
    if (exitAt is not int exit)
        return null;
    if (body == h || exit == h)
        return null;
    // the latch: the predecessor that the header dominates (the branch back); the loop: the blocks from which it is
    // reached without passing the header
    int pre = -1;
    int latch = -1;
    foreach (var p in e.Preds[h].ToArray())
    {
        if (p != h && Dominates(idom, h, p))
            latch = p;
        else
            pre = p;
    }
    if (pre < 0 || latch < 0)
        return null;
    var inLoop = NaturalLoop(e, h, latch);
    if (!inLoop[body] || inLoop[exit] || inLoop[pre])
        return null;
    // the bound: a constant or a value from before the loop
    var bound = g.M.Vals.Get(cmp.Args[1]);
    if (bound.Kind == ValKind.Local && (!defBlock.ContainsKey(bound.Name) || (defBlock.Get(bound.Name) >= 0 && inLoop[defBlock.Get(bound.Name)])))
        return null;
    if (bound.Kind != ValKind.Local && bound.Kind != ValKind.Int)
        return null;
    // the block before the loop and the latch end in a plain branch to the header
    foreach (var j in [pre, latch])
    {
        var bi = blocks[j].Insts;
        if (bi.Count() == 0)
            return null;
        var last = bi.Get(bi.Count() - 1);
        if (last.Op != "br" || last.Labels.Length != 1)
            return null;
    }
    // i: stored once in the loop, in the latch, with i + 1
    int step = -1;
    for (var j = 0; j < blocks.Length; j += 1)
    {
        if (!inLoop[j])
            continue;
        var bi = blocks[j].Insts.ToArray();
        foreach (var k in LiveInsts(g, blocks[j]))
        {
            if (bi[k].Op != "store" || AccessedVariable(g, bi[k], plain) != counter)
                continue;
            if (j != latch || step >= 0)
                return null;
            step = k;
        }
    }
    if (step < 0)
        return null;
    var latchInsts = blocks[latch].Insts.ToArray();
    var stored = g.M.Vals.Get(latchInsts[step].Args[0]);
    if (stored.Kind != ValKind.Local)
        return null;
    bool plusOne = false;
    foreach (var k in LiveInsts(g, blocks[latch]))
    {
        var inst = latchInsts[k];
        int64 c = 0;
        if (inst.Res == stored.Name && inst.Op == "add" && inst.Args.Length == 2 && IsLocalNamed(g, inst.Args[0], load.Res) &&
            ConstInt(g, inst.Args[1], ref c) && c == 1 && k < step)
            plusOne = true;
    }
    if (!plusOne)
        return null;
    return CountedLoop { Header = h, Pre = pre, Latch = latch, Body = body, Exit = exit, Counter = counter, Index = load.Res,
                         Cmp = live.Get(1), InLoop = inLoop, Step = step };
}

// the blocks of the loop of the branch back from 'latch' to 'header': the header, and the blocks that reach the latch
// without passing it
bool[] NaturalLoop(Edges e, int header, int latch)
{
    var inLoop = new bool[e.Succs.Length];
    inLoop[header] = true;
    inLoop[latch] = true;
    var work = List<int>.Create();
    work.Add(latch);
    while (work.Count() > 0)
    {
        int b = work.Get(work.Count() - 1);
        work.RemoveAt(work.Count() - 1);
        foreach (var p in e.Preds[b].ToArray())
        {
            if (!inLoop[p])
            {
                inLoop[p] = true;
                work.Add(p);
            }
        }
    }
    return inLoop;
}

// the block that defines each value
Dictionary<string, int> DefinitionBlocks(IrFunc f)
{
    var def = Dictionary<string, int>.Create();
    var blocks = f.Blocks.ToArray();
    for (var j = 0; j < blocks.Length; j += 1)
    {
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            if (inst.Res.Length > 0)
                def.Set(inst.Res, j);
        }
    }
    foreach (var p in f.Params)
        def.Set(p.Name, -1);
    return def;
}

// ---------------------------------------------------------------------------
// Walking pointers
// ---------------------------------------------------------------------------

// an element address of the loop: 'getelementptr T, base, i'
struct WalkedAddress
{
    int Block;
    int At;
    string Res;
}

struct PointerWalk
{
    int Base;           // the array's data pointer: a value from before the loop, or 'gep i8, v, c' of one in the loop
    int ElemType;
    List<WalkedAddress> Addresses;
    string Index;       // the variable of the index: i, or one that steps with it
}

// whether a value does not change in the loop: from before it, a global, a constant
bool InvariantValue(Gen g, CountedLoop loop, Dictionary<string, int> defBlock, int vi)
{
    var v = g.M.Vals.Get(vi);
    if (v.Kind != ValKind.Local)
        return v.Kind == ValKind.Global || v.Kind == ValKind.Int || v.Kind == ValKind.Null;
    var at = defBlock.TryGet(v.Name);
    return at is int j && (j < 0 || !loop.InLoop[j]);
}

void WalkPointers(Gen g, IrFunc f)
{
    var plain = PlainVariables(g, f);
    if (plain.Count() == 0)
        return;
    var e = BlockEdges(f);
    var defBlock = DefinitionBlocks(f);
    int n = f.Blocks.Count();
    int walks = 0;
    for (var h = 0; h < n; h += 1)
    {
        if (FindCountedLoop(g, f, e, Dominators(f), plain, defBlock, h) is not CountedLoop loop)
            continue;
        var blocks = f.Blocks.ToArray();
        // the definitions in the loop and the uses of each value (inside the loop: in which block, at which point)
        var defs = Dictionary<string, IrInst>.Create();
        var usesOutside = HashSet<string>.Create();
        var lastUseInLatch = Dictionary<string, int>.Create();
        for (var j = 0; j < n; j += 1)
        {
            var bi = blocks[j].Insts.ToArray();
            foreach (var k in LiveInsts(g, blocks[j]))
            {
                var inst = bi[k];
                if (loop.InLoop[j] && inst.Res.Length > 0)
                    defs.Set(inst.Res, inst);
                foreach (var a in inst.Args)
                {
                    var v = g.M.Vals.Get(a);
                    if (v.Kind != ValKind.Local)
                        continue;
                    if (!loop.InLoop[j])
                        usesOutside.Add(v.Name);
                    else if (j == loop.Latch)
                        lastUseInLatch.Set(v.Name, k);
                }
                if (inst.Callee >= 0 && g.M.Vals.Get(inst.Callee).Kind == ValKind.Local)
                    usesOutside.Add(g.M.Vals.Get(inst.Callee).Name);
            }
        }
        // variables that step with i: stored once in the loop, in the latch, with one of their loads in the loop + 1;
        // an element address by a load of one before its step walks as well (from its value before the loop)
        var follows = Dictionary<string, string>.Create();   // such a load -> its variable
        var stepAt = Dictionary<string, int>.Create();
        var storesInLoop = Dictionary<string, int>.Create();
        for (var j = 0; j < n; j += 1)
        {
            if (!loop.InLoop[j])
                continue;
            var bi = blocks[j].Insts.ToArray();
            foreach (var k in LiveInsts(g, blocks[j]))
            {
                string name = AccessedVariable(g, bi[k], plain);
                if (bi[k].Op == "store" && name.Length > 0)
                    storesInLoop.Set(name, storesInLoop.GetOrDefault(name, 0) + 1);
            }
        }
        var latchInsts = blocks[loop.Latch].Insts.ToArray();
        foreach (var k in LiveInsts(g, blocks[loop.Latch]))
        {
            var inst = latchInsts[k];
            string name = AccessedVariable(g, inst, plain);
            if (inst.Op != "store" || name.Length == 0 || name == loop.Counter || storesInLoop.GetOrDefault(name, 0) != 1)
                continue;
            var stored = g.M.Vals.Get(inst.Args[0]);
            int64 c = 0;
            if (stored.Kind != ValKind.Local || !defs.ContainsKey(stored.Name))
                continue;
            var add = defs.Get(stored.Name);
            if (add.Op != "add" || add.Args.Length != 2 || !ConstInt(g, add.Args[1], ref c) || c != 1)
                continue;
            var from = g.M.Vals.Get(add.Args[0]);
            if (from.Kind != ValKind.Local || !defs.ContainsKey(from.Name))
                continue;
            var ld = defs.Get(from.Name);
            if (ld.Op != "load" || AccessedVariable(g, ld, plain) != name)
                continue;
            stepAt.Set(name, k);
        }
        for (var j = 0; j < n; j += 1)
        {
            if (!loop.InLoop[j])
                continue;
            var bi = blocks[j].Insts.ToArray();
            foreach (var k in LiveInsts(g, blocks[j]))
            {
                string name = AccessedVariable(g, bi[k], plain);
                if (bi[k].Op == "load" && stepAt.ContainsKey(name) && (j != loop.Latch || k < stepAt.Get(name)))
                    follows.Set(bi[k].Res, name);
            }
        }
        // the element addresses, grouped by array, element type and index
        var groups = List<PointerWalk>.Create();
        var groupKeys = List<string>.Create();
        for (var j = 0; j < n; j += 1)
        {
            if (!loop.InLoop[j])
                continue;
            var bi = blocks[j].Insts.ToArray();
            foreach (var k in LiveInsts(g, blocks[j]))
            {
                var inst = bi[k];
                if (inst.Op != "getelementptr" || inst.Args.Length != 2 || g.M.Vals.Get(inst.Args[1]).Kind != ValKind.Local)
                    continue;
                string indexName = g.M.Vals.Get(inst.Args[1]).Name;
                string indexVar = indexName == loop.Index ? loop.Counter : follows.GetOrDefault(indexName, "");
                if (indexVar.Length == 0)
                    continue;
                int stride = g.L.Stride(inst.OpType);
                if (stride <= 0 || stride > 32767 || usesOutside.Contains(inst.Res))
                    continue;
                if (j == loop.Latch && lastUseInLatch.GetOrDefault(inst.Res, -1) > loop.Step)
                    continue;
                int baseVal = inst.Args[0];
                if (!InvariantValue(g, loop, defBlock, baseVal))
                {
                    // the data of an array: 'gep i8, v, c' in the loop with v from before it
                    var bv = g.M.Vals.Get(baseVal);
                    if (bv.Kind != ValKind.Local)
                        continue;
                    if (defs.TryGet(bv.Name) is not IrInst inner)
                        continue;
                    int64 c = 0;
                    if (inner.Op != "getelementptr" || inner.Args.Length != 2 || !ConstInt(g, inner.Args[1], ref c) ||
                        !InvariantValue(g, loop, defBlock, inner.Args[0]))
                        continue;
                }
                // (the same array in different blocks of the loop: one walk; 'gep i8, v, c' by v and c)
                string key = ValueKey(g, baseVal);
                var bk = g.M.Vals.Get(baseVal);
                if (bk.Kind == ValKind.Local && defs.TryGet(bk.Name) is IrInst data)
                    key = ValueKey(g, data.Args[0]) + "+" + ValueKey(g, data.Args[1]) + "*" + g.L.Stride(data.OpType).ToString();
                if (key.Length == 0 || key.StartsWith("+"))
                    key = "@" + baseVal.ToString();
                key = key + ":" + inst.OpType.ToString() + "@" + indexVar;
                int gi = groupKeys.IndexOf(key);
                if (gi < 0)
                {
                    groupKeys.Add(key);
                    groups.Add(PointerWalk { Base = baseVal, ElemType = inst.OpType, Addresses = List<WalkedAddress>.Create(),
                                             Index = indexVar });
                    gi = groups.Count() - 1;
                }
                groups.Get(gi).Addresses.Add(WalkedAddress { Block = j, At = k, Res = inst.Res });
            }
        }
        if (groups.Count() == 0)
            continue;
        // the code before the loop: i's value, and per array the address of its element of the first round
        var pre = blocks[loop.Pre].Insts;
        var preBranch = pre.Get(pre.Count() - 1);
        pre.RemoveAt(pre.Count() - 1);
        var entry = blocks[0].Insts;
        string tag = "walk" + h.ToString();
        int i32 = g.T.I32;
        int ptr = g.T.Ptr;
        int counterFirst = g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = tag + ".i" });
        pre.Add(LoopInst("load", tag + ".i", i32, i32, [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = loop.Counter })]));
        // i's start, when the block before the loop stores a constant into it ('var i = 0')
        bool counterHasStart = false;
        int64 start = 0;
        foreach (var inst in pre.ToArray())
        {
            if (inst.Op == "store" && AccessedVariable(g, inst, plain) == loop.Counter)
                counterHasStart = ConstInt(g, inst.Args[0], ref start);
        }
        var steps = List<IrInst>.Create();
        for (var gi = 0; gi < groups.Count(); gi += 1)
        {
            var walk = groups.Get(gi);
            string name = tag + "." + gi.ToString();
            int variable = g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = name });
            entry.Insert(0, LoopInst("alloca", name, ptr, ptr, new int[0]));
            // (an index that steps with i: its own value before the loop)
            int first = counterFirst;
            bool hasStart = counterHasStart;
            if (walk.Index != loop.Counter)
            {
                pre.Add(LoopInst("load", name + ".i", i32, i32, [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = walk.Index })]));
                first = g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = name + ".i" });
                hasStart = false;
            }
            // the address of the first round's element: base + start * size, where the base may be 'v + c' (the data of
            // an array, computed in the loop) and the start a constant stored right before the loop; without a known
            // start, (v + c) + i * size (a lea and an add, not i + c through a register of its own)
            int baseVal = walk.Base;
            int stride = g.L.Stride(walk.ElemType);
            int64 offset = 0;
            var bv = g.M.Vals.Get(baseVal);
            if (bv.Kind == ValKind.Local && defs.TryGet(bv.Name) is IrInst inner)
            {
                ConstInt(g, inner.Args[1], ref offset);
                offset *= (int64)g.L.Stride(inner.OpType);
                baseVal = inner.Args[0];
            }
            if (hasStart && offset % (int64)stride != 0)
                pre.Add(LoopInst("getelementptr", name + ".first", ptr, g.T.I8,
                                 [baseVal, g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = start * (int64)stride + offset })]));
            else if (hasStart || offset == 0)
            {
                int index = first;
                if (hasStart)
                    index = g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = start + offset / (int64)stride });
                pre.Add(LoopInst("getelementptr", name + ".first", ptr, walk.ElemType, [baseVal, index]));
            }
            else
            {
                pre.Add(LoopInst("getelementptr", name + ".data", ptr, g.T.I8, [baseVal, g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = offset })]));
                pre.Add(LoopInst("getelementptr", name + ".first", ptr, walk.ElemType,
                                 [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = name + ".data" }), first]));
            }
            pre.Add(LoopInst("store", "", g.T.Void, ptr,
                             [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = name + ".first" }), variable]));
            // the addresses in the loop: the variable's value
            foreach (var a in walk.Addresses)
            {
                var bi = f.Blocks.Get(a.Block).Insts;
                bi.Set(a.At, LoopInst("load", a.Res, ptr, ptr, [variable]));
            }
            // the step at the end of the round (an access before it becomes (a3)+: Peephole.cshift)
            steps.Add(LoopInst("load", name + ".cur", ptr, ptr, [variable]));
            steps.Add(LoopInst("getelementptr", name + ".next", ptr, walk.ElemType,
                               [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = name + ".cur" }),
                                g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = 1 })]));
            steps.Add(LoopInst("store", "", g.T.Void, ptr,
                               [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = ptr, Name = name + ".next" }), variable]));
            walks += 1;
        }
        pre.Add(preBranch);
        var latch = f.Blocks.Get(loop.Latch).Insts;
        for (var st = steps.Count() - 1; st >= 0; st -= 1)
            latch.Insert(loop.Step, steps.Get(st));
        // a variable that steps with i whose element addresses walk now: when nothing else reads it in the loop and it
        // is written before it is read after the loop, its step goes (it needs no register in the loop)
        var followers = HashSet<string>.Create();
        foreach (var walk in groups.ToArray())
        {
            if (walk.Index != loop.Counter)
                followers.Add(walk.Index);
        }
        foreach (var v in followers.ToArray())
            DropStep(g, f, loop, plain, v);
        // (the variables are new: the next loop sees them, and the blocks' indices stay the same)
        plain = PlainVariables(g, f);
        defBlock = DefinitionBlocks(f);
        e = BlockEdges(f);
    }
}

// The step 'v = v + 1' of a variable in the latch, where the step's load and add are used by nothing else and every
// way out of the loop writes v before it reads it: removed.
void DropStep(Gen g, IrFunc f, CountedLoop loop, Dictionary<string, int> plain, string v)
{
    var blocks = f.Blocks.ToArray();
    var uses = Dictionary<string, int>.Create();
    foreach (var b in blocks)
    {
        foreach (var inst in b.Insts.ToArray())
        {
            if (inst.Res.Length > 0 && g.Skip.Contains(inst.Res))
                continue;
            foreach (var a in inst.Args)
            {
                var val = g.M.Vals.Get(a);
                if (val.Kind == ValKind.Local)
                    uses.Set(val.Name, uses.GetOrDefault(val.Name, 0) + 1);
            }
            if (inst.Callee >= 0 && g.M.Vals.Get(inst.Callee).Kind == ValKind.Local)
                uses.Set(g.M.Vals.Get(inst.Callee).Name, uses.GetOrDefault(g.M.Vals.Get(inst.Callee).Name, 0) + 1);
        }
    }
    // the loads of v in the loop: each used only by the step's add, which only the step uses
    var latch = blocks[loop.Latch].Insts.ToArray();
    int store = -1;
    string addRes = "";
    string loadRes = "";
    for (var k = 0; k < latch.Length; k += 1)
    {
        if (latch[k].Op == "store" && AccessedVariable(g, latch[k], plain) == v)
        {
            store = k;
            var stored = g.M.Vals.Get(latch[k].Args[0]);
            if (stored.Kind == ValKind.Local)
                addRes = stored.Name;
        }
    }
    if (store < 0 || addRes.Length == 0 || uses.GetOrDefault(addRes, 0) != 1)
        return;
    for (var j = 0; j < blocks.Length; j += 1)
    {
        if (!loop.InLoop[j])
            continue;
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            if (inst.Res == addRes && inst.Args.Length == 2 && g.M.Vals.Get(inst.Args[0]).Kind == ValKind.Local)
                loadRes = g.M.Vals.Get(inst.Args[0]).Name;
        }
    }
    if (loadRes.Length == 0 || uses.GetOrDefault(loadRes, 0) != 1)
        return;
    for (var j = 0; j < blocks.Length; j += 1)
    {
        if (!loop.InLoop[j])
            continue;
        foreach (var inst in blocks[j].Insts.ToArray())
        {
            if (inst.Op == "load" && AccessedVariable(g, inst, plain) == v && inst.Res != loadRes &&
                !(inst.Res.Length > 0 && g.Skip.Contains(inst.Res)) && uses.GetOrDefault(inst.Res, 0) > 0)
                return;
        }
    }
    // after the loop (every way out of it): written before read
    var e = BlockEdges(f);
    var seen = new bool[blocks.Length];
    var work = List<int>.Create();
    for (var j = 0; j < blocks.Length; j += 1)
    {
        if (!loop.InLoop[j])
            continue;
        foreach (var next in e.Succs[j].ToArray())
        {
            if (!loop.InLoop[next] && !seen[next])
            {
                seen[next] = true;
                work.Add(next);
            }
        }
    }
    while (work.Count() > 0)
    {
        int b = work.Get(work.Count() - 1);
        work.RemoveAt(work.Count() - 1);
        bool written = false;
        foreach (var inst in blocks[b].Insts.ToArray())
        {
            if (AccessedVariable(g, inst, plain) != v || (inst.Res.Length > 0 && g.Skip.Contains(inst.Res)))
                continue;
            if (inst.Op == "load")
                return;
            written = true;
            break;
        }
        if (written)
            continue;
        foreach (var s in e.Succs[b].ToArray())
        {
            if (!seen[s])
            {
                seen[s] = true;
                work.Add(s);
            }
        }
    }
    f.Blocks.Get(loop.Latch).Insts.RemoveAt(store);
    g.Skip.Add(addRes);
    g.Skip.Add(loadRes);
}

IrInst LoopInst(string op, string res, int type, int opType, int[] args)
{
    return IrInst { Op = op, Res = res, Type = type, OpType = opType, Args = args, Pred = "", Labels = new string[0],
                    Cases = new int64[0], Callee = -1, Volatile = false };
}

// ---------------------------------------------------------------------------
// Rotation
// ---------------------------------------------------------------------------

void RotateLoops(Gen g, IrFunc f)
{
    var plain = PlainVariables(g, f);
    if (plain.Count() == 0)
        return;
    int n = f.Blocks.Count();
    for (var h = 0; h < n; h += 1)
    {
        var e = BlockEdges(f);
        var defBlock = DefinitionBlocks(f);
        if (FindCountedLoop(g, f, e, Dominators(f), plain, defBlock, h) is not CountedLoop loop)
            continue;
        var blocks = f.Blocks.ToArray();
        // the loop's start has only the header before it, and no phis there or at the exit
        if (e.Preds[loop.Body].Count() != 1 || HasPhis(blocks[loop.Body]) || HasPhis(blocks[loop.Exit]))
            continue;
        // the uses of i's value outside the header: all where the start of the loop dominates them
        var idom = Dominators(f);
        bool ok = true;
        for (var j = 0; j < n && ok; j += 1)
        {
            if (j == h)
                continue;
            foreach (var inst in blocks[j].Insts.ToArray())
            {
                foreach (var a in inst.Args)
                {
                    if (IsLocalNamed(g, a, loop.Index) && !Dominates(idom, loop.Body, j))
                        ok = false;
                }
            }
        }
        if (!ok)
            continue;
        var header = blocks[h].Insts.ToArray();
        var cmp = header[loop.Cmp];
        int counterVal = header[LiveInsts(g, blocks[h]).Get(0)].Args[0];
        string tag = "rot" + h.ToString();
        int i32 = g.T.I32;
        int counts = CountsOnly(g, f, loop, plain);
        bool countsOnly = counts > 0;
        // the start of the round loads i (the header's value is the one of the first round only)
        int index = g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = tag + ".i" });
        for (var j = 0; j < n; j += 1)
        {
            if (j != h)
                ReplaceUses(g, f.Blocks.Get(j), loop.Index, index);
        }
        f.Blocks.Get(loop.Body).Insts.Insert(0, LoopInst("load", tag + ".i", i32, i32, [counterVal]));
        var latch = f.Blocks.Get(loop.Latch).Insts;
        if (countsOnly)
        {
            // i only counts the rounds: a count of the rounds left after this one instead, set by the test before the
            // loop (i < n there, so it is n - i - 1 >= 0; as an unsigned number it is right even where n - i does not fit
            // into an int), and down by one at the end of each round, until it is -1: that is dbra (Peephole.cshift). i
            // is not stored any more.
            string count = tag + ".count";
            int countVar = g.M.AddVal(IrVal { Kind = ValKind.Local, Type = g.T.Ptr, Name = count });
            f.Blocks.Get(0).Insts.Insert(0, LoopInst("alloca", count, g.T.Ptr, i32, new int[0]));
            // (before the comparison, which stays right before its branch)
            var guard = f.Blocks.Get(h).Insts;
            guard.Insert(loop.Cmp, LoopInst("store", "", g.T.Void, i32,
                                            [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = count + ".first" }), countVar]));
            guard.Insert(loop.Cmp, LoopInst("sub", count + ".first", i32, i32,
                                            [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = count + ".rounds" }),
                                             g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = 1 })]));
            guard.Insert(loop.Cmp, LoopInst("sub", count + ".rounds", i32, i32,
                                            [cmp.Args[1], g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = loop.Index })]));
            latch.RemoveAt(latch.Count() - 1);
            latch.RemoveAt(loop.Body == loop.Latch ? loop.Step + 1 : loop.Step); // (after the load at the start)
            latch.Add(LoopInst("load", count + ".cur", i32, i32, [countVar]));
            latch.Add(LoopInst("sub", count + ".left", i32, i32,
                               [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = count + ".cur" }),
                                g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = 1 })]));
            int left = g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = count + ".left" });
            latch.Add(LoopInst("store", "", g.T.Void, i32, [left, countVar]));
            // (the count read again: the new count is computed in the variable's register, Regalloc.cshift)
            latch.Add(LoopInst("load", count + ".test", i32, i32, [countVar]));
            var more = LoopInst("icmp", tag + ".more", g.T.I1, i32,
                                [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = count + ".test" }),
                                 g.M.AddVal(IrVal { Kind = ValKind.Int, Type = i32, Int = -1 })]);
            more.Pred = "ne";
            latch.Add(more);
            var loopBranch = LoopInst("br", "", g.T.Void, g.T.I1, [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = g.T.I1, Name = tag + ".more" })]);
            loopBranch.Labels = [blocks[loop.Body].Label, counts == 2 ? tag + ".done" : blocks[loop.Exit].Label];
            latch.Add(loopBranch);
            if (counts == 2)
            {
                // i is read after the loop: when the rounds are over it is n (the loop ends only by its test, i < n
                // held when it began, and it steps by one); a block on the way out stores that
                string done = tag + ".done";
                var doneInsts = List<IrInst>.Create();
                doneInsts.Add(LoopInst("store", "", g.T.Void, i32, [cmp.Args[1], counterVal]));
                var toExit = LoopInst("br", "", g.T.Void, g.T.Void, new int[0]);
                toExit.Labels = [blocks[loop.Exit].Label];
                doneInsts.Add(toExit);
                f.Blocks.Insert(loop.Latch + 1, IrBlock { Label = done, Insts = doneInsts });
                n += 1;
            }
            continue;
        }
        // the end of the round: the test once more
        latch.RemoveAt(latch.Count() - 1);
        latch.Add(LoopInst("load", tag + ".next", i32, i32, [counterVal]));
        var test = LoopInst("icmp", tag + ".more", g.T.I1, cmp.OpType,
                            [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = i32, Name = tag + ".next" }), cmp.Args[1]]);
        test.Pred = cmp.Pred;
        latch.Add(test);
        var br = LoopInst("br", "", g.T.Void, g.T.I1, [g.M.AddVal(IrVal { Kind = ValKind.Local, Type = g.T.I1, Name = tag + ".more" })]);
        br.Labels = [blocks[loop.Body].Label, blocks[loop.Exit].Label];
        latch.Add(br);
    }
}

// whether i only counts the rounds of 'i < n' (signed or unsigned): its value in the loop is only compared and stepped,
// and nothing in the loop reads the variable but the header. 1: nothing reads it after the loop either (but the block
// before the loop, after it stored i's start there); 2: blocks after the loop read it, and the loop ends only by its
// test (no other way out of it but to a panic), so that i is n then; 0: neither.
int CountsOnly(Gen g, IrFunc f, CountedLoop loop, Dictionary<string, int> plain)
{
    var header = f.Blocks.Get(loop.Header).Insts.ToArray();
    var cmp = header[loop.Cmp];
    if (cmp.Pred != "slt" && cmp.Pred != "ult")
        return 0;
    var latch = f.Blocks.Get(loop.Latch).Insts.ToArray();
    string next = g.M.Vals.Get(latch[loop.Step].Args[0]).Name;
    var blocks = f.Blocks.ToArray();
    bool readAfter = false;
    for (var j = 0; j < blocks.Length; j += 1)
    {
        var insts = blocks[j].Insts.ToArray();
        bool stored = false;   // (in the block before the loop: i got its start value)
        foreach (var k in LiveInsts(g, blocks[j]))
        {
            var inst = insts[k];
            if (inst.Op == "store" && AccessedVariable(g, inst, plain) == loop.Counter)
                stored = true;
            if (inst.Op == "load" && AccessedVariable(g, inst, plain) == loop.Counter && j != loop.Header &&
                !(j == loop.Pre && stored))
            {
                if (loop.InLoop[j])
                    return 0;
                readAfter = true;
            }
            bool step = j == loop.Latch && inst.Res == next;
            bool test = j == loop.Header && k == loop.Cmp;
            foreach (var a in inst.Args)
            {
                if (IsLocalNamed(g, a, loop.Index) && !step && !test)
                    return 0;
                if (IsLocalNamed(g, a, next) && !(j == loop.Latch && k == loop.Step))
                    return 0;
            }
        }
    }
    if (!readAfter)
        return 1;
    // the ways out of the loop: the header's test, or a block that ends in unreachable (a panic); a break to the exit
    // would leave i at the round's value
    var e = BlockEdges(f);
    for (var j = 0; j < blocks.Length; j += 1)
    {
        if (!loop.InLoop[j])
            continue;
        foreach (var s in e.Succs[j].ToArray())
        {
            if (loop.InLoop[s] || (s == loop.Exit && j == loop.Header))
                continue;
            var si = blocks[s].Insts;
            if (si.Count() == 0 || si.Get(si.Count() - 1).Op != "unreachable")
                return 0;
        }
    }
    return 2;
}

bool HasPhis(IrBlock b)
{
    foreach (var inst in b.Insts.ToArray())
    {
        if (inst.Op == "phi")
            return true;
    }
    return false;
}
