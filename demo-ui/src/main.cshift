// demo-ui: the widgets of System.Ui in a small to-do list. The state of the program is the struct App; Draw describes
// the window for it, every frame, and changes it where the user did something. It has a menu bar, a combo box, a
// context menu (the right mouse button on a task), modal dialogs (before removing the done tasks, and before quitting
// with open tasks: also when the window is closed), a number box, tooltips and an animation (Ui.RequestFrame).

using System;
using System.Image;
using System.Ui;

struct Task
{
    string Title;
    bool Done;
    int Priority;        // an index into Priorities
    int Days;            // due in so many days
}

struct App
{
    List<Task> Tasks;
    string NewTitle;
    int Selected;
    int Filter;          // 0 all, 1 open, 2 done
    bool Dark;
    double Zoom;         // the scale of the ui, relative to the screen's
    List<string> Priorities;
    int NewPriority;
    int NewDays;
    int MenuTask;        // the task whose context menu is open
    bool Confirm;        // the dialog before "Remove done" is shown
    bool ConfirmQuit;    // the dialog before quitting with open tasks is shown
    int FileMode;        // the file dialog that is shown: 0 none, 1 import tasks, 2 export them
    string FilePath;     // the file of the last import or export
    string Message;      // what the last import or export did
    bool Busy;           // the spinner turns
    Image Icon;          // two tiles of 16 x 16 pixels (a checked and an open box), drawn twice as large
    bool Quit;
}

void SetDark(Ui ui, ref App app, bool dark)
{
    app.Dark = dark;
    ui.SetTheme(app.Dark ? Theme.Dark() : Theme.Light());
}

// Adds the tasks of a text file (one per line, "[x] " before a done one); tells what it did.
string ImportTasks(ref App app)
{
    var read = File.ReadAllText(app.FilePath);
    if (read is not string text)
        return "Cannot read " + app.FilePath;
    int count = 0;
    foreach (var line in text.Split('\n'))
    {
        var title = line.Trim();
        bool done = title.StartsWith("[x] ");
        if (done)
            title = title[4..].Trim();
        if (title.Length == 0)
            continue;
        app.Tasks.Add(Task { Title = title.ToString(), Done = done, Priority = 1 });
        count += 1;
    }
    return $"{count} tasks imported";
}

// Writes the tasks into a text file (in the browser: a download).
string ExportTasks(ref App app)
{
    var sb = StringBuilder.Create();
    foreach (var task in app.Tasks)
        sb.Append((task.Done ? "[x] " : "") + task.Title + "\n");
    if (File.WriteAllText(app.FilePath, sb.ToString()) is error e)
        return "Cannot write " + app.FilePath;
    return $"{app.Tasks.Count()} tasks exported to {Path.GetFileName(app.FilePath)}";
}

// The icon: a box with a check mark and an empty box, side by side, with transparent corners (16 x 16 each).
Image MakeIcon()
{
    var image = Image.Create(32, 16);
    var frame = Color.FromRgb(40, 90, 160);
    var inside = Color.FromRgb(230, 238, 250);
    var check = Color.FromRgb(30, 150, 60);
    for (var tile = 0; tile < 2; tile += 1)
    {
        int ox = tile * 16;
        for (var y = 1; y < 15; y += 1)
        {
            for (var x = 1; x < 15; x += 1)
            {
                bool corner = (x == 1 || x == 14) && (y == 1 || y == 14);
                if (!corner)
                    image.SetPixel(ox + x, y, x <= 2 || x >= 13 || y <= 2 || y >= 13 ? frame : inside);
            }
        }
    }
    // the check mark in the first tile
    int[] marks = [4, 8, 5, 9, 6, 10, 7, 9, 8, 8, 9, 7, 10, 6, 11, 5];
    for (var i = 0; i < marks.Length; i += 2)
    {
        image.SetPixel(marks[i], marks[i + 1], check);
        image.SetPixel(marks[i], marks[i + 1] - 1, check);
    }
    return image;
}

// quits at once when all tasks are done, else asks first
void AskQuit(ref App app)
{
    foreach (var task in app.Tasks)
    {
        if (!task.Done)
        {
            app.ConfirmQuit = true;
            return;
        }
    }
    app.Quit = true;
}

// a spinner: eight dots around a circle, the bright one moves on every 125 ms
void Spinner(Ui ui)
{
    var r = ui.Area(24, 24);
    var theme = ui.GetTheme();
    int step = (int)(ui.Input().Time * 8.0) % 8;
    int cx = r.X + r.Width / 2;
    int cy = r.Y + r.Height / 2;
    int[] dx = [0, 6, 8, 6, 0, -6, -8, -6];
    int[] dy = [-8, -6, 0, 6, 8, 6, 0, -6];
    for (var i = 0; i < 8; i += 1)
    {
        var color = i == step ? theme.Focus : theme.Border;
        int d = Math.Max(2, r.Width / 6); // the size of a dot: the area is scaled with the Ui
        ui.FillRect(Rect.Create(cx + dx[i] * r.Width / 24 - d / 2, cy + dy[i] * r.Height / 24 - d / 2, d, d), color);
    }
    ui.RequestFrame(125); // the next step, without input
}

void Draw(Ui ui, ref App app)
{
    // the keys of the menus (the menu bar only shows them): shortcuts with the modifier keys held at the key press,
    // so a quick Ctrl+Q works also when the frame comes after Ctrl was let go (+ may need Shift, depending on the
    // keyboard)
    var input = ui.Input();
    if (input.Pressed(Key.Plus, KeyModifiers.Ctrl) || input.Pressed(Key.Plus, KeyModifiers.Ctrl | KeyModifiers.Shift))
        app.Zoom = Math.Min(2.0, app.Zoom + 0.25);
    if (input.Pressed(Key.Minus, KeyModifiers.Ctrl))
        app.Zoom = Math.Max(0.75, app.Zoom - 0.25);
    using (ui.MenuBar())
    {
        using (ui.Menu("File"))
        {
            if (ui.MenuItem("Import tasks..."))
                app.FileMode = 1;
            if (ui.MenuItem("Export tasks..."))
                app.FileMode = 2;
            if (ui.MenuItem("Remove done..."))
                app.Confirm = true;
            if (ui.MenuItem("Quit", "Ctrl+Q"))
                AskQuit(ref app);
        }
        using (ui.Menu("View"))
        {
            if (ui.MenuItem(app.Dark ? "Light theme" : "Dark theme"))
                SetDark(ui, ref app, !app.Dark);
            if (ui.MenuItem("Zoom in", "Ctrl++"))
                app.Zoom = Math.Min(2.0, app.Zoom + 0.25);
            if (ui.MenuItem("Zoom out", "Ctrl+-"))
                app.Zoom = Math.Max(0.75, app.Zoom - 0.25);
        }
    }
    // Ctrl+Q, and closing the window (Window.ConfirmClose is on)
    if (input.Pressed(Key.Q, KeyModifiers.Ctrl) || input.CloseRequested)
        AskQuit(ref app);

    int done = 0;
    foreach (var task in app.Tasks)
    {
        if (task.Done)
            done += 1;
    }

    using (ui.Row())
    {
        // a part of an image (one tile of two), scaled: on AmigaOS in the pens of the screen
        var icon = ui.Area(32, 32);
        bool all = done == app.Tasks.Count();
        ui.DrawImage(app.Icon, Rect.Create(all ? 0 : 16, 0, 16, 16), icon);
        ui.Label("To do");
        ui.Note($"{done} of {app.Tasks.Count()} done");
    }
    ui.ProgressBar(app.Tasks.Count() > 0 ? (double)done / (double)app.Tasks.Count() : 0.0);

    // a new task: Enter in the text box or the button
    using (ui.Row())
    {
        ui.TextBox("new", ref app.NewTitle);
        bool add = ui.Button("Add") || ui.Submitted("new");
        ui.Tooltip("Adds the task (Enter in the text box does too)");
        if (add && app.NewTitle.Trim().Length > 0)
        {
            app.Tasks.Add(Task { Title = app.NewTitle.Trim().ToString(), Priority = app.NewPriority, Days = app.NewDays });
            app.NewTitle = "";
            ui.SetFocus("new");
        }
    }
    using (ui.Row())
    {
        using (ui.Column(150))
        {
            ui.ComboBox("priority", ref app.NewPriority, app.Priorities);
        }
        ui.Label("due in");
        using (ui.Column(70))
        {
            ui.IntBox("days", ref app.NewDays, 0, 365);
        }
        ui.Label("days");
    }

    using (ui.Row())
    {
        ui.Radio("All", ref app.Filter, 0);
        ui.Radio("Open", ref app.Filter, 1);
        ui.Radio("Done", ref app.Filter, 2);
    }

    using (ui.Scroll("tasks", 180))
    {
        for (var i = 0; i < app.Tasks.Count(); i += 1)
        {
            var task = app.Tasks[i];
            if ((app.Filter == 1 && task.Done) || (app.Filter == 2 && !task.Done))
                continue;
            using (ui.Id(i))
            {
                using (ui.Row())
                {
                    if (ui.Checkbox("##done", ref task.Done))
                        app.Tasks[i] = task;
                    string due = task.Days == 0 ? "today" : $"in {task.Days} days";
                    if (ui.ListItem($"{task.Title} ({app.Priorities[task.Priority]}, {due})", app.Selected == i))
                        app.Selected = i;
                    if (ui.RightClicked())
                    {
                        app.MenuTask = i;
                        app.Selected = i;
                        ui.OpenPopup("task");
                    }
                }
            }
        }
    }

    // the context menu of a task (the right mouse button)
    using (ui.Popup("task"))
    {
        if (app.MenuTask >= 0 && app.MenuTask < app.Tasks.Count())
        {
            var task = app.Tasks[app.MenuTask];
            if (ui.MenuItem(task.Done ? "Mark as open" : "Mark as done"))
            {
                task.Done = !task.Done;
                app.Tasks[app.MenuTask] = task;
            }
            if (ui.MenuItem("Remove", "Del"))
            {
                app.Tasks.RemoveAt(app.MenuTask);
                app.Selected = -1;
            }
        }
    }

    using (ui.Row())
    {
        bool hasSelection = app.Selected >= 0 && app.Selected < app.Tasks.Count();
        if ((ui.Button("Remove selected") || ui.Input().Pressed(Key.Delete)) && hasSelection && !ui.HasFocus("new"))
        {
            app.Tasks.RemoveAt(app.Selected);
            app.Selected = -1;
        }
        if (ui.Button("Remove done"))
            app.Confirm = true;
        ui.Tooltip("Asks first");
    }

    // a modal dialog: the rest of the window gets no input while it is shown
    if (app.Confirm)
    {
        using (ui.Modal("confirm", "Remove the done tasks?"))
        {
            ui.Text($"{done} tasks are done. They are removed for good.");
            using (ui.Row())
            {
                if (ui.Button("Remove"))
                {
                    app.Tasks = app.Tasks.Where(t => !t.Done);
                    app.Selected = -1;
                    app.Confirm = false;
                }
                if (ui.Button("Cancel") || ui.Input().Pressed(Key.Escape))
                    app.Confirm = false;
            }
        }
    }

    // importing and exporting the tasks: a text file, one task per line ("[x] " before a done one); in the browser the
    // file comes from the browser's file chooser, and the export is a download
    if (app.FileMode != 0)
    {
        bool import = app.FileMode == 1;
        var result = ui.FileDialog("tasks", import ? "Import tasks" : "Export tasks", ref app.FilePath,
                                   import ? FileDialogMode.Open : FileDialogMode.Save);
        if (result == UiDialogResult.Ok)
            app.Message = import ? ImportTasks(ref app) : ExportTasks(ref app);
        if (result != UiDialogResult.None)
            app.FileMode = 0;
    }
    if (app.Message.Length > 0)
        ui.Note(app.Message);

    if (app.ConfirmQuit)
    {
        using (ui.Modal("quit", "Quit?"))
        {
            ui.Text("Some tasks are not done yet.");
            using (ui.Row())
            {
                if (ui.Button("Quit"))
                    app.Quit = true;
                if (ui.Button("Cancel") || ui.Input().Pressed(Key.Escape))
                    app.ConfirmQuit = false;
            }
        }
    }

    using (ui.Panel("Settings"))
    {
        bool dark = app.Dark;
        if (ui.Checkbox("Dark theme", ref dark))
            SetDark(ui, ref app, dark);
        using (ui.Row())
        {
            ui.Checkbox("Busy", ref app.Busy);
            if (app.Busy)
                Spinner(ui);
        }
        using (ui.Columns(2))
        {
            ui.Label($"Zoom {(int)(app.Zoom * 100.0 + 0.5)} %"); // an integer: formatting a double is slow without an FPU
            ui.Slider("zoom", ref app.Zoom, 0.75, 2.0);
        }
        ui.Text("Tab moves between the controls, Enter and Space press buttons, the arrow keys move sliders. " +
                "Ctrl+C, Ctrl+X and Ctrl+V work in text boxes. The right mouse button on a task opens its menu.");
    }
}

int Main(string[] args)
{
    // --frames N: draw N frames and close (for screenshots and tests)
    int frames = 0;
    if (args.Length == 2 && args[0] == "--frames" && args[1].ParseInt() is int n)
        frames = n;

    var window = try Window.Open("CShift - System.Ui", 460, 640);
    window.ConfirmClose(true); // closing the window asks first (AskQuit)
    var ui = Ui.Create();
    var app = App { Tasks = List<Task>.Create(), NewTitle = "", Selected = -1, Zoom = 1.0, Priorities = List<string>.Create(), MenuTask = -1,
                    Icon = MakeIcon(), FilePath = "tasks.txt", Message = "" };
    app.Priorities.Add("Low");
    app.Priorities.Add("Normal");
    app.Priorities.Add("High");
    app.NewPriority = 1;
    app.Tasks.Add(Task { Title = "Write the window layer", Done = true });
    app.Tasks.Add(Task { Title = "Draw text with a bitmap font", Done = true });
    app.Tasks.Add(Task { Title = "Lay out rows, columns and panels" });
    app.Tasks.Add(Task { Title = "Scroll long lists" });
    app.Tasks.Add(Task { Title = "Try it on Linux" });

    int count = 0;
    while (!app.Quit && window.Update())
    {
        ui.Begin(window, app.Zoom);
        Draw(ui, ref app);
        if (frames > 0)
            window.Show(ui.End()); // as an image: the next Update does not wait for input
        else
            window.Show(ui);
        count += 1;
        if (frames > 0 && count >= frames)
            break;
    }
    window.Dispose();
    return 0;
}
